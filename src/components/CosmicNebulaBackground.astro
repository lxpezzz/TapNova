---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`cosmic-nebula-container ${className}`} id="cosmic-nebula-bg" aria-hidden="true">
  <!-- Deep Space Substrate -->
  <div class="space-substrate"></div>

  <!-- Living Volumetric Nebula Clouds Layer -->
  <div class="nebula-clouds-chamber" id="nebula-chamber">
    <!-- Cloud 1: Radiant Golden/Amber Star Nursery -->
    <div class="nebula-gas gas-amber-gold" id="gas-amber"></div>

    <!-- Cloud 2: Cosmic Orchid & Violet Ionized Mist -->
    <div class="nebula-gas gas-orchid-purple" id="gas-purple"></div>

    <!-- Cloud 3: High-Energy Solar Flame Orange Cloud -->
    <div class="nebula-gas gas-flame-orange" id="gas-orange"></div>

    <!-- Cloud 4: Deep Celestial Magenta & Amethyst Core -->
    <div class="nebula-gas gas-magenta-violet" id="gas-magenta"></div>

    <!-- Cloud 5: Luminous Stellar Core Glow (Breathing Heart) -->
    <div class="nebula-gas gas-stellar-core" id="gas-core"></div>

    <!-- Cloud 6: Counter-Swirling Ethereal Nebula Filament -->
    <div class="nebula-gas gas-cosmic-filament" id="gas-filament"></div>

    <!-- Cloud 7: Dark Matter Dust Lane (Creates astronomical 3D depth) -->
    <div class="nebula-gas gas-dark-lane"></div>
  </div>

  <!-- Interactive Stardust & Cosmic Particles Canvas -->
  <canvas class="nebula-stardust-canvas" id="nebula-stardust-canvas"></canvas>

  <!-- Fine Cosmic Dust Grain Overlay (Prevents color-banding & gives cinematic depth) -->
  <div class="nebula-grain-overlay"></div>

  <!-- Deep Astronomical Vignette (Guarantees foreground contrast and text readability) -->
  <div class="nebula-vignette"></div>
</div>

<style>
  .cosmic-nebula-container {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    background-color: var(--bg-black, #050505);
    user-select: none;
    -webkit-user-select: none;
  }

  /* Deep Space Substrate: Subtle radial space curvature */
  .space-substrate {
    position: absolute;
    inset: -5%;
    width: 110%;
    height: 110%;
    background: radial-gradient(
      ellipse at 50% 40%,
      #09080e 0%,
      #06050a 45%,
      #050505 85%,
      #030304 100%
    );
  }

  /* Chamber holding the volumetric nebula clouds */
  .nebula-clouds-chamber {
    position: absolute;
    inset: -15%;
    width: 130%;
    height: 130%;
    will-change: transform;
    pointer-events: none;
    transform: translate3d(0, 0, 0);
  }

  /* Base shared styles for gas clouds */
  .nebula-gas {
    position: absolute;
    pointer-events: none;
    will-change: transform, border-radius, opacity;
    mix-blend-mode: screen;
    transform-origin: center center;
  }

  /* 1. Amber / Golden Star Nursery (Top-Right / Center Drift) */
  .gas-amber-gold {
    top: -5%;
    right: 5%;
    width: clamp(520px, 62vw, 980px);
    height: clamp(520px, 62vw, 980px);
    border-radius: 56% 44% 65% 35% / 42% 58% 42% 58%;
    background: radial-gradient(
      ellipse at 46% 48%,
      rgba(254, 237, 122, 0.28) 0%,
      rgba(255, 157, 36, 0.22) 32%,
      rgba(255, 132, 0, 0.12) 58%,
      rgba(255, 132, 0, 0.04) 74%,
      transparent 84%
    );
    filter: blur(64px);
    animation: driftAmberGold 31s ease-in-out infinite alternate;
  }

  /* 2. Orchid & Purple Ionized Gas (Mid-Left & Center Drift) */
  .gas-orchid-purple {
    top: 22%;
    left: -8%;
    width: clamp(580px, 68vw, 1050px);
    height: clamp(540px, 64vw, 1000px);
    border-radius: 44% 56% 48% 52% / 54% 46% 54% 46%;
    background: radial-gradient(
      ellipse at 52% 48%,
      rgba(223, 145, 247, 0.26) 0%,
      rgba(224, 86, 253, 0.18) 34%,
      rgba(147, 51, 234, 0.12) 56%,
      rgba(88, 28, 135, 0.05) 75%,
      transparent 88%
    );
    filter: blur(72px);
    animation: driftOrchidPurple 37s ease-in-out infinite alternate;
  }

  /* 3. Solar Flame Orange Cloud (Bottom-Right & Center Drift) */
  .gas-flame-orange {
    bottom: -10%;
    right: 12%;
    width: clamp(500px, 58vw, 920px);
    height: clamp(480px, 56vw, 880px);
    border-radius: 62% 38% 52% 48% / 46% 60% 40% 54%;
    background: radial-gradient(
      ellipse at 48% 52%,
      rgba(255, 132, 0, 0.22) 0%,
      rgba(255, 157, 36, 0.16) 36%,
      rgba(254, 237, 122, 0.08) 60%,
      transparent 78%
    );
    filter: blur(68px);
    animation: driftFlameOrange 43s ease-in-out infinite alternate;
  }

  /* 4. Deep Celestial Magenta & Amethyst Core (Center-Bottom) */
  .gas-magenta-violet {
    top: 48%;
    right: 28%;
    width: clamp(460px, 52vw, 840px);
    height: clamp(460px, 52vw, 840px);
    border-radius: 48% 52% 60% 40% / 58% 42% 58% 42%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(224, 86, 253, 0.20) 0%,
      rgba(223, 145, 247, 0.14) 38%,
      rgba(124, 58, 237, 0.08) 62%,
      transparent 80%
    );
    filter: blur(60px);
    animation: driftMagentaViolet 47s ease-in-out infinite alternate;
  }

  /* 5. Stellar Core Glow: Breathing warm heartbeat at the nucleus */
  .gas-stellar-core {
    top: 32%;
    left: 36%;
    width: clamp(380px, 42vw, 680px);
    height: clamp(380px, 42vw, 680px);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(254, 237, 122, 0.25) 0%,
      rgba(255, 157, 36, 0.15) 35%,
      rgba(223, 145, 247, 0.08) 65%,
      transparent 82%
    );
    filter: blur(48px);
    mix-blend-mode: plus-lighter;
    animation: pulseStellarCore 23s ease-in-out infinite alternate;
  }

  /* 6. Counter-Swirling Ethereal Filament (Creates fluid shear & turbulence) */
  .gas-cosmic-filament {
    top: 15%;
    left: 20%;
    width: clamp(620px, 72vw, 1100px);
    height: clamp(420px, 48vw, 750px);
    border-radius: 70% 30% 64% 36% / 36% 68% 32% 64%;
    background: linear-gradient(
      135deg,
      rgba(255, 157, 36, 0.12) 0%,
      rgba(223, 145, 247, 0.14) 45%,
      rgba(224, 86, 253, 0.08) 75%,
      transparent 100%
    );
    filter: blur(62px);
    animation: driftFilament 53s ease-in-out infinite alternate;
  }

  /* 7. Dark Matter Dust Lane (Inverted contrast absorption cloud for volumetric depth) */
  .gas-dark-lane {
    top: 28%;
    left: 22%;
    width: clamp(420px, 50vw, 780px);
    height: clamp(340px, 42vw, 640px);
    border-radius: 46% 54% 38% 62% / 52% 44% 56% 48%;
    background: radial-gradient(
      ellipse at 50% 50%,
      rgba(5, 5, 5, 0.72) 0%,
      rgba(6, 5, 9, 0.45) 45%,
      transparent 75%
    );
    filter: blur(52px);
    mix-blend-mode: normal;
    opacity: 0.85;
    animation: driftDarkLane 39s ease-in-out infinite alternate;
  }

  /* Cosmic Stardust & Micro-Particles Canvas */
  .nebula-stardust-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  /* Subtle Organic Film Grain (prevents gradient banding on OLED/HDR displays) */
  .nebula-grain-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.028;
    z-index: 3;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    mix-blend-mode: overlay;
  }

  /* Deep Space Vignette (Darkens edges & keeps central reading plane ultra legible) */
  .nebula-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 4;
    background: radial-gradient(
      ellipse at 50% 50%,
      transparent 42%,
      rgba(5, 5, 5, 0.35) 70%,
      rgba(5, 5, 5, 0.78) 90%,
      rgba(5, 5, 5, 0.94) 100%
    );
  }

  /* KEYFRAME ANIMATIONS: Asynchronous Prime-period Fluid Motions */

  @keyframes driftAmberGold {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      border-radius: 56% 44% 65% 35% / 42% 58% 42% 58%;
      opacity: 0.85;
    }
    50% {
      transform: translate3d(-3.5%, 4%, 0) rotate(3deg) scale(1.06);
      border-radius: 42% 58% 46% 54% / 58% 42% 58% 42%;
      opacity: 1;
    }
    100% {
      transform: translate3d(3%, -2.5%, 0) rotate(-2.5deg) scale(0.96);
      border-radius: 64% 36% 58% 42% / 46% 54% 46% 54%;
      opacity: 0.8;
    }
  }

  @keyframes driftOrchidPurple {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      border-radius: 44% 56% 48% 52% / 54% 46% 54% 46%;
      opacity: 0.85;
    }
    50% {
      transform: translate3d(4.5%, -3%, 0) rotate(-4deg) scale(1.08);
      border-radius: 58% 42% 62% 38% / 42% 58% 42% 58%;
      opacity: 0.95;
    }
    100% {
      transform: translate3d(-2%, 3.5%, 0) rotate(2deg) scale(0.94);
      border-radius: 48% 52% 44% 56% / 56% 44% 56% 44%;
      opacity: 0.8;
    }
  }

  @keyframes driftFlameOrange {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      border-radius: 62% 38% 52% 48% / 46% 60% 40% 54%;
      opacity: 0.8;
    }
    50% {
      transform: translate3d(-4%, -3.5%, 0) rotate(3.5deg) scale(1.07);
      border-radius: 48% 52% 64% 36% / 58% 42% 58% 42%;
      opacity: 0.95;
    }
    100% {
      transform: translate3d(2.5%, 3%, 0) rotate(-2deg) scale(0.95);
      border-radius: 54% 46% 46% 54% / 44% 56% 44% 56%;
      opacity: 0.75;
    }
  }

  @keyframes driftMagentaViolet {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      border-radius: 48% 52% 60% 40% / 58% 42% 58% 42%;
      opacity: 0.75;
    }
    50% {
      transform: translate3d(-3%, 4.5%, 0) rotate(-3deg) scale(1.05);
      border-radius: 60% 40% 48% 52% / 44% 56% 44% 56%;
      opacity: 0.9;
    }
    100% {
      transform: translate3d(3.5%, -2%, 0) rotate(3deg) scale(0.97);
      border-radius: 44% 56% 56% 44% / 54% 46% 54% 46%;
      opacity: 0.7;
    }
  }

  @keyframes pulseStellarCore {
    0% {
      transform: translate3d(0, 0, 0) scale(0.94);
      opacity: 0.7;
    }
    50% {
      transform: translate3d(1.5%, -1.5%, 0) scale(1.08);
      opacity: 0.95;
    }
    100% {
      transform: translate3d(-1%, 2%, 0) scale(0.96);
      opacity: 0.65;
    }
  }

  @keyframes driftFilament {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
      border-radius: 70% 30% 64% 36% / 36% 68% 32% 64%;
      opacity: 0.65;
    }
    50% {
      transform: translate3d(-2.5%, 2%, 0) rotate(2deg) scale(1.04);
      border-radius: 42% 58% 36% 64% / 64% 36% 64% 36%;
      opacity: 0.85;
    }
    100% {
      transform: translate3d(3%, -3%, 0) rotate(-2.5deg) scale(0.98);
      border-radius: 64% 36% 58% 42% / 44% 56% 44% 56%;
      opacity: 0.6;
    }
  }

  @keyframes driftDarkLane {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.75;
    }
    50% {
      transform: translate3d(2%, -3%, 0) scale(1.05);
      opacity: 0.88;
    }
    100% {
      transform: translate3d(-2.5%, 2%, 0) scale(0.96);
      opacity: 0.7;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .gas-amber-gold,
    .gas-orchid-purple,
    .gas-flame-orange,
    .gas-magenta-violet,
    .gas-stellar-core,
    .gas-cosmic-filament,
    .gas-dark-lane {
      animation: none !important;
    }
    .nebula-stardust-canvas {
      display: none;
    }
  }
</style>

<script>
  // High-performance, lightweight Cosmic Stardust & Particle Drift Engine
  // Operates entirely off-main-thread when possible, with micro-draw footprint (< 0.2ms per frame)
  (() => {
    const canvas = document.getElementById('nebula-stardust-canvas') as HTMLCanvasElement | null;
    const chamber = document.getElementById('nebula-chamber');
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotionQuery.matches) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let isVisible = true;

    // Subtle parallax tracking
    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    // Palette for celestial micro-stars: Yellow/Gold, Amber, Orchid/Purple, Pure Starlight
    const STAR_COLORS = [
      'rgba(254, 237, 122, ',  // Starlight yellow
      'rgba(255, 157, 36, ',   // Amber
      'rgba(223, 145, 247, ',  // Orchid purple
      'rgba(224, 86, 253, ',   // Magenta
      'rgba(255, 255, 255, ',  // Pure white core
    ];

    interface CosmicStar {
      x: number;
      y: number;
      baseRadius: number;
      colorIndex: number;
      baseAlpha: number;
      speedX: number;
      speedY: number;
      twinklePhase: number;
      twinkleSpeed: number;
      depth: number; // 0.1 to 1 for parallax
    }

    const STAR_COUNT = 75;
    const stars: CosmicStar[] = [];

    function initStars() {
      stars.length = 0;
      for (let i = 0; i < STAR_COUNT; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          baseRadius: Math.random() < 0.85 ? Math.random() * 0.9 + 0.5 : Math.random() * 1.6 + 1.2,
          colorIndex: Math.floor(Math.random() * STAR_COLORS.length),
          baseAlpha: Math.random() * 0.45 + 0.25,
          speedX: (Math.random() - 0.5) * 0.08,
          speedY: -Math.random() * 0.12 - 0.03, // slow celestial upward/drift motion
          twinklePhase: Math.random() * Math.PI * 2,
          twinkleSpeed: Math.random() * 0.02 + 0.008,
          depth: Math.random() * 0.7 + 0.3,
        });
      }
    }

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx!.scale(dpr, dpr);

      if (stars.length === 0) {
        initStars();
      } else {
        // Keep particles distributed proportionally
        for (const star of stars) {
          if (star.x > width) star.x = Math.random() * width;
          if (star.y > height) star.y = Math.random() * height;
        }
      }
    }

    // Gentle parallax input
    function onPointerMove(e: MouseEvent | TouchEvent) {
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      targetX = (clientX / width - 0.5) * 2; // -1 to 1
      targetY = (clientY / height - 0.5) * 2; // -1 to 1
    }

    // Animation Loop
    function render() {
      if (!isVisible) return;

      // Smooth parallax lerp
      currentX += (targetX - currentX) * 0.035;
      currentY += (targetY - currentY) * 0.035;

      // Apply subtle parallax to the background chamber (translates max 12px)
      if (chamber) {
        chamber.style.transform = `translate3d(${-currentX * 14}px, ${-currentY * 14}px, 0)`;
      }

      ctx!.clearRect(0, 0, width, height);

      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];

        // Cosmic drift
        star.x += star.speedX + currentX * star.depth * 0.15;
        star.y += star.speedY + currentY * star.depth * 0.15;

        // Screen wrap
        if (star.x < 0) star.x = width;
        if (star.x > width) star.x = 0;
        if (star.y < 0) star.y = height;
        if (star.y > height) star.y = 0;

        // Twinkle modulation
        star.twinklePhase += star.twinkleSpeed;
        const twinkle = Math.sin(star.twinklePhase);
        const alpha = Math.max(0.05, Math.min(1, star.baseAlpha + twinkle * 0.22));

        // Parallax position offset
        const drawX = star.x + currentX * star.depth * 8;
        const drawY = star.y + currentY * star.depth * 8;

        ctx!.fillStyle = `${STAR_COLORS[star.colorIndex]}${alpha.toFixed(3)})`;
        ctx!.beginPath();
        ctx!.arc(drawX, drawY, star.baseRadius, 0, Math.PI * 2);
        ctx!.fill();

        // Subtle soft halo on larger focal stars
        if (star.baseRadius > 1.4) {
          ctx!.fillStyle = `${STAR_COLORS[star.colorIndex]}${(alpha * 0.25).toFixed(3)})`;
          ctx!.beginPath();
          ctx!.arc(drawX, drawY, star.baseRadius * 3, 0, Math.PI * 2);
          ctx!.fill();
        }
      }

      animId = requestAnimationFrame(render);
    }

    // Setup lifecycle
    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    // Pause animation when tab is inactive to preserve battery & CPU
    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
