---
import { posavasosFamily } from '../../data/product-families';
import { catalogFamilies } from '../../data/catalog-families';
interface Props { final?: boolean }
const { final = false } = Astro.props;
const catalog = [posavasosFamily, ...catalogFamilies].map((family) => ({
  id: family.product.id,
  name: family.product.name,
  slug: family.product.slug,
  models: family.models.map(({ id, name }) => ({ id, name })),
}));
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;
const canSend = Boolean(accessKey && accessKey !== 'YOUR_ACCESS_KEY_HERE');
---

<section class="order-request" data-final={String(final)}>
  <div class="order-request__inner">
    <header class="order-request__heading">
      <p class="order-request__eyebrow">{final ? 'CONTINUAR SOLICITUD' : 'PRODUCTOS PARA TU LOCAL'}</p>
      <h1>Tu solicitud</h1>
      <p>{final ? 'Revisa tu selección y cuéntanos cómo podemos contactar contigo.' : 'Los puntos de contacto que quieres llevar a tu negocio. Revisa tu selección antes de continuar.'}</p>
    </header>
    <p class="order-request__error" role="alert" hidden></p>
    <div class="order-request__empty" hidden>
      <h2>Todo empieza con un producto.</h2>
      <p>Aún no has añadido productos a tu solicitud.</p>
      <a class="order-request__button" href="/productos">Descubrir productos →</a>
    </div>
    <div class="order-request__content" hidden>
      <div>
        <div class="order-request__list" aria-label="Productos de tu solicitud"></div>
        {!final && <div class="order-request__tools">
          <a href="/productos">Seguir viendo productos →</a>
          <button type="button" data-clear>Vaciar solicitud</button>
          <div data-clear-confirm hidden>
            <p>¿Quieres eliminar todos los productos de tu solicitud?</p>
            <button type="button" data-confirm-clear>Sí, vaciar</button>
            <button type="button" data-cancel-clear>Conservar productos</button>
          </div>
        </div>}
        {final && <a class="order-request__back" href="/tu-solicitud">← Editar mi solicitud</a>}
      </div>
      <aside class="order-request__summary">
        <h2>{final ? 'El siguiente contacto.' : 'Tu selección, en conjunto.'}</h2>
        <dl>
          <div><dt>Subtotal estimado</dt><dd data-total="net"></dd></div>
          <div><dt>IVA</dt><dd data-total="vat"></dd></div>
          <div class="order-request__total"><dt>Total estimado</dt><dd data-total="total"></dd></div>
        </dl>
        <p class="order-request__quote" hidden>Hay productos con importe por confirmar. Los totales incluyen únicamente los productos con precio definido; el resto se presupuestará aparte.</p>
        {!final && <a class="order-request__button" href="/tu-solicitud/enviar">Continuar solicitud →</a>}
        {final && <form class="order-request__form" data-can-send={String(canSend)}>
          <input type="hidden" name="access_key" value={canSend ? accessKey : ''} />
          <input type="hidden" name="subject" value="Nueva solicitud de productos · TapNova" />
          <input type="hidden" name="from_name" value="TapNova · Solicitudes" />
          <input type="checkbox" name="botcheck" class="order-request__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label for="request-name">Nombre</label>
          <input id="request-name" name="name" required autocomplete="name" maxlength="150" />
          <label for="request-company">Restaurante / empresa</label>
          <input id="request-company" name="company" required autocomplete="organization" maxlength="200" />
          <label for="request-email">Email</label>
          <input id="request-email" name="email" type="email" required autocomplete="email" maxlength="254" />
          <label for="request-phone">Teléfono</label>
          <input id="request-phone" name="phone" type="tel" required autocomplete="tel" maxlength="40" />
          <label for="request-message">Mensaje / observaciones <span>(opcional)</span></label>
          <textarea id="request-message" name="message" rows="4" maxlength="3000"></textarea>
          {!canSend && <p>El envío de solicitudes todavía no está disponible. Tu selección permanece guardada; puedes contactar con <a href="mailto:info@tapnova.es">info@tapnova.es</a>.</p>}
          <button class="order-request__button" type="submit" disabled>Enviar mi solicitud →</button>
        </form>}
        <p class="order-request__notice">No se realizará ningún cobro. Revisaremos tu solicitud y contactaremos contigo para confirmar personalización, disponibilidad y pedido.</p>
      </aside>
    </div>
    <p class="order-request__status" role="status" aria-live="polite"></p>
    <noscript>Activa JavaScript para revisar los productos guardados en este navegador.</noscript>
    <script type="application/json" class="order-request__catalog" set:html={JSON.stringify(catalog).replace(/</g, '\u003c')} />
  </div>
</section>

<style>
  .order-request :global(.order-request__item-actions button) {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .order-request :global(.order-request__item-actions a:focus-visible),
  .order-request :global(.order-request__item-actions button:focus-visible) {
    outline: 2px solid #6b5e52;
    outline-offset: 4px;
  }

  .order-request {
    background: #faf8f5;
    color: #2e2019;
    padding: 64px 20px 80px;
    min-height: 70svh;
  }

  .order-request__inner {
    max-width: 1360px;
    margin-inline: auto;
  }

  .order-request__heading {
    max-width: 720px;
    margin-bottom: 48px;
  }

  .order-request__eyebrow {
    color: #6b5e52;
    font-size: 10.5px;
    letter-spacing: .24em;
    margin-bottom: 20px;
  }

  .order-request h1 {
    font-size: clamp(44px, 5vw, 76px);
    font-weight: 300;
    letter-spacing: -.035em;
    line-height: 1.08;
  }

  .order-request__heading > p:last-child {
    color: #6b5e52;
    font-size: 17px;
    line-height: 1.65;
    margin-top: 20px;
  }

  .order-request__content {
    display: grid;
    gap: 48px;
  }

  .order-request [hidden] {
    display: none;
  }

  .order-request__list {
    border-top: 1px solid #2e201926;
  }

  .order-request :global(.order-request__item) {
    padding-block: 28px;
    border-bottom: 1px solid #2e201926;
    overflow-wrap: anywhere;
  }

  .order-request :global(.order-request__item h2) {
    font-size: 24px;
    font-weight: 400;
    letter-spacing: -.025em;
  }

  .order-request :global(.order-request__item p) {
    color: #6b5e52;
    line-height: 1.65;
    font-size: 14px;
    margin-top: 8px;
    white-space: pre-line;
  }

  .order-request :global(.order-request__item-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 20px;
    font-size: 13px;
  }

  .order-request__tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    font-size: 13px;
  }

  .order-request__tools [data-clear-confirm] {
    flex-basis: 100%;
    padding-block: 16px;
    border-top: 1px solid #2e201926;
  }

  .order-request__tools [data-clear-confirm] button {
    margin: 16px 20px 0 0;
  }

  .order-request__summary h2, .order-request__empty h2 {
    font-size: 28px;
    font-weight: 300;
    letter-spacing: -.025em;
  }

  .order-request__summary dl {
    margin-block: 24px;
  }

  .order-request__summary dl > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    font-size: 14px;
  }

  .order-request__summary dd {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .order-request__total {
    border-top: 1px solid #2e201926;
    font-weight: 500;
  }

  .order-request__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    border-radius: 999px;
    background: #2e2019;
    color: #faf8f5;
    font-size: 13px;
    cursor: pointer;
    transition: background 180ms;
  }

  .order-request__button:hover {
    background: #211915;
  }

  .order-request__button:disabled {
    opacity: .55;
    cursor: default;
  }

  .order-request__notice, .order-request__quote {
    font-size: 13px;
    line-height: 1.7;
    color: #6b5e52;
    margin-top: 24px;
  }

  .order-request__quote {
    margin-block: 20px;
  }

  .order-request__empty p {
    margin: 16px 0 24px;
    color: #6b5e52;
  }

  .order-request__back {
    display: inline-block;
    margin-top: 24px;
    font-size: 14px;
  }

  .order-request__form {
    display: grid;
    gap: 12px;
    margin-top: 32px;
  }

  .order-request__form label {
    font-size: 14px;
    margin-top: 8px;
  }

  .order-request__form label span {
    color: #6b5e52;
  }

  .order-request__form input:not([type="hidden"]), .order-request__form textarea {
    width: 100%;
    padding: 12px 0;
    background: transparent;
    border-bottom: 1px solid #2e20194d;
    border-radius: 0;
    font: inherit;
  }

  .order-request__form .order-request__honeypot {
    display: none;
  }

  .order-request__form > p {
    font-size: 14px;
    line-height: 1.6;
  }

  .order-request__form button {
    margin-top: 16px;
  }

  .order-request__error, .order-request__status {
    font-size: 15px;
    line-height: 1.7;
    margin-block: 24px;
  }

  .order-request__status:empty {
    margin: 0;
  }

  .order-request a:focus-visible, .order-request button:focus-visible, .order-request input:focus-visible, .order-request textarea:focus-visible {
    outline: 2px solid #6b5e52;
    outline-offset: 4px;
  }

  .order-request button:not(.order-request__button) {
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (min-width: 640px) {
    .order-request {
      padding-inline: 32px;
    }
  }

  @media (min-width: 768px) {
    .order-request {
      padding-inline: 48px;
    }
  }

  @media (min-width: 1024px) {
    .order-request {
      padding: 80px 64px 96px;
    }
    .order-request__content {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, .8fr);
      gap: 64px;
    }
  }
</style>

<script>
  import { readRequest, writeRequest, type RequestItem } from '../../lib/order-request';
  import { qrDestinations } from '../../data/order-options';
  interface CatalogEntry { id: string; name: string; slug: string; models: { id: string; name: string }[] }
  const root = document.querySelector<HTMLElement>('.order-request');
  if (root) {
    const catalog: CatalogEntry[] = JSON.parse(root.querySelector('.order-request__catalog')!.textContent!);
    const list = root.querySelector<HTMLElement>('.order-request__list')!;
    const content = root.querySelector<HTMLElement>('.order-request__content')!;
    const empty = root.querySelector<HTMLElement>('.order-request__empty')!;
    const error = root.querySelector<HTMLElement>('.order-request__error')!;
    const status = root.querySelector<HTMLElement>('.order-request__status')!;
    const form = root.querySelector<HTMLFormElement>('form');
    let sending = false;
    let submitted = false;
    const money = (cents: number) => new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' }).format(cents / 100);

    function itemText(item: RequestItem): string {
      const product = catalog.find((entry) => entry.id === item.productId);
      const model = product?.models.find((entry) => entry.id === item.modelId)?.name;
      const qr = qrDestinations.find((entry) => entry.id === item.qrDestination)?.name;
      const lines = [product?.name ?? 'Producto no disponible', model ? `Modelo: ${model}` : '', `Cantidad: ${item.quantity ?? 'Por concretar'}`, `Destino QR/NFC: ${qr}`];
      if (item.options?.['unidades-de-regalo']) lines.push(`Unidades de regalo: ${item.options['unidades-de-regalo']}`);
      if (item.options?.['descuento-porcentaje']) lines.push(`Descuento: ${item.options['descuento-porcentaje']} %`);
      if (item.observations) lines.push(`Observaciones: ${item.observations}`);
      if (item.estimate.kind === 'estimated') lines.push(`Subtotal: ${money(item.estimate.netCents)} · IVA (${item.estimate.vatRate} %): ${money(item.estimate.vatCents)} · Total: ${money(item.estimate.totalCents)}`);
      else lines.push('Precio: Consultar');
      return lines.filter(Boolean).join('\n');
    }

    function totals(items: RequestItem[]) {
      return items.reduce((sum, item) => {
        if (item.estimate.kind === 'estimated') {
          sum.net += item.estimate.netCents;
          sum.vat += item.estimate.vatCents;
          sum.total += item.estimate.totalCents;
          sum.known++;
        } else sum.quote = true;
        return sum;
      }, { net: 0, vat: 0, total: 0, known: 0, quote: false });
    }

    function showError(message: string) { error.textContent = message; error.hidden = false; }

    function render() {
      if (submitted) return;
      try {
        const items = readRequest();
        empty.hidden = items.length > 0;
        content.hidden = items.length === 0;
        list.replaceChildren();
        items.forEach((item) => {
          const product = catalog.find((entry) => entry.id === item.productId);
          const article = document.createElement('article');
          article.className = 'order-request__item';
          const heading = document.createElement('h2');
          heading.textContent = product?.name ?? 'Producto no disponible';
          const description = document.createElement('p');
          description.textContent = itemText(item).split('\n').slice(1).join('\n');
          article.append(heading, description);
          if (root!.dataset.final !== 'true') {
            const actions = document.createElement('div');
            actions.className = 'order-request__item-actions';
            if (product) {
              const edit = document.createElement('a');
              edit.href = `/productos/${product.slug}?editar=${encodeURIComponent(item.id)}#configurar-${product.slug}`;
              edit.textContent = 'Editar configuración →';
              edit.setAttribute('aria-label', `Editar ${product.name}`);
              actions.append(edit);
            }
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = 'Eliminar';
            remove.setAttribute('aria-label', `Eliminar ${product?.name ?? 'producto'}`);
            remove.addEventListener('click', () => {
              try {
                writeRequest(readRequest().filter((entry) => entry.id !== item.id));
                status.textContent = 'Producto eliminado de tu solicitud';
                (root!.querySelector<HTMLElement>('.order-request__item-actions a') ?? root!.querySelector<HTMLElement>('.order-request__empty a'))?.focus();
              } catch { showError('No se ha podido eliminar el producto. Inténtalo de nuevo.'); }
            });
            actions.append(remove);
            article.append(actions);
          }
          list.append(article);
        });
        const sum = totals(items);
        for (const field of ['net', 'vat', 'total'] as const) {
          root!.querySelector(`[data-total="${field}"]`)!.textContent = sum.known ? money(sum[field]) : 'Consultar';
        }
        root!.querySelector<HTMLElement>('.order-request__quote')!.hidden = !sum.quote;
        const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
        if (submit) submit.disabled = sending || items.length === 0 || form?.dataset.canSend !== 'true' || items.some((item) => !catalog.some((entry) => entry.id === item.productId));
      } catch { content.hidden = true; empty.hidden = true; showError('No se ha podido leer tu solicitud guardada. Los datos no se han eliminado. Revisa el almacenamiento de este navegador.'); }
    }

    const clearConfirm = root.querySelector<HTMLElement>('[data-clear-confirm]');
    root.querySelector('[data-clear]')?.addEventListener('click', () => { clearConfirm!.hidden = false; root.querySelector<HTMLElement>('[data-confirm-clear]')?.focus(); });
    root.querySelector('[data-cancel-clear]')?.addEventListener('click', () => { clearConfirm!.hidden = true; root.querySelector<HTMLElement>('[data-clear]')?.focus(); });
    root.querySelector('[data-confirm-clear]')?.addEventListener('click', () => {
      try { writeRequest([]); clearConfirm!.hidden = true; status.textContent = 'Solicitud vaciada'; root.querySelector<HTMLElement>('.order-request__empty a')?.focus(); }
      catch { showError('No se ha podido vaciar tu solicitud. Inténtalo de nuevo.'); }
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending || submitted || form.dataset.canSend !== 'true' || !form.reportValidity()) return;
      try {
        const items = readRequest();
        if (!items.length || items.some((item) => !catalog.some((entry) => entry.id === item.productId))) { render(); return; }
        error.hidden = true;
        sending = true;
        render();
        status.textContent = 'Enviando tu solicitud…';
        const data = new FormData(form);
        const sum = totals(items);
        data.set('solicitud', items.map(itemText).join('\n\n') + `\n\nSubtotal estimado: ${money(sum.net)}\nIVA: ${money(sum.vat)}\nTotal estimado: ${money(sum.total)}${sum.quote ? '\nHay productos pendientes de presupuesto; no están incluidos en estos importes.' : ''}`);
        const response = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        const result = await response.json();
        if (!response.ok || result.success !== true) throw new Error('Envío no confirmado.');
        submitted = true;
        content.hidden = true;
        status.textContent = 'Solicitud enviada. Contactaremos contigo para revisar la personalización, disponibilidad y pedido. No se ha realizado ningún cobro.';
        // Conserva la selección: un envío confirmado no borra productos ni otras pestañas.
      } catch { status.textContent = ''; showError('No se ha podido confirmar el envío. Tu solicitud y los datos del formulario se conservan. Inténtalo de nuevo o contacta con info@tapnova.es.'); }
      finally { sending = false; if (!submitted) render(); }
    });
    render();
    window.addEventListener('tapnova:request-change', render);
    window.addEventListener('storage', render);
    window.addEventListener('pageshow', render);
  }
</script>
