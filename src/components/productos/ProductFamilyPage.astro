---
import { Image } from 'astro:assets';
import { formatProductPrice } from '../../data/products';
import type { ProductFamily } from '../../data/product-families';

interface Props {
  family: ProductFamily;
}

const { family } = Astro.props;
const { product } = family;
---

<section class="family-hero" aria-labelledby="family-heading">
  <div class="family-page__inner">
    <a class="family-hero__back" href="/productos"><span aria-hidden="true">←</span> Todos los productos</a>
    <div class="family-hero__heading">
      <div>
        <p class="family-page__eyebrow">PRODUCTOS PARA HOSTELERÍA</p>
        <h1 id="family-heading">{product.name}</h1>
      </div>
      <div class="family-hero__copy">
        <p>{family.introduction}</p>
        <p class="family-hero__price">{formatProductPrice(family.price)}</p>
      </div>
    </div>
    {product.image ? (
      <div class="family-hero__visual">
        <Image
          src={product.image.src}
          alt={product.image.alt}
          widths={[400, 640, 960, 1376]}
          sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc(100vw - 96px), (max-width: 1487px) calc(100vw - 128px), 1360px"
          loading="eager"
          fetchpriority="high"
          quality={70}
          class="family-page__image"
        />
      </div>
    ) : (
      <div class="family-hero__visual family-hero__visual--pending"><p>Fotografía de producto pendiente</p></div>
    )}
  </div>
</section>

{!family.singleOption && <section class="family-models family-page__section" aria-labelledby="family-models-heading">
  <div class="family-page__inner">
    <header class="family-page__section-heading">
      <div>
        <p class="family-page__eyebrow">MODELOS DISPONIBLES</p>
        <h2 id="family-models-heading">Modelos disponibles.</h2>
      </div>
      <p class="family-page__intro">{family.modelsIntroduction}</p>
    </header>
    <div class="family-models__list">
      {family.models.map((model) => (
        <article class="family-model" aria-labelledby={`model-${model.id}-heading`}>
          <div class:list={['family-model__visual', { 'family-model__visual--pending': !model.image }]}>
            {model.image ? (
              <Image
                src={model.image.src}
                alt={model.image.alt}
                widths={[400, 640, 960, 1200]}
                sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc((100vw - 128px) / 2), (max-width: 1487px) calc((100vw - 168px) / 2), 660px"
                loading="lazy"
                quality={70}
                class="family-page__image"
              />
            ) : (
              <p>Imagen del modelo pendiente</p>
            )}
          </div>
          <div class="family-model__heading">
            <h3 id={`model-${model.id}-heading`}>{model.name}</h3>
            <p class="family-model__price">{formatProductPrice(model.price)}</p>
          </div>
          <p class="family-model__text">{model.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>}

<section class="family-uses family-page__section" aria-labelledby="family-uses-heading">
  <div class="family-page__inner">
    <p class="family-page__eyebrow">DEL LOCAL AL MÓVIL</p>
    <h2 id="family-uses-heading">Qué puedes hacer con ellos.</h2>
    <ul class="family-uses__list" role="list">
      {family.uses.map((use) => <li>{use}</li>)}
    </ul>
    <p class="family-uses__note">El destino del enlace se elige según lo que quieras facilitar y las herramientas que utilice tu negocio.</p>
  </div>
</section>

<section class="family-customization family-page__section" aria-labelledby="family-customization-heading">
  <div class="family-page__inner">
    <header class="family-page__section-heading">
      <div>
        <p class="family-page__eyebrow">CON LA IDENTIDAD DE TU LOCAL</p>
        <h2 id="family-customization-heading">Personalización.</h2>
      </div>
    </header>
    <div class="family-customization__list">
      {family.customization.map(({ title, text }) => (
        <div class="family-customization__item">
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="family-gallery family-page__section" aria-labelledby="family-gallery-heading">
  <div class="family-page__inner">
    <header class="family-page__section-heading">
      <div>
        <p class="family-page__eyebrow">DETALLE Y CONTEXTO</p>
        <h2 id="family-gallery-heading">{family.galleryTitle ?? 'En tu mesa, con tu marca.'}</h2>
      </div>
      <p class="family-page__intro">{family.galleryIntroduction}</p>
    </header>
    <div class="family-gallery__list">
      {family.gallery.map(({ src, alt, caption }) => (
        <figure>
          <div class="family-gallery__visual">
            <Image
              src={src}
              alt={alt}
              widths={[400, 640, 960, 1200]}
              sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc((100vw - 128px) / 2), (max-width: 1487px) calc((100vw - 168px) / 2), 660px"
              loading="lazy"
              quality={70}
              class="family-page__image"
            />
          </div>
          <figcaption>{caption}</figcaption>
        </figure>
      ))}
      {family.gallery.length === 0 && (product.image ? (
        <figure>
          <div class="family-gallery__visual">
            <Image src={product.image.src} alt={product.image.alt} widths={[400, 640, 960, 1200]} sizes="(max-width: 767px) calc(100vw - 40px), 660px" loading="lazy" quality={70} class="family-page__image" />
          </div>
          <figcaption>Referencia de producto en contexto.</figcaption>
        </figure>
      ) : (
        <div class="family-model__visual--pending"><p>Galería de producto pendiente</p></div>
      ))}
    </div>
  </div>
</section>

<slot name="selection" />

<section class="family-closing family-page__section" aria-labelledby="family-closing-heading">
  <div class="family-page__inner family-closing__inner">
    <div>
      <p class="family-page__eyebrow">HABLEMOS DE TU LOCAL</p>
      <h2 id="family-closing-heading">{family.closing.title}</h2>
    </div>
    <div class="family-closing__copy">
      <p>{family.closing.text}</p>
      <a href={family.closing.href} class="family-closing__button">{family.closing.button}<span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .family-page__inner {
    max-width: 1360px;
    margin-inline: auto;
  }

  .family-page__section {
    padding: 48px 20px;
    background: #faf8f5;
    color: #2e2019;
  }

  .family-page__eyebrow {
    margin: 0 0 16px;
    color: #6b5e52;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1.6;
  }

  .family-page__section h2 {
    margin: 0;
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .family-page__section-heading {
    display: grid;
    gap: 20px;
    margin-bottom: 28px;
  }

  .family-page__intro {
    max-width: 460px;
    margin: 0;
    color: #6b5e52;
    font-size: 15px;
    line-height: 1.65;
  }

  .family-page__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .family-hero {
    padding: 24px 20px 40px;
    background: #211915;
    color: #f4f0e8;
  }

  .family-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-bottom: 20px;
    color: #c7bcb2;
    font-size: 12px;
  }

  .family-hero__back:hover {
    color: #f4f0e8;
  }

  .family-hero__heading {
    display: grid;
    gap: 24px;
    margin-bottom: 28px;
  }

  .family-hero .family-page__eyebrow,
  .family-closing .family-page__eyebrow {
    color: #c7bcb2;
  }

  .family-hero h1 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(42px, 5vw, 64px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .family-hero__copy p {
    max-width: 410px;
    margin: 0;
    color: #d8cebf;
    font-size: 17px;
    line-height: 1.6;
  }

  .family-hero__copy .family-hero__price {
    margin-top: 16px;
    color: #f4f0e8;
    font-size: 18px;
    font-weight: 500;
  }

  .family-hero__visual {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
  }

  .family-hero__visual--pending {
    display: grid;
    place-items: center;
    aspect-ratio: 2.35;
    border: 1px solid rgb(244 240 232 / 20%);
    color: #f4f0e8;
    font-size: 13px;
  }

  .family-models__list,
  .family-gallery__list {
    display: grid;
    gap: 32px;
  }

  .family-model__visual,
  .family-gallery__visual {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
  }

  .family-model__visual--pending {
    display: grid;
    place-items: center;
    aspect-ratio: 2;
    border: 1px solid rgb(46 32 25 / 16%);
    background: #efe7da;
  }

  .family-model__visual--pending p {
    padding: 20px;
    color: #6b5e52;
    font-size: 13px;
    text-align: center;
  }

  .family-model__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 22px;
  }

  .family-model h3 {
    margin: 0;
    font-size: 30px;
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .family-model__price {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    text-align: right;
  }

  .family-model__text {
    max-width: 560px;
    margin: 12px 0 0;
    color: #6b5e52;
    font-size: 15px;
    line-height: 1.65;
  }

  .family-uses {
    background: #efe7da;
  }

  .family-uses__list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 0;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .family-uses__list li {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .family-uses__list li:not(:last-child)::after {
    content: '·';
    margin-inline: 12px;
    color: #6b5e52;
  }

  .family-uses__note {
    max-width: 720px;
    margin: 24px 0 0;
    color: #6b5e52;
    font-size: 14px;
    line-height: 1.65;
  }

  .family-customization__list {
    display: grid;
    gap: 24px;
  }

  .family-customization__item {
    padding-top: 20px;
    border-top: 1px solid rgb(46 32 25 / 18%);
  }

  .family-customization__item h3 {
    margin: 0 0 12px;
    font-size: 23px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .family-customization__item p {
    margin: 0;
    color: #6b5e52;
    font-size: 15px;
    line-height: 1.65;
  }

  .family-gallery {
    padding-top: 8px;
  }

  .family-gallery figure {
    margin: 0;
  }

  .family-gallery figcaption {
    margin-top: 16px;
    color: #6b5e52;
    font-size: 13px;
  }

  .family-closing {
    background: #211915;
    color: #f4f0e8;
  }

  .family-closing__inner {
    display: grid;
    gap: 28px;
  }

  .family-closing h2 {
    max-width: 680px;
  }

  .family-closing__copy p {
    max-width: 460px;
    margin: 0;
    color: #d8cebf;
    font-size: 16px;
    line-height: 1.65;
  }

  .family-closing__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 100%;
    min-height: 48px;
    margin-top: 24px;
    padding: 14px 24px;
    border-radius: 999px;
    background: #faf8f5;
    color: #1c1613;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    text-align: center;
    transition: background-color 200ms;
  }

  .family-closing__button:hover {
    background: #ffffff;
  }

  .family-hero__back:focus-visible,
  .family-closing__button:focus-visible {
    outline: 2px solid #f4f0e8;
    outline-offset: 5px;
  }

  @media (min-width: 640px) {
    .family-page__section {
      padding: 56px 32px;
    }

    .family-hero {
      padding: 24px 32px 48px;
    }

    .family-gallery {
      padding-top: 8px;
    }
  }

  @media (min-width: 768px) {
    .family-page__section,
    .family-hero {
      padding-inline: 48px;
    }

    .family-hero__visual {
      aspect-ratio: 2.4;
      border-radius: 32px;
    }

    .family-models__list,
    .family-gallery__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .family-model__visual,
    .family-gallery__visual {
      border-radius: 32px;
    }

    .family-model__text,
    .family-customization__item p,
    .family-page__intro {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .family-page__section {
      padding: 72px 64px;
    }

    .family-hero {
      padding: 24px 64px 56px;
    }

    .family-hero__heading,
    .family-page__section-heading,
    .family-closing__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 64px;
    }

    .family-hero__heading {
      margin-bottom: 32px;
    }

    .family-page__section-heading {
      margin-bottom: 36px;
    }

    .family-models__list,
    .family-gallery__list {
      gap: 40px;
    }

    .family-customization__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
    }

    .family-gallery {
      padding-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .family-closing__button {
      transition: none;
    }
  }
</style>
