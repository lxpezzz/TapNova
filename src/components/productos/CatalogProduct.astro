---
import { Image } from 'astro:assets';
import { formatProductPrice, type Product } from '../../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const price = formatProductPrice(product.price);
---

<article
  class:list={['catalog-product', {
    'catalog-product--lead': product.featured,
    'catalog-product--compact': !product.image,
  }]}
  id={product.id}
  data-categories={product.categories.join(' ')}
  aria-labelledby={`${product.id}-name`}
>
  {product.image && (
    <div class="catalog-product__visual">
      <Image
        src={product.image.src}
        alt={product.image.alt}
        widths={product.featured ? [400, 640, 960, 1376] : [400, 640, 960, 1200]}
        sizes={product.featured
          ? '(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc(100vw - 96px), (max-width: 1487px) calc(100vw - 128px), 1360px'
          : '(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc((100vw - 128px) / 2), (max-width: 1487px) calc((100vw - 168px) / 2), 660px'}
        quality={70}
        loading="lazy"
        decoding="async"
        class="catalog-product__image"
      />
    </div>
  )}
  <div class="catalog-product__caption">
    <div class="catalog-product__copy">
      <h3 class="catalog-product__name" id={`${product.id}-name`}>{product.name}</h3>
      <p class="catalog-product__description">{product.description}</p>
    </div>
    <div class="catalog-product__actions">
      <p class="catalog-product__price">{price}</p>
      <a
        class="catalog-product__view"
        href={`/productos/${product.slug}`}
        aria-label={`Ver producto: ${product.name}`}
      >
        Ver producto <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .catalog-product {
    min-width: 0;
  }

  .catalog-product[hidden] {
    display: none;
  }

  .catalog-product--lead {
    grid-column: 1 / -1;
  }

  .catalog-product__visual {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    background: #211915;
  }

  .catalog-product__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .catalog-product__caption {
    padding-top: 22px;
  }

  .catalog-product__name {
    margin: 0;
    font-size: 28px;
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .catalog-product__description {
    max-width: 540px;
    margin: 12px 0 0;
    color: #6b5e52;
    font-size: 15px;
    line-height: 1.65;
  }

  .catalog-product__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 16px;
  }

  .catalog-product__price {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
  }

  .catalog-product__view {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: rgb(46 32 25 / 35%);
    cursor: pointer;
  }


  .catalog-product__view:hover {
    text-decoration-color: currentColor;
  }

  .catalog-product__view:focus-visible {
    outline: 2px solid #6b5e52;
    outline-offset: 4px;
  }

  .catalog-product--compact {
    border-top: 1px solid rgb(46 32 25 / 20%);
  }

  .catalog-product--compact .catalog-product__caption {
    padding-top: 24px;
  }

  @media (min-width: 768px) {
    .catalog-product__visual {
      border-radius: 32px;
    }
    .catalog-product--lead .catalog-product__visual {
      aspect-ratio: 2.35;
    }
    .catalog-product--lead .catalog-product__caption {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }
    .catalog-product--lead .catalog-product__name {
      font-size: 42px;
    }
    .catalog-product--lead .catalog-product__actions {
      min-width: 230px;
      margin: 0;
    }
    .catalog-product__description {
      font-size: 16px;
    }
  }
</style>
