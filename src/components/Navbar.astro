---

---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="brand-logo" aria-label="TapNova — Inicio">
      <span class="logo-mark">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="logo-svg"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="url(#logo-grad)"
            stroke-width="1.75"></circle>
          <path
            d="M9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12"
            stroke="#ffffff"
            stroke-width="1.75"
            stroke-linecap="round"></path>
          <circle cx="12" cy="12" r="1.5" fill="#ff9d24"></circle>
          <defs>
            <linearGradient
              id="logo-grad"
              x1="2"
              y1="2"
              x2="22"
              y2="22"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#feed7a"></stop>
              <stop offset="0.5" stop-color="#ff8400"></stop>
              <stop offset="1" stop-color="#df91f7"></stop>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="brand-text">TapNova</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/#explainer" class="nav-link">Cómo funciona</a></li>
        
        <!-- Dropdown de Productos Desktop -->
        <li class="nav-item-dropdown" id="nav-dropdown-item">
          <a
            href="/productos"
            class="nav-link nav-dropdown-trigger"
            id="nav-dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>Productos</span>
            <svg
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="dropdown-chevron"
              aria-hidden="true"
            >
              <path d="M2.5 3.75L5 6.25L7.5 3.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>

          <!-- Menú Flotante Minimalista -->
          <div class="nav-dropdown-menu" id="nav-dropdown-menu" role="menu" aria-label="Categorías de productos">
            <ul class="dropdown-list">
              <li role="none">
                <a href="/catalogo#portacuentas" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Portacuentas</span>
                </a>
              </li>
              <li role="none">
                <a href="/catalogo#portamenus" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Portamenús</span>
                </a>
              </li>
              <li role="none">
                <a href="/catalogo#expositores" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Expositores NFC + QR</span>
                </a>
              </li>
              <li role="none">
                <a href="/catalogo#tarjetas" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Tarjetas NFC</span>
                </a>
              </li>
              <li role="none">
                <a href="/catalogo#posavasos" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Posavasos</span>
                </a>
              </li>
              <li role="none">
                <a href="/catalogo#pegatinas" class="dropdown-link" role="menuitem">
                  <span class="dropdown-label">Pegatinas QR</span>
                </a>
              </li>
            </ul>
          </div>
        </li>

        <li><a href="/#seo-local" class="nav-link">SEO Local</a></li>
        <li><a href="/#paginas-web" class="nav-link">Webs</a></li>
        <li><a href="/#precios" class="nav-link">Precios</a></li>
        <li><a href="/#contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a
        href="/#contacto"
        class="btn-primary btn-nav-cta hidden sm:inline-flex"
      >
        <span>Solicitar presupuesto</span>
        <span class="btn-icon" aria-hidden="true">→</span>
      </a>

      <!-- Mobile Cart Button (arriba a la derecha, a la izquierda de las 3 rayitas) -->
      <button
        type="button"
        class="mobile-header-cart-btn"
        id="mobile-header-cart-btn"
        aria-label="Ver carrito de presupuesto"
      >
        <div class="mobile-cart-icon-box">
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="mobile-nav-cart-badge" id="mobile-nav-cart-badge">0</span>
        </div>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobile-menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-nav-overlay" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-content">
      <ul class="mobile-nav-list">
        <!-- Acordeón de Productos Mobile -->
        <li class="mobile-accordion-item" style="--stagger: 0;">
          <button
            type="button"
            class="mobile-accordion-btn"
            id="mobile-accordion-btn"
            aria-expanded="false"
            aria-controls="mobile-accordion-panel"
          >
            <span>Productos</span>
            <svg
              width="14"
              height="14"
              viewBox="0 0 10 10"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              class="mobile-accordion-icon"
              aria-hidden="true"
            >
              <path d="M2.5 3.75L5 6.25L7.5 3.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="mobile-accordion-panel" id="mobile-accordion-panel" hidden>
            <ul class="mobile-subnav-list">
              <li>
                <a href="/productos" class="mobile-sublink primary-cat-link">
                  <span>Ver todo el catálogo</span>
                  <span class="arrow-sub" aria-hidden="true">→</span>
                </a>
              </li>
              <li>
                <a href="/catalogo#portacuentas" class="mobile-sublink">Portacuentas</a>
              </li>
              <li>
                <a href="/catalogo#portamenus" class="mobile-sublink">Portamenús</a>
              </li>
              <li>
                <a href="/catalogo#expositores" class="mobile-sublink">Expositores NFC + QR</a>
              </li>
              <li>
                <a href="/catalogo#tarjetas" class="mobile-sublink">Tarjetas NFC</a>
              </li>
              <li>
                <a href="/catalogo#posavasos" class="mobile-sublink">Posavasos</a>
              </li>
              <li>
                <a href="/catalogo#pegatinas" class="mobile-sublink">Pegatinas QR</a>
              </li>
            </ul>
          </div>
        </li>

        <li style="--stagger: 1;">
          <a href="/#explainer" class="mobile-link">Cómo funciona</a>
        </li>
        <li style="--stagger: 2;">
          <a href="/#seo-local" class="mobile-link">SEO Local</a>
        </li>
        <li style="--stagger: 3;">
          <a href="/#paginas-web" class="mobile-link">Páginas Web</a>
        </li>
        <li style="--stagger: 4;">
          <a href="/#precios" class="mobile-link">Precios</a>
        </li>
        <li style="--stagger: 5;">
          <a href="/#contacto" class="mobile-link">Contacto</a>
        </li>
      </ul>
      <div class="mobile-nav-footer">
        <a href="/#contacto" class="btn-solid-white mobile-cta">
          <span>Solicitar información</span>
          <span class="btn-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: clamp(1rem, 2.5vw, 1.5rem) var(--page-inset);
    pointer-events: none;
    background: transparent;
    border-bottom: none;
    transition: transform 0.4s var(--ease-default);
  }

  .site-header.scrolled {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
  }

  .header-inner {
    width: 100%;
    max-width: var(--container-hero);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-primary);
  }

  .logo-mark {
    width: 2.1rem;
    height: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    font-family: var(--font-inter);
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    font-family: var(--font-inter);
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    outline: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ffffff;
  }

  /* DROPDOWN DESKTOP MINIMALISTA */
  .nav-item-dropdown {
    position: relative;
    padding: 0.5rem 0;
  }

  .dropdown-chevron {
    transition: transform 0.2s ease, stroke 0.15s ease;
    color: var(--text-secondary);
  }

  .nav-item-dropdown:hover .dropdown-chevron,
  .nav-item-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
    color: #ffffff;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 220px;
    background: #0d0d12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.45rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
    z-index: 120;
  }

  /* Abrir al hacer hover o focus-within */
  .nav-item-dropdown:hover .nav-dropdown-menu,
  .nav-item-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(2px);
  }

  .dropdown-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
  }

  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-inter);
    transition: color 0.15s ease, background 0.15s ease;
    outline: none;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }

  /* Naranja TapNova en hover/foco de ítem */
  .dropdown-link:hover .dropdown-label,
  .dropdown-link:focus-visible .dropdown-label {
    color: var(--accent-orange);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    pointer-events: auto;
  }

  @media (min-width: 960px) {
    .header-actions {
      gap: 1.15rem;
    }
  }

  .btn-nav-cta {
    display: none;
    font-size: 0.875rem;
    padding: 0.6rem 1.2rem;
    padding-right: 0.55rem;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .btn-nav-cta {
      display: inline-flex;
    }
  }

  /* Botón de Carrito Móvil Header */
  .mobile-header-cart-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 0;
    cursor: pointer;
    position: relative;
    z-index: 110;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-header-cart-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 132, 0, 0.4);
    transform: scale(1.04);
  }

  .mobile-header-cart-btn:active {
    transform: scale(0.95);
  }

  @media (max-width: 959px) {
    .mobile-header-cart-btn {
      display: flex;
    }
  }

  .mobile-cart-icon-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: color 0.18s ease;
  }

  .mobile-header-cart-btn:hover .mobile-cart-icon-box {
    color: var(--accent-orange);
  }

  .mobile-nav-cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e4e4e7;
    font-size: 0.65rem;
    font-weight: 750;
    font-family: var(--font-inter);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease;
  }

  .mobile-nav-cart-badge.has-items {
    background: var(--accent-orange);
    color: #050508;
    border-color: var(--accent-orange);
    box-shadow: 0 0 10px rgba(255, 132, 0, 0.6), 0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    padding: 0;
    z-index: 110;
  }

  @media (min-width: 960px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 14px;
    height: 1.5px;
    background: #ffffff;
    border-radius: 1px;
    transition:
      transform 0.3s var(--ease-default),
      opacity 0.3s var(--ease-default);
  }

  .mobile-toggle[aria-expanded="true"] .line-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .line-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 5, 5, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 105;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: max(var(--page-inset), env(safe-area-inset-top)) var(--page-inset)
      max(var(--page-inset), env(safe-area-inset-bottom));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-default);
  }

  .mobile-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    max-width: 380px;
    margin: 0 auto;
    width: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-inter);
    transition:
      color 0.2s var(--ease-default),
      transform 0.3s var(--ease-default);
    display: block;
    min-height: 44px;
    transform: translateY(14px);
    opacity: 0;
  }

  .mobile-nav-overlay.open .mobile-link,
  .mobile-nav-overlay.open .mobile-accordion-btn {
    transform: translateY(0);
    opacity: 1;
    transition-delay: calc(var(--stagger) * 0.04s);
  }

  .mobile-link:hover {
    color: #ffffff;
  }

  /* ACORDEÓN MOBILE DE PRODUCTOS */
  .mobile-accordion-item {
    display: flex;
    flex-direction: column;
  }

  .mobile-accordion-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    font-size: 1.4rem;
    font-weight: 600;
    font-family: var(--font-inter);
    color: var(--text-secondary);
    text-align: left;
    padding: 0;
    min-height: 44px;
    cursor: pointer;
    transform: translateY(14px);
    opacity: 0;
    transition: color 0.2s var(--ease-default), transform 0.3s var(--ease-default);
  }

  .mobile-accordion-btn:hover,
  .mobile-accordion-btn.is-open {
    color: #ffffff;
  }

  .mobile-accordion-icon {
    transition: transform 0.25s ease;
    color: var(--text-muted);
  }

  .mobile-accordion-btn.is-open .mobile-accordion-icon {
    transform: rotate(180deg);
    color: var(--accent-orange);
  }

  .mobile-accordion-panel {
    overflow: hidden;
    padding: 0.5rem 0 0.5rem 0.75rem;
    border-left: 2px solid rgba(255, 255, 255, 0.08);
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .mobile-accordion-panel[hidden] {
    display: none;
  }

  .mobile-subnav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .mobile-sublink {
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--font-inter);
    color: #a1a1aa;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.15s ease;
  }

  .mobile-sublink:hover {
    color: var(--accent-orange);
  }

  .mobile-sublink.primary-cat-link {
    color: #ffffff;
    font-weight: 600;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 0.25rem;
  }

  .arrow-sub {
    color: var(--accent-orange);
    font-size: 0.9rem;
  }

  .mobile-nav-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-cta {
    width: 100%;
    justify-content: center;
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const accordionBtn = document.getElementById("mobile-accordion-btn");
    const accordionPanel = document.getElementById("mobile-accordion-panel");

    if (!header || !toggle || !mobileNav) return;
    if (header.dataset.initialized) return;
    header.dataset.initialized = "true";

    function toggleMenu(forceClose = false) {
      const isOpen = forceClose
        ? false
        : toggle?.getAttribute("aria-expanded") !== "true";
      toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      mobileNav?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      mobileNav?.classList.toggle("open", isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";

      if (!isOpen && accordionPanel && accordionBtn) {
        accordionBtn.classList.remove("is-open");
        accordionBtn.setAttribute("aria-expanded", "false");
        accordionPanel.hidden = true;
      }
    }

    toggle.addEventListener("click", () => toggleMenu());

    // Acordeón Mobile al tocar "Productos"
    if (accordionBtn && accordionPanel) {
      accordionBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded = accordionBtn.getAttribute("aria-expanded") === "true";
        accordionBtn.setAttribute("aria-expanded", isExpanded ? "false" : "true");
        accordionBtn.classList.toggle("is-open", !isExpanded);
        accordionPanel.hidden = isExpanded;
      });
    }

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => toggleMenu(true));
    });

    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        toggleMenu(true);
      }
    });

    // -----------------------------------------------------------------------
    // Sincronización del badge de carrito móvil y acción de apertura
    // -----------------------------------------------------------------------
    const cartBadge = document.getElementById("mobile-nav-cart-badge");
    const mobileCartBtn = document.getElementById("mobile-header-cart-btn");

    function updateNavCartBadge() {
      try {
        const raw = localStorage.getItem('tapnova_b2b_cart_v1');
        const items = raw ? JSON.parse(raw) : [];
        const count = items.reduce((acc: number, item: any) => acc + (item.quantity || 1), 0);
        if (cartBadge) {
          cartBadge.textContent = count.toString();
          cartBadge.classList.toggle('has-items', count > 0);
        }
      } catch (e) {
        if (cartBadge) cartBadge.textContent = '0';
      }
    }

    updateNavCartBadge();
    window.addEventListener('storage', updateNavCartBadge);
    window.addEventListener('tapnova:cart-updated', updateNavCartBadge);

    if (mobileCartBtn && !mobileCartBtn.dataset.bound) {
      mobileCartBtn.dataset.bound = "true";
      mobileCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const cartBackdrop = document.getElementById('b2b-cart-backdrop');
        if (cartBackdrop) {
          window.dispatchEvent(new CustomEvent('tapnova:open-cart'));
        } else {
          window.location.href = '/productos#cart';
        }
      });
    }
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
