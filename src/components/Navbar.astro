<script>
  function isElementLuminant(el: HTMLElement): boolean {
    if (
      el.dataset.theme === "light" ||
      el.dataset.headerTheme === "light" ||
      el.classList.contains("light-theme")
    ) {
      return true;
    }
    try {
      const style = window.getComputedStyle(el);
      const bg = style.backgroundColor;
      const rgbMatch = bg.match(
        /rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/,
      );
      if (rgbMatch) {
        const r = parseInt(rgbMatch[1], 10);
        const g = parseInt(rgbMatch[2], 10);
        const b = parseInt(rgbMatch[3], 10);
        const a = rgbMatch[4] !== undefined ? parseFloat(rgbMatch[4]) : 1;
        if (a > 0.25) {
          const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
          if (luminance > 0.6) return true;
        }
      }
    } catch (err) {}
    return false;
  }

  function updateHeaderTheme() {
    const header = document.getElementById("site-header");
    if (!header) return;

    const isScrolled = window.scrollY > 20;
    header.classList.toggle("scrolled", isScrolled);

    // Si la página completa es /productos o el main tiene tema claro
    const lightMain = document.querySelector(
      'main[data-theme="light"], .b2b-marketplace-page[data-theme="light"]',
    );
    const isProductPage =
      window.location.pathname.startsWith("/productos") ||
      window.location.pathname.startsWith("/catalogo");

    // Buscar si el footer (oscuro) está tocando el header
    const headerRect = header.getBoundingClientRect();
    const headerCheckY = headerRect.top + Math.min(headerRect.height / 2, 35);

    const footer = document.querySelector(".site-footer, footer");
    if (footer) {
      const fRect = footer.getBoundingClientRect();
      if (fRect.top <= headerCheckY) {
        header.classList.remove("site-header--light");
        return;
      }
    }

    if (lightMain || isProductPage) {
      header.classList.add("site-header--light");
      return;
    }

    // Detección por secciones en páginas mixtas (por ejemplo si section#productos o cualquier bloque tiene fondo claro)
    const lightCandidates = document.querySelectorAll<HTMLElement>(
      '[data-theme="light"], [data-header-theme="light"], #productos, .featured-products-section',
    );

    let foundLightSection = false;
    for (const el of lightCandidates) {
      if (isElementLuminant(el)) {
        const rect = el.getBoundingClientRect();
        if (rect.top <= headerCheckY && rect.bottom > headerCheckY) {
          foundLightSection = true;
          break;
        }
      }
    }

    header.classList.toggle("site-header--light", foundLightSection);
  }

  function initHeader() {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");
    const accordionBtn = document.getElementById("mobile-accordion-btn");
    const accordionPanel = document.getElementById("mobile-accordion-panel");

    if (!header || !toggle || !mobileNav) return;

    updateHeaderTheme();

    if (header.dataset.initialized) return;
    header.dataset.initialized = "true";

    window.addEventListener("scroll", updateHeaderTheme, { passive: true });
    window.addEventListener("resize", updateHeaderTheme, { passive: true });

    function toggleMenu(forceClose = false) {
      const isOpen = forceClose
        ? false
        : toggle?.getAttribute("aria-expanded") !== "true";
      toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      mobileNav?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      mobileNav?.classList.toggle("open", isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";

      if (!isOpen && accordionPanel && accordionBtn) {
        accordionBtn.classList.remove("is-open");
        accordionBtn.setAttribute("aria-expanded", "false");
        accordionPanel.hidden = true;
      }
    }

    toggle.addEventListener("click", () => toggleMenu());

    // Acordeón Mobile al tocar "Productos"
    if (accordionBtn && accordionPanel) {
      accordionBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isExpanded =
          accordionBtn.getAttribute("aria-expanded") === "true";
        accordionBtn.setAttribute(
          "aria-expanded",
          isExpanded ? "false" : "true",
        );
        accordionBtn.classList.toggle("is-open", !isExpanded);
        accordionPanel.hidden = isExpanded;
      });
    }

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => toggleMenu(true));
    });

    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        toggleMenu(true);
      }
    });

    // -----------------------------------------------------------------------
    // Sincronización del badge de carrito móvil y acción de apertura
    // -----------------------------------------------------------------------
    const cartBadge = document.getElementById("mobile-nav-cart-badge");
    const mobileCartBtn = document.getElementById("mobile-header-cart-btn");

    function updateNavCartBadge() {
      try {
        const raw = localStorage.getItem("tapnova_b2b_cart_v1");
        const items = raw ? JSON.parse(raw) : [];
        const count = items.reduce(
          (acc: number, item: any) => acc + (item.quantity || 1),
          0,
        );
        if (cartBadge) {
          cartBadge.textContent = count.toString();
          cartBadge.classList.toggle("has-items", count > 0);
        }
      } catch (e) {
        if (cartBadge) cartBadge.textContent = "0";
      }
    }

    updateNavCartBadge();
    window.addEventListener("storage", updateNavCartBadge);
    window.addEventListener("tapnova:cart-updated", updateNavCartBadge);

    if (mobileCartBtn && !mobileCartBtn.dataset.bound) {
      mobileCartBtn.dataset.bound = "true";
      mobileCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        const cartBackdrop = document.getElementById("b2b-cart-backdrop");
        if (cartBackdrop) {
          window.dispatchEvent(new CustomEvent("tapnova:open-cart"));
        } else {
          window.location.href = "/productos#cart";
        }
      });
    }
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
