---
import ArrowRight from './ArrowRight.astro';
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="brand-logo" aria-label="TapNova — Inicio">
      <svg
        class="brand-logo-vector"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 760 180"
        aria-hidden="true"
      >
        <defs>
          <linearGradient
            id="header-star-gradient"
            x1="40"
            y1="145"
            x2="150"
            y2="28"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#ff8a16"></stop>
            <stop offset=".45" stop-color="#ec4b88"></stop>
            <stop offset="1" stop-color="#a936f1"></stop>
          </linearGradient>
          <linearGradient
            id="header-nova-gradient"
            x1="322"
            y1="45"
            x2="585"
            y2="138"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#ff8612"></stop>
            <stop offset=".38" stop-color="#f15d78"></stop>
            <stop offset="1" stop-color="#a238ed"></stop>
          </linearGradient>
        </defs>
        <path
          d="M96.4 21.4 117 79.5l61.8.8-49.1 37.5 17.7 59.2-51-35-50.9 35 17.7-59.2-49.2-37.5 61.9-.8z"
          fill="none"
          stroke="url(#header-star-gradient)"
          stroke-linejoin="round"
          stroke-width="13"></path>
        <text
          class="brand-logo-tap"
          x="195"
          y="141"
          fill="#fff"
          font-family="Arial Black, Inter, Arial, sans-serif"
          font-size="112"
          font-weight="900"
          letter-spacing="-2">Tap</text
        >
        <text
          x="420"
          y="141"
          fill="url(#header-nova-gradient)"
          font-family="Arial Black, Inter, Arial, sans-serif"
          font-size="112"
          font-weight="900"
          letter-spacing="-2">Nova</text
        >
      </svg>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/#explainer" class="nav-link">Cómo funciona</a></li>

        <!-- Dropdown de Productos Desktop -->
        <li class="nav-item-dropdown" id="nav-dropdown-item">
          <a
            href="/productos"
            class="nav-link nav-dropdown-trigger"
            id="nav-dropdown-trigger"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>Productos</span>
            <ArrowRight direction="down" class="dropdown-chevron" />
          </a>

          <!-- Menú Flotante Minimalista -->
          <div
            class="nav-dropdown-menu"
            id="nav-dropdown-menu"
            role="menu"
            aria-label="Categorías de productos"
          >
            <ul class="dropdown-list">
              <li role="none">
                <a
                  href="/catalogo#portacuentas"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Portacuentas</span>
                </a>
              </li>
              <li role="none">
                <a
                  href="/catalogo#portamenus"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Portamenús</span>
                </a>
              </li>
              <li role="none">
                <a
                  href="/catalogo#expositores"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Expositores NFC + QR</span>
                </a>
              </li>
              <li role="none">
                <a
                  href="/catalogo#tarjetas"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Tarjetas NFC</span>
                </a>
              </li>
              <li role="none">
                <a
                  href="/catalogo#posavasos"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Posavasos</span>
                </a>
              </li>
              <li role="none">
                <a
                  href="/catalogo#pegatinas"
                  class="dropdown-link"
                  role="menuitem"
                >
                  <span class="dropdown-label">Pegatinas QR</span>
                </a>
              </li>
            </ul>
          </div>
        </li>

        <li><a href="/seo-local" class="nav-link">SEO Local</a></li>
        <li><a href="/#paginas-web" class="nav-link">Webs</a></li>
        <li><a href="/preguntas-frecuentes" class="nav-link">Preguntas frecuentes</a></li>
        <li><a href="/#contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a
        href="/#contacto"
        class="btn-primary btn-nav-cta hidden sm:inline-flex"
      >
        <span>Solicitar presupuesto</span>
        <span class="btn-icon" aria-hidden="true"><ArrowRight /></span>
      </a>

      <!-- Mobile Cart Button (arriba a la derecha, a la izquierda de las 3 rayitas) -->
      <button
        type="button"
        class="mobile-header-cart-btn"
        id="mobile-header-cart-btn"
        aria-label="Ver carrito de presupuesto"
      >
        <div class="mobile-cart-icon-box">
          <svg
            width="19"
            height="19"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="mobile-nav-cart-badge" id="mobile-nav-cart-badge">0</span
          >
        </div>
      </button>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobile-menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-nav-overlay" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-content">
      <ul class="mobile-nav-list">
        <!-- Acordeón de Productos Mobile -->
        <li class="mobile-accordion-item" style="--stagger: 0;">
          <button
            type="button"
            class="mobile-accordion-btn"
            id="mobile-accordion-btn"
            aria-expanded="false"
            aria-controls="mobile-accordion-panel"
          >
            <span>Productos</span>
            <ArrowRight direction="down" class="mobile-accordion-icon" />
          </button>
          <div
            class="mobile-accordion-panel"
            id="mobile-accordion-panel"
            hidden
          >
            <ul class="mobile-subnav-list">
              <li>
                <a href="/productos" class="mobile-sublink primary-cat-link">
                  <span>Ver todo el catálogo</span>
                  <span class="arrow-sub" aria-hidden="true"><ArrowRight /></span>
                </a>
              </li>
              <li>
                <a href="/catalogo#portacuentas" class="mobile-sublink"
                  >Portacuentas</a
                >
              </li>
              <li>
                <a href="/catalogo#portamenus" class="mobile-sublink"
                  >Portamenús</a
                >
              </li>
              <li>
                <a href="/catalogo#expositores" class="mobile-sublink"
                  >Expositores NFC + QR</a
                >
              </li>
              <li>
                <a href="/catalogo#tarjetas" class="mobile-sublink"
                  >Tarjetas NFC</a
                >
              </li>
              <li>
                <a href="/catalogo#posavasos" class="mobile-sublink"
                  >Posavasos</a
                >
              </li>
              <li>
                <a href="/catalogo#pegatinas" class="mobile-sublink"
                  >Pegatinas QR</a
                >
              </li>
            </ul>
          </div>
        </li>

        <li style="--stagger: 1;">
          <a href="/#explainer" class="mobile-link">Cómo funciona</a>
        </li>
        <li style="--stagger: 2;">
          <a href="/seo-local" class="mobile-link">SEO Local</a>
        </li>
        <li style="--stagger: 3;">
          <a href="/#paginas-web" class="mobile-link">Páginas Web</a>
        </li>
        <li style="--stagger: 4;">
          <a href="/#packs" class="mobile-link">Packs</a>
        </li>
        <li style="--stagger: 5;">
          <a href="/#contacto" class="mobile-link">Contacto</a>
        </li>
      </ul>
      <div class="mobile-nav-footer">
        <a href="/#contacto" class="btn-solid-white mobile-cta">
          <span>Solicitar información</span>
          <span class="btn-icon" aria-hidden="true"><ArrowRight /></span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: clamp(1rem, 2.5vw, 1.5rem) var(--page-inset);
    pointer-events: none;
    background: transparent;
    border-bottom: none;
    transition: transform 0.4s var(--ease-default);
  }

  .site-header.scrolled {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
  }

  .header-inner {
    width: 100%;
    max-width: var(--container-hero);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    width: clamp(10rem, 15vw, 11rem);
    min-width: 0;
    line-height: 0;
  }

  .brand-logo-vector {
    display: block;
    width: 100%;
    height: auto;
    max-width: none;
  }

  .brand-logo-tap {
    transition: fill 0.25s ease;
  }

  @media (max-width: 639px) {
    .brand-logo {
      width: 11rem;
    }
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
    font-family: var(--font-inter);
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    font-family: var(--font-inter);
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    outline: none;
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: #ffffff;
  }

  /* DROPDOWN DESKTOP MINIMALISTA */
  .nav-item-dropdown {
    position: relative;
    padding: 0.5rem 0;
  }

  .dropdown-chevron {
    font-size: 0.625rem;
    transition:
      transform 0.2s ease,
      stroke 0.15s ease;
    color: var(--text-secondary);
  }

  .nav-item-dropdown:hover .dropdown-chevron,
  .nav-item-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
    color: #ffffff;
  }

  .nav-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 220px;
    background: #0d0d12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 0.45rem;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
    z-index: 120;
  }

  /* Abrir al hacer hover o focus-within */
  .nav-item-dropdown:hover .nav-dropdown-menu,
  .nav-item-dropdown:focus-within .nav-dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(2px);
  }

  .dropdown-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
  }

  .dropdown-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 500;
    font-family: var(--font-inter);
    transition:
      color 0.15s ease,
      background 0.15s ease;
    outline: none;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.04);
  }

  /* Naranja TapNova en hover/foco de ítem */
  .dropdown-link:hover .dropdown-label,
  .dropdown-link:focus-visible .dropdown-label {
    color: var(--accent-orange);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    pointer-events: auto;
  }

  @media (min-width: 960px) {
    .header-actions {
      gap: 1.15rem;
    }
  }

  .btn-nav-cta {
    display: none;
    font-size: 0.875rem;
    padding: 0.6rem 1.2rem;
    padding-right: 0.55rem;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .btn-nav-cta {
      display: inline-flex;
    }
  }

  /* Botón de Carrito Móvil Header */
  .mobile-header-cart-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    color: #ffffff;
    padding: 0;
    cursor: pointer;
    position: relative;
    z-index: 110;
    transition:
      transform 0.18s ease,
      background 0.18s ease,
      border-color 0.18s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-header-cart-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 132, 0, 0.4);
    transform: scale(1.04);
  }

  .mobile-header-cart-btn:active {
    transform: scale(0.95);
  }

  @media (max-width: 959px) {
    .mobile-header-cart-btn {
      display: flex;
    }
  }

  .mobile-cart-icon-box {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: color 0.18s ease;
  }

  .mobile-header-cart-btn:hover .mobile-cart-icon-box {
    color: var(--accent-orange);
  }

  .mobile-nav-cart-badge {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e4e4e7;
    font-size: 0.65rem;
    font-weight: 750;
    font-family: var(--font-inter);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease;
  }

  .mobile-nav-cart-badge.has-items {
    background: var(--accent-orange);
    color: #050508;
    border-color: var(--accent-orange);
    box-shadow:
      0 0 10px rgba(255, 132, 0, 0.6),
      0 2px 6px rgba(0, 0, 0, 0.6);
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    padding: 0;
    z-index: 110;
  }

  @media (min-width: 960px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 14px;
    height: 1.5px;
    background: #ffffff;
    border-radius: 1px;
    transition:
      transform 0.3s var(--ease-default),
      opacity 0.3s var(--ease-default);
  }

  .mobile-toggle[aria-expanded="true"] .line-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .line-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 5, 5, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 105;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: max(var(--page-inset), env(safe-area-inset-top)) var(--page-inset)
      max(var(--page-inset), env(safe-area-inset-bottom));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-default);
  }

  .mobile-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    max-width: 380px;
    margin: 0 auto;
    width: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-secondary);
    font-family: var(--font-inter);
    transition:
      color 0.2s var(--ease-default),
      transform 0.3s var(--ease-default);
    display: block;
    min-height: 44px;
    transform: translateY(14px);
    opacity: 0;
  }

  .mobile-nav-overlay.open .mobile-link,
  .mobile-nav-overlay.open .mobile-accordion-btn {
    transform: translateY(0);
    opacity: 1;
    transition-delay: calc(var(--stagger) * 0.04s);
  }

  .mobile-link:hover {
    color: #ffffff;
  }

  /* ACORDEÓN MOBILE DE PRODUCTOS */
  .mobile-accordion-item {
    display: flex;
    flex-direction: column;
  }

  .mobile-accordion-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: transparent;
    border: none;
    font-size: 1.4rem;
    font-weight: 600;
    font-family: var(--font-inter);
    color: var(--text-secondary);
    text-align: left;
    padding: 0;
    min-height: 44px;
    cursor: pointer;
    transform: translateY(14px);
    opacity: 0;
    transition:
      color 0.2s var(--ease-default),
      transform 0.3s var(--ease-default);
  }

  .mobile-accordion-btn:hover,
  .mobile-accordion-btn.is-open {
    color: #ffffff;
  }

  .mobile-accordion-icon {
    font-size: 0.875rem;
    transition: transform 0.25s ease;
    color: var(--text-muted);
  }

  .mobile-accordion-btn.is-open .mobile-accordion-icon {
    transform: rotate(180deg);
    color: var(--accent-orange);
  }

  .mobile-accordion-panel {
    overflow: hidden;
    padding: 0.5rem 0 0.5rem 0.75rem;
    border-left: 2px solid rgba(255, 255, 255, 0.08);
    margin-top: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .mobile-accordion-panel[hidden] {
    display: none;
  }

  .mobile-subnav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .mobile-sublink {
    font-size: 1rem;
    font-weight: 500;
    font-family: var(--font-inter);
    color: #a1a1aa;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: color 0.15s ease;
  }

  .mobile-sublink:hover {
    color: var(--accent-orange);
  }

  .mobile-sublink.primary-cat-link {
    color: #ffffff;
    font-weight: 600;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 0.25rem;
  }

  .arrow-sub {
    color: var(--accent-orange);
    font-size: 0.9rem;
  }

  .mobile-nav-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-cta {
    width: 100%;
    justify-content: center;
  }

  /* =========================================================================
     CABECERA ADAPTATIVA: MODO CLARO (SECCIÓN DE PRODUCTOS / FONDOS CLAROS)
     - Logo Tap: Negro (#000000)
     - Enlaces navegación (Cómo funciona -> Contacto): Gris oscuro (#374151)
     - CTA "Solicitar presupuesto": En oscuro (#0d0d12 con texto blanco)
     - Botones móviles (hamburguesa y carrito): Adaptados con alto contraste
     ========================================================================= */

  /* 1. Logo: Tap en negro */
  .site-header--light .brand-logo-tap,
  :global(body:has([data-theme="light"])) .site-header .brand-logo-tap,
  :global(body:has(.b2b-marketplace-page[data-theme="light"])) .site-header .brand-logo-tap {
    fill: #000000 !important;
  }

  /* 2. Items de navegación: de 'Cómo funciona' hasta 'Contacto' en gris oscuro */
  .site-header--light .nav-link,
  :global(body:has([data-theme="light"])) .site-header .nav-link,
  :global(body:has(.b2b-marketplace-page[data-theme="light"])) .site-header .nav-link {
    color: #374151;
  }

  .site-header--light .nav-link:hover,
  .site-header--light .nav-link:focus-visible,
  :global(body:has([data-theme="light"])) .site-header .nav-link:hover,
  :global(body:has([data-theme="light"])) .site-header .nav-link:focus-visible,
  :global(body:has(.b2b-marketplace-page[data-theme="light"])) .site-header .nav-link:hover,
  :global(body:has(.b2b-marketplace-page[data-theme="light"])) .site-header .nav-link:focus-visible {
    color: #000000;
  }

  .site-header--light .dropdown-chevron,
  :global(body:has([data-theme="light"])) .site-header .dropdown-chevron,
  :global(body:has(.b2b-marketplace-page[data-theme="light"])) .site-header .dropdown-chevron {
    color: #4b5563;
  }

  .site-header--light .nav-item-dropdown:hover .dropdown-chevron,
  .site-header--light .nav-item-dropdown:focus-within .dropdown-chevron,
  :global(body:has([data-theme="light"])) .site-header .nav-item-dropdown:hover .dropdown-chevron,
