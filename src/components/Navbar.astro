---

---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="brand-logo" aria-label="TapNova — Inicio">
      <span class="logo-mark">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          class="logo-svg"
          aria-hidden="true"
        >
          <circle
            cx="12"
            cy="12"
            r="10"
            stroke="url(#logo-grad)"
            stroke-width="1.75"></circle>
          <path
            d="M9 12C9 10.3431 10.3431 9 12 9C13.6569 9 15 10.3431 15 12"
            stroke="#ffffff"
            stroke-width="1.75"
            stroke-linecap="round"></path>
          <circle cx="12" cy="12" r="1.5" fill="#ff9d24"></circle>
          <defs>
            <linearGradient
              id="logo-grad"
              x1="2"
              y1="2"
              x2="22"
              y2="22"
              gradientUnits="userSpaceOnUse"
            >
              <stop stop-color="#feed7a"></stop>
              <stop offset="0.5" stop-color="#ff8400"></stop>
              <stop offset="1" stop-color="#df91f7"></stop>
            </linearGradient>
          </defs>
        </svg>
      </span>
      <span class="brand-text">TapNova</span>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="desktop-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li><a href="/#explainer" class="nav-link">Cómo funciona</a></li>
        <li><a href="/#productos" class="nav-link">Productos</a></li>
        <li><a href="/#seo-local" class="nav-link">SEO Local</a></li>
        <li><a href="/#paginas-web" class="nav-link">Webs</a></li>
        <li><a href="/#precios" class="nav-link">Precios</a></li>
        <li><a href="/#contacto" class="nav-link">Contacto</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a
        href="/#contacto"
        class="btn-primary btn-nav-cta hidden sm:inline-flex"
      >
        <span>Solicitar información</span>
        <span class="btn-icon" aria-hidden="true">→</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobile-menu-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-line line-1"></span>
        <span class="hamburger-line line-2"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Overlay -->
  <div class="mobile-nav-overlay" id="mobile-nav" aria-hidden="true">
    <div class="mobile-nav-content">
      <ul class="mobile-nav-list">
        <li style="--stagger: 0;">
          <a href="/#productos" class="mobile-link">Productos</a>
        </li>
        <li style="--stagger: 1;">
          <a href="/#explainer" class="mobile-link">Cómo funciona</a>
        </li>
        <li style="--stagger: 2;">
          <a href="/#seo-local" class="mobile-link">SEO Local</a>
        </li>
        <li style="--stagger: 3;">
          <a href="/#paginas-web" class="mobile-link">Páginas Web</a>
        </li>
        <li style="--stagger: 4;">
          <a href="/#precios" class="mobile-link">Precios</a>
        </li>
        <li style="--stagger: 5;">
          <a href="/#contacto" class="mobile-link">Contacto</a>
        </li>
      </ul>
      <div class="mobile-nav-footer">
        <a href="/#contacto" class="btn-solid-white mobile-cta">
          <span>Solicitar información</span>
          <span class="btn-icon" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    padding: clamp(1rem, 2.5vw, 1.5rem) var(--page-inset);
    pointer-events: none;
    background: transparent;
    border-bottom: none;
    transition: transform 0.4s var(--ease-default);
  }

  .site-header.scrolled {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
  }

  .header-inner {
    width: 100%;
    max-width: var(--container-hero);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: auto;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-primary);
  }

  .logo-mark {
    width: 2.1rem;
    height: 2.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-svg {
    width: 100%;
    height: 100%;
  }

  .brand-text {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .desktop-nav {
    display: none;
  }

  @media (min-width: 960px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    font-weight: 500;
    transition: color 0.2s var(--ease-default);
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    pointer-events: auto;
  }

  .btn-nav-cta {
    display: none;
    font-size: 0.875rem;
    padding: 0.6rem 1.2rem;
    padding-right: 0.55rem;
    min-height: 44px;
  }

  @media (min-width: 640px) {
    .btn-nav-cta {
      display: inline-flex;
    }
  }

  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-subtle);
    padding: 0;
    z-index: 110;
  }

  @media (min-width: 960px) {
    .mobile-toggle {
      display: none;
    }
  }

  .hamburger-line {
    display: block;
    width: 14px;
    height: 1.5px;
    background: #ffffff;
    border-radius: 1px;
    transition:
      transform 0.3s var(--ease-default),
      opacity 0.3s var(--ease-default);
  }

  .mobile-toggle[aria-expanded="true"] .line-1 {
    transform: translateY(3.25px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .line-2 {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(5, 5, 5, 0.96);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 105;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: max(var(--page-inset), env(safe-area-inset-top)) var(--page-inset)
      max(var(--page-inset), env(safe-area-inset-bottom));
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-default);
  }

  .mobile-nav-overlay.open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    max-width: 380px;
    margin: 0 auto;
    width: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .mobile-link {
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition:
      color 0.2s var(--ease-default),
      transform 0.3s var(--ease-default);
    display: block;
    min-height: 44px;
    transform: translateY(14px);
    opacity: 0;
  }

  .mobile-nav-overlay.open .mobile-link {
    transform: translateY(0);
    opacity: 1;
    transition-delay: calc(var(--stagger) * 0.04s);
  }

  .mobile-link:hover {
    color: #ffffff;
  }

  .mobile-nav-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-cta {
    width: 100%;
    justify-content: center;
  }
</style>

<script>
  function initHeader() {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const mobileNav = document.getElementById("mobile-nav");

    if (!header || !toggle || !mobileNav) return;
    if (header.dataset.initialized) return;
    header.dataset.initialized = "true";

    function toggleMenu(forceClose = false) {
      const isOpen = forceClose
        ? false
        : toggle?.getAttribute("aria-expanded") !== "true";
      toggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
      mobileNav?.setAttribute("aria-hidden", isOpen ? "false" : "true");
      mobileNav?.classList.toggle("open", isOpen);
      document.body.style.overflow = isOpen ? "hidden" : "";
    }

    toggle.addEventListener("click", () => toggleMenu());

    mobileNav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => toggleMenu(true));
    });

    window.addEventListener("keydown", (e) => {
      if (
        e.key === "Escape" &&
        toggle.getAttribute("aria-expanded") === "true"
      ) {
        toggleMenu(true);
      }
    });
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
