---
import ArrowRight from './ArrowRight.astro';
---

<section class="final-cta-section" id="contacto" aria-label="Contacto con el equipo de TapNova">
  <!-- Macro Halo Cósmico de Fondo -->
  <div class="cta-supernova-glow" aria-hidden="true"></div>

  <div class="section-container">
    <!-- Grid Principal de Contacto (2 Columnas Transparentes) -->
    <div class="cta-stage-grid">

      <!-- ===================================================================
           COLUMNA IZQUIERDA: LOGO VECTORIAL TAPNOVA + DECLARACIÓN
           =================================================================== -->
      <div class="cta-stage-left">
          
          <!-- Logotipo Vectorial TapNova a la Izquierda -->
          <div class="brand-wordmark-wrap">
            <svg
              class="brand-vector-svg"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 670 180"
              role="img"
              aria-label="TapNova"
            >
              <defs>
                <linearGradient id="ctaStarGrad" x1="40" y1="145" x2="150" y2="28" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#ff8a16"/>
                  <stop offset="45%" stop-color="#ec4b88"/>
                  <stop offset="100%" stop-color="#a936f1"/>
                </linearGradient>
                <linearGradient id="ctaNovaGrad" x1="322" y1="45" x2="585" y2="138" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#ff8612"/>
                  <stop offset="38%" stop-color="#f15d78"/>
                  <stop offset="100%" stop-color="#a238ed"/>
                </linearGradient>
              </defs>
              <path
                d="M96.4 21.4 117 79.5l61.8.8-49.1 37.5 17.7 59.2-51-35-50.9 35 17.7-59.2-49.2-37.5 61.9-.8z"
                fill="none"
                stroke="url(#ctaStarGrad)"
                stroke-linejoin="round"
                stroke-width="13"
              />
              <text x="195" y="130" fill="#fff" font-family="Arial Black, Inter, Arial, sans-serif" font-size="112" font-weight="900" letter-spacing="-8">Tap</text>
              <text x="374" y="130" fill="url(#ctaNovaGrad)" font-family="Arial Black, Inter, Arial, sans-serif" font-size="112" font-weight="900" letter-spacing="-8">Nova</text>
            </svg>
          </div>

          <!-- Declaración de Marca (Editorial, Sin Clutter) -->
          <div class="brand-editorial-block">
            <h2 class="editorial-heading font-display">
              Tu sala cuida cada detalle.<br />
              <span class="gradient-text">Tu reputación en Google también.</span>
            </h2>
            <p class="editorial-sub">
              Soportes de alta gama grabados a láser con la identidad de tu restaurante. Hablemos de tu local sin compromisos comerciales.
            </p>
          </div>

          <!-- Línea Directa de WhatsApp (Píldora Háptica) -->
          <div class="hotline-pill-wrapper">
            <a 
              href="https://wa.me/34600000000?text=Hola%20TapNova%2C%20me%20gustar%C3%ADa%20hablar%20con%20vosotros%20sobre%20mi%20restaurante" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="hotline-pill"
            >
              <span class="pulse-laser-dot" aria-hidden="true"></span>
              <span class="hotline-text">Línea directa WhatsApp · Respuesta en ~15 min</span>
              <span class="hotline-arrow" aria-hidden="true">↗</span>
            </a>
          </div>

        </div>

        <!-- ===================================================================
             COLUMNA DERECHA: FORMULARIO DE 4 CAMPOS CON ACABADO DE PRECISIÓN
             =================================================================== -->
        <div class="cta-stage-right">
          <div class="form-title-group">
            <h3 class="chamber-headline font-display">Hablemos de tu restaurante</h3>
            <p class="chamber-sub">Completa los 4 datos y un especialista de sala preparará tu propuesta a medida.</p>
          </div>

            <form class="precision-contact-form" id="precision-contact-form" novalidate>
              <div class="inputs-matrix">
                
                <!-- 1. Nombre -->
                <div class="matrix-field">
                  <label for="field-nombre" class="matrix-label">
                    <span>Nombre</span>
                    <span class="field-asterisk">*</span>
                  </label>
                  <div class="matrix-input-wrap">
                    <input 
                      type="text" 
                      id="field-nombre" 
                      name="nombre" 
                      class="matrix-input" 
                      placeholder="Tu nombre" 
                      required 
                      autocomplete="name"
                    />
                  </div>
                </div>

                <!-- 2. Nombre del Restaurante -->
                <div class="matrix-field">
                  <label for="field-restaurante" class="matrix-label">
                    <span>Restaurante</span>
                    <span class="field-asterisk">*</span>
                  </label>
                  <div class="matrix-input-wrap">
                    <input 
                      type="text" 
                      id="field-restaurante" 
                      name="restaurante" 
                      class="matrix-input" 
                      placeholder="Nombre de tu local" 
                      required 
                      autocomplete="organization"
                    />
                  </div>
                </div>

                <!-- 3. Teléfono -->
                <div class="matrix-field">
                  <label for="field-telefono" class="matrix-label">
                    <span>Teléfono</span>
                    <span class="field-asterisk">*</span>
                  </label>
                  <div class="matrix-input-wrap">
                    <input 
                      type="tel" 
                      id="field-telefono" 
                      name="telefono" 
                      class="matrix-input" 
                      placeholder="+34 600 000 000" 
                      required 
                      autocomplete="tel"
                    />
                  </div>
                </div>

                <!-- 4. Correo Electrónico -->
                <div class="matrix-field">
                  <label for="field-email" class="matrix-label">
                    <span>Correo</span>
                    <span class="field-asterisk">*</span>
                  </label>
                  <div class="matrix-input-wrap">
                    <input 
                      type="email" 
                      id="field-email" 
                      name="email" 
                      class="matrix-input" 
                      placeholder="contacto@restaurante.com" 
                      required 
                      autocomplete="email"
                    />
                  </div>
                </div>

              </div>

              <!-- Spectacular Button-in-Button CTA -->
              <div class="cta-button-enclosure">
                <button type="submit" class="kinetic-cta-btn" id="precision-submit-btn">
                  <span class="btn-text-label">Solicitar propuesta a medida</span>
                  <span class="btn-trailing-disc" aria-hidden="true">
                    <ArrowRight />
                  </span>
                </button>
              </div>

              <p class="chamber-security-note">
                <span>🔒 100% Confidencial</span>
                <span class="dot-sep">·</span>
                <span>Asignación de especialista en sala</span>
                <span class="dot-sep">·</span>
                <span>Sin spam</span>
              </p>

              <!-- Feedback Banner de Confirmación -->
              <div class="precision-success-banner" id="precision-success-banner" hidden>
                <div class="success-icon-disc">✓</div>
                <div class="success-copy">
                  <strong class="success-heading">Solicitud recibida con éxito</strong>
                  <p class="success-desc">Un especialista de sala te enviará la propuesta y catálogo adaptado a tu local.</p>
                </div>
              </div>

            </form>
        </div>
      </div>
    </div>
  </section>

<style>
  /* -------------------------------------------------------------------------
     SECCIÓN CONTENEDORA & ESPACIO CÓSMICO
     ------------------------------------------------------------------------- */
  .final-cta-section {
    position: relative;
    padding-top: clamp(4rem, 7vw, 7.5rem);
    padding-bottom: clamp(5rem, 9vw, 9.5rem);
    background: transparent;
    overflow: visible;
  }

  /* Halo Supernova en el fondo cósmico */
  .cta-supernova-glow {
    position: absolute;
    bottom: -15%;
    left: 20%;
    width: clamp(550px, 65vw, 950px);
    height: clamp(450px, 50vw, 750px);
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 140, 0, 0.18) 0%,
      rgba(223, 145, 247, 0.11) 45%,
      transparent 72%
    );
    filter: blur(100px);
    pointer-events: none;
    z-index: 0;
  }

  /* -------------------------------------------------------------------------
     GRID PRINCIPAL DE CONTACTO (2 Columnas)
     ------------------------------------------------------------------------- */
  .cta-stage-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  @media (min-width: 960px) {
    .cta-stage-grid {
      grid-template-columns: 0.95fr 1.15fr;
    }
  }

  /* -------------------------------------------------------------------------
     COLUMNA IZQUIERDA: MARCA + DECLARACIÓN EDITORIAL
     ------------------------------------------------------------------------- */
  .cta-stage-left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Logo Vectorial TapNova */
  .brand-wordmark-wrap {
    width: clamp(13.5rem, 19vw, 17.5rem);
    line-height: 0;
  }

  .brand-vector-svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.5));
  }

  /* Declaración Editorial */
  .brand-editorial-block {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .editorial-heading {
    font-size: clamp(1.85rem, 3.2vw, 2.65rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #ffffff;
    margin: 0;
    text-wrap: balance;
  }

  .gradient-text {
    background: linear-gradient(135deg, #feed7a 0%, #ff9d24 50%, #df91f7 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .editorial-sub {
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
    max-width: 440px;
    text-wrap: pretty;
  }

  /* Línea Directa WhatsApp */
  .hotline-pill-wrapper {
    padding-top: 0.5rem;
  }

  .hotline-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 1.1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    color: #e4e4e7;
    font-size: 0.8125rem;
    font-family: var(--font-inter);
    text-decoration: none;
    transition: all 0.25s var(--ease-default);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .hotline-pill:hover {
    background: rgba(37, 211, 102, 0.08);
    border-color: rgba(37, 211, 102, 0.35);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.15);
  }

  .pulse-laser-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 8px #25d366;
    flex-shrink: 0;
    animation: laserPulseDot 2s infinite ease-in-out;
  }

  @keyframes laserPulseDot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.6; }
  }

  .hotline-arrow {
    color: #25d366;
    font-size: 0.85rem;
    transition: transform 0.2s ease;
  }

  .hotline-pill:hover .hotline-arrow {
    transform: translate(2px, -2px);
  }

  /* -------------------------------------------------------------------------
     COLUMNA DERECHA: FORMULARIO DE ALTA PRECISIÓN
     ------------------------------------------------------------------------- */
  .cta-stage-right {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .form-title-group {
    margin-bottom: 1.6rem;
  }

  .chamber-headline {
    font-size: clamp(1.5rem, 2.4vw, 2.05rem);
    font-weight: 500;
    color: #ffffff;
    margin: 0 0 0.4rem 0;
    letter-spacing: -0.025em;
  }

  .chamber-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .precision-contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  /* Grid 2x2 de Campos */
  .inputs-matrix {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .inputs-matrix {
      grid-template-columns: 1fr 1fr;
    }
  }

  .matrix-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .matrix-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #d4d4d8;
    font-family: var(--font-inter);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .field-asterisk {
    color: var(--accent-orange);
  }

  .matrix-input-wrap {
    position: relative;
    width: 100%;
  }

  .matrix-input {
    width: 100%;
    height: 48px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 0 1rem;
    color: #ffffff;
    font-size: 0.9rem;
    font-family: var(--font-inter);
    outline: none;
    box-sizing: border-box;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: 
      border-color 0.25s cubic-bezier(0.32, 0.72, 0, 1),
      background 0.25s cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 0.25s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .matrix-input::placeholder {
    color: rgba(255, 255, 255, 0.28);
    font-size: 0.85rem;
  }

  .matrix-input:focus {
    border-color: var(--accent-amber);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 
      0 0 18px rgba(255, 157, 36, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* -------------------------------------------------------------------------
     KINETIC BUTTON-IN-BUTTON CTA ARCHITECTURE
     ------------------------------------------------------------------------- */
  .cta-button-enclosure {
    margin-top: 0.25rem;
  }

  .kinetic-cta-btn {
    width: 100%;
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.65rem 0.5rem 1.65rem;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius-pill);
    color: #050508;
    font-size: 0.95rem;
    font-family: var(--font-inter);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 
      0 8px 24px rgba(255, 255, 255, 0.14),
      0 2px 6px rgba(0, 0, 0, 0.4);
    transition: 
      transform 0.2s cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 0.2s cubic-bezier(0.32, 0.72, 0, 1),
      background 0.2s ease;
    outline: none;
  }

  .kinetic-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 
      0 12px 32px rgba(255, 255, 255, 0.24),
      0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .kinetic-cta-btn:active {
    transform: scale(0.98);
  }

  .btn-text-label {
    letter-spacing: -0.01em;
  }

  /* Button-in-Button Disc */
  .btn-trailing-disc {
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 50%;
    background: #050508;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    transition: transform 0.25s cubic-bezier(0.32, 0.72, 0, 1);
    flex-shrink: 0;
  }

  .kinetic-cta-btn:hover .btn-trailing-disc {
    transform: translateX(3px);
  }

  /* Security / Trust Footnote */
  .chamber-security-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    flex-wrap: wrap;
  }

  .dot-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  /* Feedback de Éxito */
  .precision-success-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    background: rgba(37, 211, 102, 0.09);
    border: 1px solid rgba(37, 211, 102, 0.32);
    animation: successFadeUp 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .success-icon-disc {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #25d366;
    color: #050508;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .success-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .success-heading {
    color: #ffffff;
    font-size: 0.88rem;
  }

  .success-desc {
    color: #a1a1aa;
    font-size: 0.82rem;
    margin: 0;
    line-height: 1.45;
  }

  @keyframes successFadeUp {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* -------------------------------------------------------------------------
     ADAPTACIONES MÓVILES (< 768px)
     ------------------------------------------------------------------------- */
  @media (max-width: 767px) {
    .cta-stage-grid {
      gap: 1.75rem;
    }

    .cta-stage-left {
      gap: 0.85rem;
    }

    .brand-wordmark-wrap {
      width: clamp(10.5rem, 44vw, 13rem);
    }

    .editorial-heading {
      font-size: clamp(1.45rem, 5.2vw, 1.85rem);
      line-height: 1.2;
    }

    /* En móvil: experiencia ultra limpia, solo mini CTA y formulario */
    .editorial-sub,
    .hotline-pill-wrapper,
    .form-title-group {
      display: none;
    }

    .precision-contact-form {
      gap: 1rem;
    }

    .kinetic-cta-btn {
      min-height: 50px;
    }
  }
</style>

<script>
  function initPrecisionContact() {
    const form = document.getElementById('precision-contact-form') as HTMLFormElement | null;
    const banner = document.getElementById('precision-success-banner');

    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const nombre = (document.getElementById('field-nombre') as HTMLInputElement)?.value.trim() || '';
      const restaurante = (document.getElementById('field-restaurante') as HTMLInputElement)?.value.trim() || '';
      const telefono = (document.getElementById('field-telefono') as HTMLInputElement)?.value.trim() || '';
      const email = (document.getElementById('field-email') as HTMLInputElement)?.value.trim() || '';

      if (!nombre || !restaurante || !telefono || !email) return;

      if (banner) banner.hidden = false;
      const btn = document.getElementById('precision-submit-btn') as HTMLButtonElement | null;
      if (btn) btn.disabled = true;

      // Generar enlace directo de WhatsApp con los datos formateados
      const text = `Hola TapNova, soy ${nombre} de ${restaurante}. Solicito propuesta a medida para mi restaurante. Tel: ${telefono}, Email: ${email}.`;
      const waUrl = `https://wa.me/34600000000?text=${encodeURIComponent(text)}`;
      window.open(waUrl, '_blank');
    });
  }

  initPrecisionContact();
  document.addEventListener('astro:page-load', initPrecisionContact);
</script>
