---
import { Image } from 'astro:assets';
import ctaSymbolImg from '../assets/products/cta-symbol.webp';
import { SITE_METADATA } from '../data/siteData';
---

<section class="final-cta-section" id="contacto" aria-label="Contacto con el equipo de TapNova">
  <!-- Subtle Atmospheric Halo -->
  <div class="cta-atmospheric-halo" aria-hidden="true"></div>

  <div class="section-container">
    <div class="zone-card-shell final-cta-card">
      
      <!-- Left: Sculptural 3D Emblem with Calm Breathing Aura -->
      <div class="cta-visual-stage">
        <div class="symbol-halo-back" aria-hidden="true"></div>
        <div class="symbol-floater">
          <Image 
            src={ctaSymbolImg} 
            alt="Emblema escultórico TapNova"
            width={480}
            height={480}
            quality={92}
            class="cta-symbol-image"
          />
        </div>
      </div>

      <!-- Right: Quiet Luxury Statement & Effortless Contact -->
      <div class="cta-content-column">
        <h2 class="cta-heading font-display">
          Tu sala cuida cada detalle.<br/>
          Tu reputación en Google también debería.
        </h2>

        <p class="cta-description">
          Diseñamos y grabamos cada soporte para integrarse con la categoría y el interiorismo de tu espacio. Hablemos de tu restaurante sin compromisos ni presiones comerciales.
        </p>

        <!-- Minimalist Single-Line Contact Form -->
        <form class="cta-quiet-form" id="quiet-contact-form">
          <div class="quiet-input-container">
            <input 
              type="text" 
              name="contact_info"
              id="quiet-input-field"
              placeholder="Nombre de tu local, email o teléfono..." 
              required 
              aria-label="Nombre de tu local, email o teléfono"
              class="quiet-input"
            />
            <button type="submit" class="btn-solid-white quiet-submit-btn">
              <span>Iniciar conversación</span>
              <span class="btn-icon" aria-hidden="true">→</span>
            </button>
          </div>

          <!-- Gentle Feedback Message -->
          <div class="quiet-feedback-msg" id="quiet-feedback-msg" aria-live="polite" hidden>
            <span class="feedback-icon">✓</span>
            <span>Mensaje recibido. Un especialista de sala contactará contigo con total discreción.</span>
          </div>
        </form>

        <!-- Direct Discreet Channels -->
        <div class="cta-discreet-footer">
          <span class="footer-hint">¿Prefieres escribir directamente?</span>
          <div class="footer-links">
            <a 
              href="https://wa.me/34600000000?text=Hola%20TapNova%2C%20me%20gustar%C3%ADa%20hablar%20con%20vosotros%20sobre%20mi%20restaurante" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="discreet-link whatsapp-link"
            >
              <span class="wa-dot" aria-hidden="true">💬</span>
              <span>WhatsApp directo</span>
            </a>
            <span class="discreet-sep" aria-hidden="true">·</span>
            <a href={`mailto:${SITE_METADATA.email}`} class="discreet-link">
              <span>{SITE_METADATA.email}</span>
            </a>
            <span class="discreet-sep" aria-hidden="true">·</span>
            <span class="discreet-address">Madrid, España</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding-top: clamp(4.5rem, 8vw, 8.5rem);
    padding-bottom: clamp(5rem, 9vw, 9.5rem);
    background: transparent;
    overflow: hidden;
  }

  /* Subtle Deep Space Ambient Glow */
  .cta-atmospheric-halo {
    position: absolute;
    bottom: -20%;
    left: 20%;
    width: clamp(500px, 60vw, 850px);
    height: clamp(400px, 45vw, 650px);
    background: radial-gradient(circle, rgba(255, 157, 36, 0.16) 0%, rgba(223, 145, 247, 0.1) 50%, transparent 70%);
    filter: blur(90px);
    pointer-events: none;
  }

  /* Double-Bezel Card Shell (Matching ProductShowcase & PricingSection) */
  .final-cta-card {
    position: relative;
    background: rgba(12, 12, 16, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: clamp(1.75rem, 3vw, 2.5rem);
    padding: clamp(2.5rem, 5vw, 5rem);
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.65), inset 0 1px 1px rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    z-index: 2;
  }

  @media (min-width: 992px) {
    .final-cta-card {
      grid-template-columns: 0.9fr 1.3fr;
    }
  }

  /* Left: 3D Emblem Stage */
  .cta-visual-stage {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 420px;
    margin: 0 auto;
  }

  .symbol-halo-back {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 157, 36, 0.25) 0%, rgba(223, 145, 247, 0.18) 45%, transparent 70%);
    filter: blur(45px);
    pointer-events: none;
  }

  .symbol-floater {
    position: relative;
    width: 90%;
    height: 90%;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: ctaLogoFloat 8s ease-in-out infinite alternate;
  }

  .cta-symbol-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.85));
  }

  @keyframes ctaLogoFloat {
    0% {
      transform: translateY(-5px) rotate(-0.75deg);
    }
    100% {
      transform: translateY(5px) rotate(1deg);
    }
  }

  /* Right: Editorial Column */
  .cta-content-column {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .cta-eyebrow-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 157, 36, 0.08);
    border: 1px solid rgba(255, 157, 36, 0.22);
    width: fit-content;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-amber);
    box-shadow: 0 0 8px var(--accent-amber);
  }

  .badge-text {
    color: var(--accent-amber);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cta-heading {
    font-size: clamp(2.2rem, 3.8vw, 3.5rem);
    line-height: 1.14;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .cta-description {
    font-size: clamp(1.02rem, 1.25vw, 1.18rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 580px;
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------------------
     Quiet Luxury Integrated Input Bar
     ------------------------------------------------------------------------- */
  .cta-quiet-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  .quiet-input-container {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 0.35rem;
    transition: border-color 0.25s var(--ease-default), background 0.25s var(--ease-default);
  }

  @media (min-width: 640px) {
    .quiet-input-container {
      flex-direction: row;
      align-items: center;
      padding: 0.4rem 0.45rem 0.4rem 1.25rem;
    }
  }

  .quiet-input-container:focus-within {
    border-color: rgba(255, 157, 36, 0.45);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 20px rgba(255, 157, 36, 0.15);
  }

  .quiet-input {
    width: 100%;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    padding: 0.65rem 0.85rem;
  }

  .quiet-input::placeholder {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .quiet-submit-btn {
    white-space: nowrap;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Gentle Feedback */
  .quiet-feedback-msg {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: rgba(37, 211, 102, 0.08);
    border: 1px solid rgba(37, 211, 102, 0.25);
    color: #25d366;
    font-size: 0.84rem;
  }

  .feedback-icon {
    font-weight: bold;
  }

  /* Discreet Footer Line */
  .cta-discreet-footer {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 0.35rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }

  .discreet-link {
    color: var(--text-secondary);
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .discreet-link:hover {
    color: #ffffff;
  }

  .whatsapp-link {
    color: #25d366;
    font-weight: 500;
  }

  .whatsapp-link:hover {
    color: #40ea85;
  }

  .discreet-sep {
    color: rgba(255, 255, 255, 0.15);
  }

  .discreet-address {
    color: var(--text-muted);
  }

  /* Mobile Adaptations (< 768px) */
  @media (max-width: 767px) {
    .final-cta-card {
      padding: 1.75rem 1.35rem;
      border-radius: var(--radius-lg);
      gap: 2rem;
    }

    .cta-visual-stage {
      max-width: 240px;
    }

    .cta-heading {
      font-size: clamp(1.8rem, 6vw, 2.25rem);
    }

    .quiet-input-container {
      border-radius: var(--radius-lg);
      padding: 0.75rem;
    }

    .quiet-input {
      padding: 0.35rem 0.5rem;
    }

    .quiet-submit-btn {
      width: 100%;
    }

    .footer-links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }

    .discreet-sep {
      display: none;
    }
  }
</style>

<script>
  function initQuietContact() {
    const form = document.getElementById('quiet-contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('quiet-feedback-msg');
    if (!form || form.dataset.initialized) return;
    form.dataset.initialized = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const input = document.getElementById('quiet-input-field') as HTMLInputElement | null;
      const val = input?.value.trim() || '';

      if (feedback) {
        feedback.hidden = false;
        form.querySelector<HTMLButtonElement>('.quiet-submit-btn')?.setAttribute('disabled', 'true');
      }

      // Smoothly opens direct WhatsApp with the user's reference
      const waUrl = `https://wa.me/34600000000?text=${encodeURIComponent(
        `Hola TapNova, me pongo en contacto desde mi restaurante (${val}) para hablar sobre vuestros soportes de sala.`
      )}`;

      window.open(waUrl, '_blank');
    });
  }

  initQuietContact();
  document.addEventListener('astro:page-load', initQuietContact);
</script>
