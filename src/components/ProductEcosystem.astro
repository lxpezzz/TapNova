---
import ArrowRight from './ArrowRight.astro';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = "", id = "hero-ecosystem-stage" } = Astro.props;
const ecosystemHeaderId = `${id}-header`;
---

<div
  class={`ecosystem-stage-container ${className}`}
  id={id}
  aria-label="Puntos de contacto TapNova"
>
  <!-- Atmospheric cosmic glow centered behind text -->
  <div class="eco-ambient-glow" aria-hidden="true"></div>

  <div class="ecosystem-header" id={ecosystemHeaderId}>
    <h2 class="eco-headline font-display">
      TapNova, en cada punto de contacto.
    </h2>
    <p class="eco-sub">
      Diferentes formatos. Un mismo objetivo: hacer que dejar una reseña sea
      fácil, rápido y natural.
    </p>
    <div class="eco-cta-wrap">
      <a href="/productos" class="eco-cta-btn">
        <span>Ver todos los productos</span>
        <span class="eco-cta-icon" aria-hidden="true"><ArrowRight /></span>
      </a>
    </div>
  </div>
</div>

<style>
  /* =========================================================================
     DESKTOP STYLES (>= 1024px)
     ========================================================================= */
  @media (min-width: 1024px) {
    .ecosystem-stage-container {
      position: absolute;
      inset: 0;
      pointer-events: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 25;
      opacity: 0;
      will-change: opacity;
    }

    .eco-ambient-glow {
      display: none; /* Desktop uses hero-ambient-canvas from HeroTapNova */
    }

    .ecosystem-header {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      max-width: 960px;
      width: calc(100% - 2rem);
      padding: 0 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.35rem;
      z-index: 25;
      opacity: 0;
      pointer-events: auto;
      will-change: transform, opacity;
    }

    .eco-headline {
      font-size: clamp(2.7rem, 4.4vw, 4.2rem);
      font-weight: 500;
      line-height: 1.1;
      color: #ffffff;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }

    .eco-sub {
      font-size: clamp(1.05rem, 1.35vw, 1.25rem);
      line-height: 1.62;
      color: var(--text-secondary);
      max-width: 660px;
      margin: 0 auto;
      text-wrap: balance;
    }
  }

  /* =========================================================================
     MOBILE / TABLET STYLES (< 1024px)
     Matches desktop's editorial elegance, typography and cosmic atmosphere
     ========================================================================= */
  @media (max-width: 1023px) {
    .ecosystem-stage-container {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 1;
      pointer-events: auto;
      padding: clamp(3rem, 6vh, 4.5rem) 1rem;
      box-sizing: border-box;
      overflow: visible;
    }

    .eco-ambient-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: clamp(320px, 85vw, 550px);
      height: clamp(260px, 70vw, 420px);
      background: radial-gradient(
        circle,
        rgba(255, 157, 36, 0.12) 0%,
        rgba(223, 145, 247, 0.06) 45%,
        transparent 72%
      );
      filter: blur(65px);
      pointer-events: none;
      z-index: 1;
    }

    .ecosystem-header {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      text-align: center;
      width: 100%;
      max-width: 600px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      z-index: 2;
      opacity: 1;
      pointer-events: auto;
    }

    .eco-headline {
      font-size: clamp(2rem, 7vw, 2.85rem);
      font-weight: 500;
      line-height: 1.15;
      color: #ffffff;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }

    .eco-sub {
      font-size: clamp(1rem, 3.8vw, 1.15rem);
      line-height: 1.6;
      color: var(--text-secondary);
      max-width: 540px;
      margin: 0 auto;
      text-wrap: balance;
    }
  }

  /* =========================================================================
     SHARED CTA BUTTON STYLES (Transparent glass button)
     ========================================================================= */
  .eco-cta-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 0.5rem;
    pointer-events: auto;
  }

  .eco-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.78rem 1.45rem;
    padding-right: 0.75rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--radius-pill, 9999px);
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    pointer-events: auto;
    min-height: 48px;
    box-sizing: border-box;
    transition:
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eco-cta-btn:hover {
    border-color: rgba(255, 255, 255, 0.65);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  .eco-cta-btn:active {
    transform: scale(0.97);
  }

  .eco-cta-btn .eco-cta-icon {
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    color: #ffffff;
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .eco-cta-btn:hover .eco-cta-icon {
    transform: translateX(2px);
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .eco-cta-btn:focus-visible {
    outline: 2px solid var(--accent-amber);
    outline-offset: 3px;
  }

  @media (max-width: 480px) {
    .eco-cta-btn {
      gap: 0.75rem;
      padding: 0.75rem 1.25rem;
      padding-right: 0.65rem;
      font-size: 0.92rem;
    }
  }
</style>
