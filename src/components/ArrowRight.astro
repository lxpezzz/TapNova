---
interface Props {
  direction?: 'right' | 'left' | 'up' | 'down' | 'up-right';
  class?: string;
  label?: string;
}

const { direction = 'right', class: className = '', label } = Astro.props;
const rotation = {
  right: '0deg',
  left: '180deg',
  up: '-90deg',
  down: '90deg',
  'up-right': '-45deg'
}[direction];
---

<span class={className} aria-hidden={label ? undefined : 'true'} aria-label={label}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-arrow-right"
    style={`transform: rotate(${rotation});`}
  >
    <path d="M5 12h14" />
    <path d="m12 5 7 7-7 7" />
  </svg>
</span>

<style>
  span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  svg {
    display: block;
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
  }
</style>
