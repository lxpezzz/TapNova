---
import { Image } from 'astro:assets';
import supernovaTexture from '../assets/showcase/tapnova-supernova.png';

interface Props {
  class?: string;
  id?: string;
}

const { class: className = '', id = 'hero-organic-halo' } = Astro.props;
---

<div class={`organic-halo-container ${className}`} id={id} aria-hidden="true">
  <div class="supernova-aura"></div>
  <div class="supernova-motion">
    <Image
      src={supernovaTexture}
      alt=""
      width={1280}
      height={1280}
      quality={82}
      loading="eager"
      decoding="async"
      class="supernova-shell"
    />
  </div>
  <div class="supernova-core-diffusion"></div>
</div>

<style>
  .organic-halo-container {
    position: absolute;
    width: clamp(620px, 68vw, 1040px);
    height: clamp(520px, 68vw, 1040px);
    pointer-events: none;
    user-select: none;
    transform-origin: center center;
    will-change: transform, opacity;
    z-index: 1;
  }

  .supernova-aura {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(44, 56, 170, 0.1) 0%,
      rgba(223, 145, 247, 0.08) 44%,
      rgba(255, 132, 0, 0.08) 67%,
      transparent 76%
    );
    filter: blur(26px);
    opacity: 0.5;
    transform: scale(0.96);
    animation: supernovaAura 24s ease-in-out infinite alternate;
  }

  .supernova-shell {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.38;
    filter: saturate(0.78) brightness(0.82);
    transform-origin: center center;
    animation: supernovaDrift 300s linear infinite;
  }

  .supernova-motion {
    position: absolute;
    inset: 0;
    transform-origin: center center;
    animation: supernovaBreath 26s ease-in-out infinite alternate;
  }

  .supernova-core-diffusion {
    position: absolute;
    inset: 21%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(2, 2, 4, 0.1) 0%, transparent 68%);
    pointer-events: none;
  }

  @keyframes supernovaDrift {
    0% {
      transform: rotate(0deg);
      opacity: 0.34;
    }
    100% {
      transform: rotate(360deg);
      opacity: 0.34;
      opacity: 0.43;
    }
  }

  @keyframes supernovaAura {
    from {
      transform: translate(-1%, 0.8%) scale(0.92);
      opacity: 0.34;
    }
    to {
      transform: translate(1%, -0.8%) scale(1.07);
      opacity: 0.56;
    }
  }

  @keyframes supernovaBreath {
    from {
      transform: scale(0.985);
    }
    to {
      transform: scale(1.015);
    }
  }

  @media (max-width: 1023px) {
    .organic-halo-container {
      width: min(115vw, 520px);
      height: min(115vw, 520px);
      aspect-ratio: 1;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    .supernova-shell {
      opacity: 0.32;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .supernova-aura,
    .supernova-motion,
    .supernova-shell {
      animation: none;
    }
  }
</style>
