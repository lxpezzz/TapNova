---
// FinalCTA.astro - TapNova
// CTA final de la home reconstruido como escena fotográfica inmersiva full-bleed
// - Fondo fotográfico a sangre de escena de cierre nocturno en restaurante con luz de velas
// - Posavasos de cuero, copa de autor y portacuentas integrados en la mesa
// - Overlay oscuro cálido (marrón/café espresso) que garantiza legibilidad preservando la riqueza visual
// - Composición editorial centrada que funciona como broche de oro de la web
// - Altura de 580px–680px en desktop
---

<section
  class="relative w-full min-h-[560px] sm:min-h-[620px] md:min-h-[680px] overflow-hidden flex items-center justify-center py-20 sm:py-28 md:py-32 px-5 sm:px-8 select-none"
  aria-label="Cierre y contacto TapNova"
>
  <!-- ========================================================================= -->
  <!-- 1. FOTOGRAFÍA FULL-WIDTH DE FONDO (ESCENA NOCTURNA HORECA) -->
  <!-- ========================================================================= -->
  <picture
    class="absolute inset-0 w-full h-full select-none pointer-events-none"
  >
    <source srcset="/images/cta/final-cta-background.webp" type="image/webp" />
    <img
      src="/images/cta/final-cta-background.webp"
      alt="Ambiente nocturno de restaurante premium con posavasos artesanal y portacuentas de cuero TapNova"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-[center_65%] sm:object-center scale-[1.02] transition-transform duration-1000 ease-out"
    />
  </picture>

  <!-- ========================================================================= -->
  <!-- 2. OVERLAY OSCURO CÁLIDO (MARRÓN/CAFÉ ESPRESSO, NO NEGRO PLANO) -->
  <!-- ========================================================================= -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-[#18110D]/85 via-[#18110D]/75 to-[#18110D]/90 pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div
    class="absolute inset-0 bg-[#140D0A]/30 pointer-events-none"
    aria-hidden="true"
  >
  </div>

  <!-- ========================================================================= -->
  <!-- 3. CONTENIDO EDITORIAL DE CIERRE (CENTRADO, CON MUCHO AIRE) -->
  <!-- ========================================================================= -->
  <div
    class="relative z-10 w-full max-w-[760px] mx-auto text-center flex flex-col items-center"
  >
    <!-- Eyebrow -->
    <p
      class="text-[11px] sm:text-[12px] font-semibold tracking-[0.26em] text-[#C7BCB2] uppercase mb-4 sm:mb-5"
    >
      TAPNOVA · HORECA
    </p>

    <!-- Headline grande y con presencia en 2 líneas -->
    <h2
      class="text-[#F4F0E8] font-light text-[34px] sm:text-[46px] md:text-[56px] lg:text-[62px] tracking-[-0.03em] leading-[1.06] text-balance mb-4 sm:mb-5"
    >
      Haz que cada punto<br class="hidden sm:inline" /> de tu local conecte.
    </h2>

    <!-- Subcopy breve y reflexivo -->
    <p
      class="text-[#D8CEBF] text-[15px] sm:text-[17px] md:text-[18px] leading-relaxed max-w-[580px] font-light mb-8 sm:mb-10 text-balance"
    >
      Productos físicos, QR, NFC y soluciones digitales pensadas para convertir momentos cotidianos en oportunidades para tu negocio.
    </p>

    <!-- CTAs integrados -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 w-full sm:w-auto"
    >
      <!-- CTA Principal: píldora en blanco roto con texto oscuro -->
      <a
        href="/productos"
        class="w-full sm:w-auto inline-flex items-center justify-center bg-[#FAF8F5] hover:bg-white text-[#1C1613] text-[12.5px] sm:text-[13px] font-medium tracking-[0.16em] uppercase px-8 py-3.5 rounded-full transition-all duration-200 active:scale-[0.98] shadow-[0_4px_24px_rgba(0,0,0,0.4)]"
      >
        Ver productos
      </a>

      <!-- CTA Secundario: enlace tipográfico sutil con flecha -->
      <a
        href="#contacto"
        class="group inline-flex items-center gap-2 text-[#F4F0E8]/85 hover:text-white text-[12.5px] sm:text-[13px] font-normal tracking-[0.16em] uppercase transition-colors duration-200 py-3 px-3"
      >
        <span>Hablar con TapNova</span>
        <span
          class="inline-block transition-transform duration-200 group-hover:translate-x-1"
          aria-hidden="true">→</span
        >
      </a>
    </div>
  </div>
</section>
