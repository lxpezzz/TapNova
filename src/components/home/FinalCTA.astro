---
// FinalCTA.astro - TapNova
// CTA final de la home con formulario de contacto integrado en la misma escena fotográfica
// - Fondo fotográfico a sangre (restaurante premium nocturno con posavasos y portacuentas)
// - Overlay oscuro cálido (marrón café espresso) con gradiente reforzado en la zona de formulario
// - Desktop: composición 2 columnas (~45% izquierda copy + CTA / ~55% derecha formulario editorial)
// - Mobile: columna única compacta con formulario siempre visible (sin modal ni drawer)
// - Integración Web3Forms con fetch asíncrono, honeypot y estados de carga/éxito/error

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<section
  id="contacto"
  class="relative w-full min-h-[640px] lg:min-h-[680px] overflow-hidden flex items-center py-16 sm:py-20 lg:py-24 px-5 sm:px-8 md:px-12 lg:px-16"
  aria-label="Contacto y cierre TapNova"
>
  <!-- ========================================================================= -->
  <!-- 1. FOTOGRAFÍA FULL-WIDTH DE FONDO (ESCENA NOCTURNA HORECA) -->
  <!-- ========================================================================= -->
  <picture class="absolute inset-0 w-full h-full select-none pointer-events-none">
    <source srcset="/images/cta/contact-background.webp" type="image/webp" />
    <source srcset="/images/cta/final-cta-background.webp" type="image/webp" />
    <img
      src="/images/cta/contact-background.webp"
      alt="Ambiente nocturno de restaurante premium con posavasos artesanal y portacuentas de cuero TapNova"
      loading="lazy"
      decoding="async"
      class="w-full h-full object-cover object-[center_65%] sm:object-center scale-[1.02] transition-transform duration-1000 ease-out"
    />
  </picture>

  <!-- ========================================================================= -->
  <!-- 2. OVERLAY OSCURO CÁLIDO MULTICAPA (LEGIBILIDAD Y PROFUNDIDAD) -->
  <!-- ========================================================================= -->
  <!-- Base cálida en toda la escena -->
  <div
    class="absolute inset-0 bg-[#140D0A]/75 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Gradiente horizontal en desktop: refuerzo en la columna derecha para el formulario -->
  <div
    class="absolute inset-0 bg-gradient-to-b lg:bg-gradient-to-r from-[#18110D]/90 via-[#18110D]/80 to-[#120B08]/95 pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- ========================================================================= -->
  <!-- 3. CONTENIDO PRINCIPAL: 2 COLUMNAS EN DESKTOP / 1 COLUMNA EN MÓVIL -->
  <!-- ========================================================================= -->
  <div class="relative z-10 w-full max-w-[1240px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 xl:gap-20 items-center">
      
      <!-- --------------------------------------------------------------------- -->
      <!-- COLUMNA IZQUIERDA (~45% / 5 columnas): CIERRE COMERCIAL EDITORIAL -->
      <!-- --------------------------------------------------------------------- -->
      <div class="lg:col-span-5 flex flex-col items-start text-left">
        <!-- Eyebrow -->
        <p class="text-[11px] sm:text-[12px] font-semibold tracking-[0.26em] text-[#C7BCB2] uppercase mb-4 sm:mb-5">
          TAPNOVA · HORECA
        </p>

        <!-- Headline -->
        <h2 class="text-[#F4F0E8] font-light text-[32px] sm:text-[42px] md:text-[46px] lg:text-[50px] tracking-[-0.03em] leading-[1.08] text-balance mb-4 sm:mb-6">
          Haz que cada punto<br class="hidden sm:inline" /> de tu local conecte.
        </h2>

        <!-- Subcopy -->
        <p class="text-[#D8CEBF] text-[15px] sm:text-[16px] md:text-[17px] leading-relaxed max-w-[480px] font-light mb-8 sm:mb-10 text-balance">
          Productos físicos, QR, NFC y soluciones digitales pensadas para convertir momentos cotidianos en oportunidades para tu negocio.
        </p>

        <!-- CTA Principal: Ver productos -->
        <a
          href="/productos"
          class="inline-flex items-center justify-center bg-[#FAF8F5] hover:bg-white text-[#1C1613] text-[12px] sm:text-[12.5px] font-medium tracking-[0.16em] uppercase px-8 py-3.5 rounded-full transition-all duration-200 active:scale-[0.98] shadow-[0_4px_24px_rgba(0,0,0,0.35)]"
        >
          Ver productos
        </a>
      </div>

      <!-- --------------------------------------------------------------------- -->
      <!-- COLUMNA DERECHA (~55% / 7 columnas): FORMULARIO DE CONTACTO EDITORIAL -->
      <!-- --------------------------------------------------------------------- -->
      <div class="lg:col-span-7 w-full">
        <div class="bg-[#18110D]/60 backdrop-blur-md border border-white/[0.08] rounded-2xl p-6 sm:p-8 md:p-10 lg:p-10 shadow-[0_12px_40px_rgba(0,0,0,0.45)]">
          
          <!-- Encabezado del Formulario -->
          <div class="mb-6 sm:mb-8">
            <span class="text-[10.5px] sm:text-[11px] font-semibold tracking-[0.24em] text-[#C7BCB2] uppercase block mb-1.5">
              HABLEMOS
            </span>
            <h3 class="text-[#F4F0E8] text-[22px] sm:text-[26px] font-light tracking-[-0.02em]">
              Cuéntanos qué necesitas.
            </h3>
          </div>

          <!-- Formulario -->
          <form
            id="home-contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            class="space-y-5 sm:space-y-6"
            novalidate
          >
            <!-- Web3Forms Configuración Oculta -->
            <input type="hidden" name="access_key" value={web3formsKey} />
            <input type="hidden" name="subject" value="Nuevo contacto desde TapNova Web" />
            <input type="hidden" name="from_name" value="TapNova Web" />
            
            <!-- Honeypot anti-spam (oculto) -->
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display: none;"
              tabindex="-1"
              autocomplete="off"
            />

            <!-- Fila 1: Nombre + Restaurante/Empresa -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
              <!-- Nombre -->
              <div class="relative flex flex-col group">
                <label
                  for="form-name"
                  class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.18em] text-[#C7BCB2]/85 mb-1 transition-colors group-focus-within:text-[#F4F0E8]"
                >
                  Nombre <span class="text-[#D8CEBF]/60">*</span>
                </label>
                <input
                  type="text"
                  id="form-name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder="Tu nombre"
                  class="bg-transparent border-0 border-b border-white/20 focus:border-white/90 text-[#F4F0E8] text-[14px] sm:text-[15px] placeholder:text-white/25 focus:ring-0 px-0 py-2 transition-colors outline-none"
                />
              </div>

              <!-- Restaurante o Empresa -->
              <div class="relative flex flex-col group">
                <label
                  for="form-company"
                  class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.18em] text-[#C7BCB2]/85 mb-1 transition-colors group-focus-within:text-[#F4F0E8]"
                >
                  Restaurante o empresa
                </label>
                <input
                  type="text"
                  id="form-company"
                  name="company"
                  autocomplete="organization"
                  placeholder="Nombre de tu local"
                  class="bg-transparent border-0 border-b border-white/20 focus:border-white/90 text-[#F4F0E8] text-[14px] sm:text-[15px] placeholder:text-white/25 focus:ring-0 px-0 py-2 transition-colors outline-none"
                />
              </div>
            </div>

            <!-- Fila 2: Email + Teléfono -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
              <!-- Email -->
              <div class="relative flex flex-col group">
                <label
                  for="form-email"
                  class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.18em] text-[#C7BCB2]/85 mb-1 transition-colors group-focus-within:text-[#F4F0E8]"
                >
                  Email <span class="text-[#D8CEBF]/60">*</span>
                </label>
                <input
                  type="email"
                  id="form-email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="hola@ejemplo.com"
                  class="bg-transparent border-0 border-b border-white/20 focus:border-white/90 text-[#F4F0E8] text-[14px] sm:text-[15px] placeholder:text-white/25 focus:ring-0 px-0 py-2 transition-colors outline-none"
                />
              </div>

              <!-- Teléfono -->
              <div class="relative flex flex-col group">
                <label
                  for="form-phone"
                  class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.18em] text-[#C7BCB2]/85 mb-1 transition-colors group-focus-within:text-[#F4F0E8]"
                >
                  Teléfono
                </label>
                <input
                  type="tel"
                  id="form-phone"
                  name="phone"
                  autocomplete="tel"
                  placeholder="+34 600 000 000"
                  class="bg-transparent border-0 border-b border-white/20 focus:border-white/90 text-[#F4F0E8] text-[14px] sm:text-[15px] placeholder:text-white/25 focus:ring-0 px-0 py-2 transition-colors outline-none"
                />
              </div>
            </div>

            <!-- Fila 3: Mensaje -->
            <div class="relative flex flex-col group">
              <label
                for="form-message"
                class="text-[10px] sm:text-[11px] font-medium uppercase tracking-[0.18em] text-[#C7BCB2]/85 mb-1 transition-colors group-focus-within:text-[#F4F0E8]"
              >
                Mensaje <span class="text-[#D8CEBF]/60">*</span>
              </label>
              <textarea
                id="form-message"
                name="message"
                rows="3"
                required
                placeholder="¿En qué podemos ayudarte? Cuéntanos sobre tu espacio o proyecto..."
                class="bg-transparent border-0 border-b border-white/20 focus:border-white/90 text-[#F4F0E8] text-[14px] sm:text-[15px] placeholder:text-white/25 focus:ring-0 px-0 py-2 resize-none transition-colors outline-none"
              ></textarea>
            </div>

            <!-- Mensajes de Estado (Éxito y Error) -->
            <div id="form-status" class="hidden text-[13px] sm:text-[14px] leading-relaxed py-2 transition-all"></div>

            <!-- Botón de Envío -->
            <div class="pt-2 sm:pt-3 flex items-center justify-between flex-wrap gap-4">
              <button
                type="submit"
                id="form-submit-btn"
                class="w-full sm:w-auto inline-flex items-center justify-center bg-[#FAF8F5] hover:bg-white text-[#1C1613] text-[12px] sm:text-[12.5px] font-medium tracking-[0.16em] uppercase px-8 py-3.5 rounded-full transition-all duration-200 active:scale-[0.98] shadow-[0_4px_20px_rgba(0,0,0,0.3)] disabled:opacity-60 disabled:cursor-not-allowed"
              >
                <span id="btn-text">Enviar mensaje</span>
              </button>

              <span class="text-[11px] text-[#C7BCB2]/60 font-light">
                Respuesta en menos de 24 horas laborables.
              </span>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ========================================================================= -->
<!-- 4. SCRIPT CLIENT-SIDE: SUBMIT ASÍNCRONO CON FETCH (SIN RECARGA) -->
<!-- ========================================================================= -->
<script is:inline>
  (() => {
    const form = document.getElementById('home-contact-form');
    if (!form) return;

    const statusEl = document.getElementById('form-status');
    const submitBtn = document.getElementById('form-submit-btn');
    const btnText = document.getElementById('btn-text');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Validación nativa básica
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Estado de envío
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');
      if (btnText) btnText.textContent = 'Enviando...';
      if (statusEl) {
        statusEl.className = 'hidden';
        statusEl.textContent = '';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        const data = await response.json();

        if (response.status === 200 && (data.success || data.message)) {
          // Éxito
          form.reset();
          if (statusEl) {
            statusEl.className = 'text-[#D4EDDA] bg-emerald-950/40 border border-emerald-500/30 rounded-lg p-3 text-[13px] sm:text-[14px]';
            statusEl.textContent = 'Mensaje enviado correctamente. Gracias por contactar con TapNova. Te responderemos lo antes posible.';
          }
        } else {
          // Error devuelto por el backend
          throw new Error(data.message || 'Error en el envío');
        }
      } catch (err) {
        if (statusEl) {
          statusEl.className = 'text-[#F8D7DA] bg-rose-950/40 border border-rose-500/30 rounded-lg p-3 text-[13px] sm:text-[14px]';
          statusEl.textContent = 'No se ha podido enviar el mensaje. Por favor, inténtalo de nuevo o escríbenos a info@tapnova.es.';
        }
      } finally {
        if (submitBtn) submitBtn.removeAttribute('disabled');
        if (btnText) btnText.textContent = 'Enviar mensaje';
      }
    });
  })();
</script>
