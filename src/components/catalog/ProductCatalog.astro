---
import { CATALOG_CATEGORIES, CATALOG_PRODUCTS } from '../../data/catalogData';
import CatalogHeader from './CatalogHeader.astro';
import CatalogNavigation from './CatalogNavigation.astro';
import CatalogProductList from './CatalogProductList.astro';
import ProductSheet from './ProductSheet.astro';
import CartDrawer from './CartDrawer.astro';
import './product-catalog.css';

const productCount = CATALOG_PRODUCTS.length;
const categoryCounts = Object.fromEntries(
  CATALOG_CATEGORIES.map(({ id }) => [
    id,
    id === 'packs' ? 3 : CATALOG_PRODUCTS.filter((product) => product.categoryId === id).length
  ])
);
---

<main id="b2b-marketplace" class="b2b-marketplace-page" data-theme="light">
  <!-- Atmósfera cósmica bipolar (Naranja Solar + Orquídea Violeta) y Canvas de partículas vivas -->
  <div class="catalog-atmospheric-overlay" aria-hidden="true">
    <div class="bipolar-aurora-chamber">
      <div class="bipolar-gas gas-orange-flame"></div>
      <div class="bipolar-gas gas-purple-orchid"></div>
      <div class="bipolar-gas gas-amber-nursery"></div>
      <div class="bipolar-gas gas-magenta-filament"></div>
    </div>
    <canvas class="catalog-stardust-canvas" id="catalog-stardust-canvas"></canvas>
  </div>

  <CatalogHeader totalProducts={productCount} />
  <CatalogNavigation variant="mobile" categories={CATALOG_CATEGORIES} counts={categoryCounts} totalProducts={productCount} />

  <div class="marketplace-editorial-container">
    <div class="section-container wide-layout">
      <div class="catalog-grid-layout">
        <CatalogNavigation variant="sidebar" categories={CATALOG_CATEGORIES} counts={categoryCounts} totalProducts={productCount} />
        <CatalogProductList />
      </div>
    </div>
  </div>

  <!-- Transición fluida y orgánica hacia el footer cósmico oscuro de TapNova -->
  <div class="catalog-to-footer-transition" aria-hidden="true">
    <div class="transition-horizon-glow"></div>
    <div class="transition-horizon-line"></div>
  </div>

  <CartDrawer />
  <ProductSheet />
</main>

<script>
  import './product-catalog';

  // Motor de partículas cósmicas vivas interactivo para el catálogo (equivalente al de la Home)
  (() => {
    const canvas = document.getElementById('catalog-stardust-canvas') as HTMLCanvasElement | null;
    const container = document.getElementById('b2b-marketplace');
    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reducedMotionQuery.matches) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let animId = 0;
    let isVisible = true;

    let targetX = 0;
    let targetY = 0;
    let currentX = 0;
    let currentY = 0;

    // Paleta cósmica viva adaptada: naranja solar, orquídea púrpura, oro cósmico, magenta y polvo carbón suave
    const STAR_COLORS = [
      'rgba(235, 115, 0, ',    // Naranja Solar Vibrante
      'rgba(168, 85, 247, ',   // Orquídea / Púrpura Cósmico
      'rgba(217, 119, 6, ',    // Ámbar Dorado
      'rgba(192, 38, 211, ',   // Magenta Cósmico
      'rgba(80, 72, 65, ',     // Polvo Estelar Grafito Neutro
    ];

    interface CatalogStar {
      x: number;
      y: number;
      baseRadius: number;
      colorIndex: number;
      baseAlpha: number;
      speedX: number;
      speedY: number;
      twinklePhase: number;
      twinkleSpeed: number;
      depth: number;
    }

    const STAR_COUNT = 70;
    const stars: CatalogStar[] = [];

    function initStars() {
      stars.length = 0;
      for (let i = 0; i < STAR_COUNT; i++) {
        stars.push({
          x: Math.random() * width,
          y: Math.random() * height,
          // Puntos limpios de constelación (puntos circulares puros, sin estrellas ni halos)
          baseRadius: Math.random() < 0.72 ? Math.random() * 0.45 + 0.65 : Math.random() * 0.5 + 1.05,
          colorIndex: Math.floor(Math.random() * STAR_COLORS.length),
          baseAlpha: Math.random() * 0.4 + 0.35,
          speedX: (Math.random() - 0.5) * 0.08,
          speedY: -Math.random() * 0.12 - 0.03, // Flotación ascendente continua
          twinklePhase: Math.random() * Math.PI * 2,
          twinkleSpeed: Math.random() * 0.02 + 0.008,
          depth: Math.random() * 0.7 + 0.3,
        });
      }
    }

    function resize() {
      if (!canvas || !container) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = container.clientWidth;
      height = container.clientHeight;

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx!.scale(dpr, dpr);

      if (stars.length === 0) {
        initStars();
      } else {
        for (const star of stars) {
          if (star.x > width) star.x = Math.random() * width;
          if (star.y > height) star.y = Math.random() * height;
        }
      }
    }

    function onPointerMove(e: MouseEvent | TouchEvent) {
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      targetX = (clientX / window.innerWidth - 0.5) * 2;
      targetY = (clientY / window.innerHeight - 0.5) * 2;
    }

    function render() {
      if (!isVisible) return;

      currentX += (targetX - currentX) * 0.035;
      currentY += (targetY - currentY) * 0.035;

      ctx!.clearRect(0, 0, width, height);

      for (let i = 0; i < stars.length; i++) {
        const star = stars[i];

        star.x += star.speedX + currentX * star.depth * 0.1;
        star.y += star.speedY + currentY * star.depth * 0.1;

        if (star.x < 0) star.x = width;
        if (star.x > width) star.x = 0;
        if (star.y < 0) star.y = height;
        if (star.y > height) star.y = 0;

        star.twinklePhase += star.twinkleSpeed;
        const twinkle = Math.sin(star.twinklePhase);
        const alpha = Math.max(0.12, Math.min(0.9, star.baseAlpha + twinkle * 0.22));

        const drawX = star.x + currentX * star.depth * 6;
        const drawY = star.y + currentY * star.depth * 6;

        // Dibuja únicamente puntos circulares puros (constelaciones), sin formas ni halos de estrella
        ctx!.fillStyle = `${STAR_COLORS[star.colorIndex]}${alpha.toFixed(3)})`;
        ctx!.beginPath();
        ctx!.arc(drawX, drawY, star.baseRadius, 0, Math.PI * 2);
        ctx!.fill();
      }

      animId = requestAnimationFrame(render);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', onPointerMove, { passive: true });
    window.addEventListener('touchmove', onPointerMove, { passive: true });

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => {
        resize();
      });
      ro.observe(container);
    }

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        cancelAnimationFrame(animId);
        animId = requestAnimationFrame(render);
      } else {
        cancelAnimationFrame(animId);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
