---
import { Image } from 'astro:assets';
import { CATALOG_CATEGORIES, CATALOG_PRODUCTS, CATALOG_PACKS } from '../../data/catalogData';
---

<div class="catalog-main-feed">
  <div id="empty-search-state" class="empty-state-card" hidden>
    <span class="empty-icon">○</span>
    <h3 class="empty-title">No se encontraron productos</h3>
    <p class="empty-desc">
      No hay resultados para este término. Prueba a buscar "titanio", "nogal", "piel" o selecciona otra categoría.
    </p>
    <button type="button" id="reset-search-btn" class="btn-solid-white">Ver todos los productos</button>
  </div>

  <div class="catalog-sections-wrap" id="catalog-sections-wrap">
    {CATALOG_CATEGORIES.map((category) => {
      const products = CATALOG_PRODUCTS.filter((product) => product.categoryId === category.id);
      if (!products.length && category.id !== 'packs') return null;

      if (category.id === 'portacuentas') {
        const basicos = products.filter((p) => p.gama === 'basicos');
        const premium = products.filter((p) => p.gama === 'premium');
        const basicosPrice = basicos[0]?.price || 49;
        const premiumPrice = premium[0]?.price || 79;

        return (
          <section class="catalog-category-section section-portacuentas portacuentas-apple-section" id={category.id} data-section-category={category.id}>
            <!-- 1. Encabezado general “Portacuentas Inteligentes” -->
            <div class="category-header-editorial portacuentas-main-header">
              <div class="cat-header-titles">
                <h2 class="cat-section-title">{category.name}</h2>
                <p class="cat-section-desc">{category.description}</p>
              </div>
            </div>

            <!-- 2. Subcategoría “BÁSICOS”, con una breve descripción y el precio de la gama mostrado una sola vez en el encabezado -->
            <div class="portacuentas-gama-block">
              <div class="gama-header-row">
                <div class="gama-header-info">
                  <h3 class="gama-title">BÁSICOS</h3>
                  <p class="gama-desc">Piel vegana hidrorepelente con grabado directo en bajo relieve y chip NFC de lectura instantánea.</p>
                </div>
                <div class="gama-price-callout">
                  <span class="gama-price-val">{basicosPrice} € <span class="gama-price-unit">/ ud</span></span>
                </div>
              </div>

              <!-- 3. Grid de productos básicos -->
              <div class="portacuentas-apple-grid">
                {basicos.map((product) => (
                  <article
                    class="portacuentas-apple-card"
                    id={`card-${product.id}`}
                    data-product-card
                    data-category-id={product.categoryId}
                    data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} ${product.tags.join(' ')}`.toLowerCase()}
                    data-product-json={JSON.stringify(product)}
                    tabindex="0"
                    role="button"
                    aria-label={`Ver producto ${product.name}`}
                  >
                    <div class="apple-card-visual">
                      <Image
                        src={product.image}
                        alt={product.imageAlt}
                        width={640}
                        height={580}
                        widths={[360, 520, 640]}
                        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 24vw"
                        format="webp"
                        quality={92}
                        loading="lazy"
                        decoding="async"
                        class="apple-card-img"
                      />
                    </div>
                    <div class="apple-card-meta">
                      <h4 class="apple-card-title">{product.name}</h4>
                      <p class="apple-card-sub">{product.subtitle}</p>
                      <span class="apple-card-cta">
                        <span>Ver producto</span>
                        <span class="cta-arrow" aria-hidden="true">→</span>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            <!-- 4. Subcategoría “PREMIUM”, con una breve descripción y el precio de la gama mostrado una sola vez en el encabezado -->
            <div class="portacuentas-gama-block portacuentas-gama-premium">
              <div class="gama-header-row">
                <div class="gama-header-info">
                  <h3 class="gama-title">PREMIUM</h3>
                  <p class="gama-desc">Materiales nobles con placa de aleación de titanio cepillado antihuellas y ensamblaje de sala.</p>
                </div>
                <div class="gama-price-callout">
                  <span class="gama-price-val">{premiumPrice} € <span class="gama-price-unit">/ ud</span></span>
                </div>
              </div>

              <!-- 5. Grid de productos premium -->
              <div class="portacuentas-apple-grid">
                {premium.map((product) => (
                  <article
                    class="portacuentas-apple-card"
                    id={`card-${product.id}`}
                    data-product-card
                    data-category-id={product.categoryId}
                    data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} ${product.tags.join(' ')}`.toLowerCase()}
                    data-product-json={JSON.stringify(product)}
                    tabindex="0"
                    role="button"
                    aria-label={`Ver producto ${product.name}`}
                  >
                    <div class="apple-card-visual">
                      <Image
                        src={product.image}
                        alt={product.imageAlt}
                        width={640}
                        height={580}
                        widths={[360, 520, 640]}
                        sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 24vw"
                        format="webp"
                        quality={92}
                        loading="lazy"
                        decoding="async"
                        class="apple-card-img"
                      />
                    </div>
                    <div class="apple-card-meta">
                      <h4 class="apple-card-title">{product.name}</h4>
                      <p class="apple-card-sub">{product.subtitle}</p>
                      <span class="apple-card-cta">
                        <span>Ver producto</span>
                        <span class="cta-arrow" aria-hidden="true">→</span>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      }

      // --- 2. SECCIÓN PORTAMENÚS PERSONALIZADOS ---
      if (category.id === 'portamenus') {
        const commonPrice = products[0]?.price || 49;

        return (
          <section class="catalog-category-section section-portamenus portamenus-apple-section" id={category.id} data-section-category={category.id}>
            <!-- Encabezado: título “Portamenús personalizados”, descripción, precio único común y “Personalización incluida” -->
            <div class="category-header-editorial portamenus-main-header">
              <div class="portamenus-header-row">
                <div class="cat-header-titles">
                  <h2 class="cat-section-title">Portamenús personalizados</h2>
                  <p class="cat-section-desc">Formatos para carta física o interactiva con NFC y QR, fabricados a medida y adaptados a la imagen de tu restaurante.</p>
                </div>
                <div class="portamenus-price-callout">
                  <span class="portamenus-price-val">{commonPrice} € <span class="portamenus-price-unit">/ ud</span></span>
                  <span class="portamenus-price-note">Personalización incluida</span>
                </div>
              </div>
            </div>

            <!-- Grid de 3 columnas iguales en desktop, 2 en tablet y 1 en móvil -->
            <div class="portamenus-trio-grid">
              {products.slice(0, 3).map((product) => (
                <article
                  class="portamenus-trio-card"
                  id={`card-${product.id}`}
                  data-product-card
                  data-category-id={product.categoryId}
                  data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} ${product.tags.join(' ')}`.toLowerCase()}
                  data-product-json={JSON.stringify(product)}
                  tabindex="0"
                  role="button"
                  aria-label={`Ver producto ${product.name}`}
                >
                  <div class="apple-card-visual portamenus-card-visual">
                    <Image
                      src={product.image}
                      alt={product.imageAlt}
                      width={680}
                      height={600}
                      widths={[360, 520, 680]}
                      sizes="(max-width: 640px) 92vw, (max-width: 1024px) 45vw, 380px"
                      format="webp"
                      quality={92}
                      loading="lazy"
                      decoding="async"
                      class="apple-card-img"
                    />
                  </div>
                  <div class="apple-card-meta portamenus-card-meta">
                    <h4 class="apple-card-title">{product.name}</h4>
                    <p class="apple-card-sub">{product.subtitle}</p>
                    <span class="apple-card-cta">
                      <span>Ver producto</span>
                      <span class="cta-arrow" aria-hidden="true">→</span>
                    </span>
                  </div>
                </article>
              ))}
            </div>
          </section>
        );
      }

      // --- 3. SECCIÓN EXPOSITORES DE BARRA & CAJA ---
      if (category.id === 'expositores') {
        const basicos = products.filter((p) => p.gama === 'basicos');
        const premium = products.filter((p) => p.gama === 'premium');
        const basicosPrice = basicos[0]?.price;
        const premiumPrice = premium[0]?.price;

        return (
          <section class="catalog-category-section section-expositores expositores-apple-section" id={category.id} data-section-category={category.id}>
            <!-- 1. Encabezado general “Expositores” -->
            <div class="category-header-editorial expositores-main-header">
              <div class="cat-header-titles">
                <h2 class="cat-section-title">Expositores</h2>
                <p class="cat-section-desc">{category.description}</p>
              </div>
            </div>

            <!-- 2. Subcategoría “BÁSICO”, con una breve descripción y el precio de la gama mostrado una sola vez en el encabezado -->
            <div class="expositores-gama-block">
              <div class="gama-header-row">
                <div class="gama-header-info">
                  <h3 class="gama-title">BÁSICO</h3>
                  <p class="gama-desc">Presencia mínima en aluminio anodizado sobre peana antideslizante para cobro ágil y mostrador TPV.</p>
                </div>
                {basicosPrice && (
                  <div class="gama-price-callout">
                    <span class="gama-price-val">{basicosPrice} € <span class="gama-price-unit">/ ud</span></span>
                  </div>
                )}
              </div>

              <!-- 3. Grid de modelos básicos -->
              <div class="expositores-apple-grid">
                {basicos.map((product) => (
                  <article
                    class="expositores-apple-card"
                    id={`card-${product.id}`}
                    data-product-card
                    data-category-id={product.categoryId}
                    data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} ${product.tags.join(' ')}`.toLowerCase()}
                    data-product-json={JSON.stringify(product)}
                    tabindex="0"
                    role="button"
                    aria-label={`Ver producto ${product.name}`}
                  >
                    <div class="apple-card-visual expositores-card-visual">
                      <Image
                        src={product.image}
                        alt={product.imageAlt}
                        width={720}
                        height={640}
                        widths={[360, 520, 720]}
                        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 70vw, 540px"
                        format="webp"
                        quality={94}
                        loading="lazy"
                        decoding="async"
                        class="apple-card-img expositores-card-img"
                      />
                    </div>
                    <div class="apple-card-meta expositores-card-meta">
                      <span class="expositor-sides-note">Disponible en 1 o 2 caras</span>
                      <h4 class="apple-card-title expositores-card-title">{product.name}</h4>
                      <p class="apple-card-sub expositores-card-sub">{product.subtitle}</p>
                      <span class="apple-card-cta">
                        <span>Ver producto</span>
                        <span class="cta-arrow" aria-hidden="true">→</span>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>

            <!-- 4. Subcategoría “PREMIUM”, con una breve descripción y el precio de la gama mostrado una sola vez en el encabezado -->
            <div class="expositores-gama-block expositores-gama-premium">
              <div class="gama-header-row">
                <div class="gama-header-info">
                  <h3 class="gama-title">PREMIUM</h3>
                  <p class="gama-desc">Mecanizado artesanal en bloque de madera noble de nogal con ángulo de 65° y antena NFC de largo alcance.</p>
                </div>
                {premiumPrice && (
                  <div class="gama-price-callout">
                    <span class="gama-price-val">{premiumPrice} € <span class="gama-price-unit">/ ud</span></span>
                  </div>
                )}
              </div>

              <!-- 5. Grid de modelos premium -->
              <div class="expositores-apple-grid">
                {premium.map((product) => (
                  <article
                    class="expositores-apple-card"
                    id={`card-${product.id}`}
                    data-product-card
                    data-category-id={product.categoryId}
                    data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} 1 cara 2 caras ${product.tags.join(' ')}`.toLowerCase()}
                    data-product-json={JSON.stringify(product)}
                    tabindex="0"
                    role="button"
                    aria-label={`Ver producto ${product.name}`}
                  >
                    <div class="apple-card-visual expositores-card-visual">
                      <Image
                        src={product.image}
                        alt={product.imageAlt}
                        width={720}
                        height={640}
                        widths={[360, 520, 720]}
                        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 70vw, 540px"
                        format="webp"
                        quality={94}
                        loading="lazy"
                        decoding="async"
                        class="apple-card-img expositores-card-img"
                      />
                    </div>
                    <div class="apple-card-meta expositores-card-meta">
                      <span class="expositor-sides-note">Disponible en 1 o 2 caras</span>
                      <h4 class="apple-card-title expositores-card-title">{product.name}</h4>
                      <p class="apple-card-sub expositores-card-sub">{product.subtitle}</p>
                      <span class="apple-card-cta">
                        <span>Ver producto</span>
                        <span class="cta-arrow" aria-hidden="true">→</span>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </section>
        );
      }

      // --- 4. SECCIÓN PACKS DE HOSTELERÍA & PACK A TU MEDIDA ---
      if (category.id === 'packs') {
        return (
          <section class="catalog-category-section section-packs" id={category.id} data-section-category={category.id}>
            <!-- Encabezado editorial -->
            <div class="category-header-editorial packs-main-header">
              <div class="cat-header-titles">
                <h2 class="cat-section-title">{category.name}</h2>
                <p class="cat-section-desc">{category.description}</p>
              </div>
            </div>

            <!-- Grid de los 3 Packs de Hostelería -->
            <div class="packs-catalog-grid">
              {CATALOG_PACKS.map((pack) => (
                <article
                  class={`pack-catalog-card ${pack.featured ? 'is-featured' : ''}`}
                  id={`card-${pack.id}`}
                  data-product-card
                  data-category-id="packs"
                  data-search-terms={`${pack.name} pack hosteleria ${pack.eyebrow} ${pack.description} ${pack.features.join(' ')}`.toLowerCase()}
                >
                  {pack.featured && (
                    <div class="pack-featured-badge" aria-label="Pack más popular">
                      <span class="pack-live-dot" aria-hidden="true"></span>
                      <span>Más elegido</span>
                    </div>
                  )}

                  <div class="pack-card-topbar">
                    <div class="pack-icon-wrapper" aria-hidden="true">
                      {pack.icon === 'layers' && (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m12 3 8 4.5-8 4.5-8-4.5L12 3Z"/>
                          <path d="m4 12 8 4.5 8-4.5"/>
                          <path d="m4 16.5 8 4.5 8-4.5"/>
                        </svg>
                      )}
                      {pack.icon === 'spark' && (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m12 2 1.85 7.15L21 11l-7.15 1.85L12 20l-1.85-7.15L3 11l7.15-1.85L12 2Z"/>
                        </svg>
                      )}
                      {pack.icon === 'orbit' && (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="2.75"/>
                          <ellipse cx="12" cy="12" rx="9" ry="4.25" transform="rotate(-35 12 12)"/>
                          <path d="M18.5 5.4h.01" stroke-width="3" stroke-linecap="round"/>
                        </svg>
                      )}
                    </div>
                    <span class="pack-zone-pill">{pack.eyebrow}</span>
                  </div>

                  <h3 class="pack-card-title">{pack.name}</h3>
                  <p class="pack-card-desc">{pack.description}</p>

                  <div class="pack-pricing-block">
                    <div class="pack-price-main">
                      <span class="pack-price-num">{pack.price} €</span>
                      <span class="pack-price-period">pago único</span>
                    </div>
                    <div class="pack-price-sub">
                      <span class="pack-saving-tag">{pack.saving}</span>
                      <span class="pack-tax-note">100% deducible</span>
                    </div>
                  </div>

                  <div class="pack-features-divider" aria-hidden="true"></div>

                  <ul class="pack-features-list" aria-label={`Equipamiento incluido en ${pack.name}`}>
                    {pack.features.map((feature) => (
                      <li>
                        <svg class="pack-check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="pack-action-wrap">
                    <a
                      href={`https://wa.me/34910000000?text=${encodeURIComponent(pack.whatsappMessage)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class={pack.featured ? 'btn-pack-featured' : 'btn-pack-secondary'}
                    >
                      <span>{pack.cta}</span>
                      <span class="btn-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>

            <!-- CTA: Pack a tu medida -->
            <div class="custom-pack-cta-banner">
              <div class="custom-pack-content">
                <h3 class="custom-pack-title">Configura tu pack a medida</h3>
                <p class="custom-pack-desc">
                  Elige los productos, cantidades y acabados que mejor encajan con tu espacio. Te preparamos un presupuesto cerrado con grabado láser personalizado de tu logotipo y configuración técnica lista para sala.
                </p>
                <ul class="custom-pack-features" aria-label="Ventajas del pack a medida">
                  <li class="custom-feature-item">
                    <svg class="custom-feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Selección libre de soportes y unidades</span>
                  </li>
                  <li class="custom-feature-item">
                    <svg class="custom-feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Grabado láser personalizado incluido</span>
                  </li>
                  <li class="custom-feature-item">
                    <svg class="custom-feature-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>Tarifa ajustada por volumen para tu sala</span>
                  </li>
                </ul>
              </div>
              <div class="custom-pack-action">
                <a
                  href="https://wa.me/34910000000?text=%C2%A1Hola%20TapNova!%20%F0%9F%91%8B%20Quiero%20configurar%20un%20Pack%20a%20Medida%20para%20mi%20restaurante%20(productos%2C%20cantidades%20y%20grabado%20l%C3%A1ser).%20%C2%BFMe%20pod%C3%A9is%20asesorar%3F"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-custom-pack"
                >
                  <span>Solicitar pack a medida</span>
                  <span class="btn-arrow" aria-hidden="true">→</span>
                </a>
                <span class="custom-pack-note">Respuesta en menos de 2 horas</span>
              </div>
            </div>
          </section>
        );
      }

      // --- 5. SECCIONES GENERALES (TARJETAS, POSAVASOS, PEGATINAS) CON ESTÉTICA APPLE STORE ---
      return (
        <section class={`catalog-category-section section-${category.id}`} id={category.id} data-section-category={category.id}>
          <div class="category-header-editorial">
            <div class="cat-header-titles">
              <h2 class="cat-section-title">{category.name}</h2>
              <p class="cat-section-desc">{category.description}</p>
            </div>
          </div>

          <div class="category-apple-grid">
            {products.map((product) => (
              <article
                class="catalog-apple-card"
                id={`card-${product.id}`}
                data-product-card
                data-category-id={product.categoryId}
                data-search-terms={`${product.name} ${product.shortName} ${product.materials} ${product.tech} ${product.tags.join(' ')}`.toLowerCase()}
                data-product-json={JSON.stringify(product)}
                tabindex="0"
                role="button"
                aria-label={`Ver producto ${product.name}`}
              >
                <div class="apple-card-visual">
                  <Image
                    src={product.image}
                    alt={product.imageAlt}
                    width={640}
                    height={580}
                    widths={[360, 520, 640]}
                    sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 500px"
                    format="webp"
                    quality={92}
                    loading="lazy"
                    decoding="async"
                    class="apple-card-img"
                  />
                </div>
                <div class="apple-card-meta">
                  <h4 class="apple-card-title">{product.name}</h4>
                  <p class="apple-card-sub">{product.subtitle}</p>
                  <span class="apple-card-cta">
                    <span>Ver producto</span>
                    <span class="cta-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>
</div>
