            <span id="modal-active-color-label" class="modal-section-active-val">—</span>
          </div>
          <div class="modal-color-chips-row" id="modal-color-swatches-container"></div>
        </div>

        <!-- 6. Cantidad -->
        <div class="modal-section modal-qty-section">
          <div class="modal-section-label-row">
            <span class="modal-section-label">Cantidad:</span>
          </div>
          <div class="modal-quantity-row">
            <div class="modal-qty-stepper">
              <button type="button" id="modal-qty-minus" class="modal-qty-btn" aria-label="Disminuir unidad">−</button>
              <span id="modal-qty-val" class="modal-qty-display">1</span>
              <button type="button" id="modal-qty-plus" class="modal-qty-btn" aria-label="Aumentar unidad">+</button>
            </div>
            <span class="modal-qty-subtotal-hint" id="modal-qty-total-hint">Total: — €</span>
          </div>
        </div>

        <!-- 7. Descuento por volumen -->
        <div class="modal-section modal-tiers-section">
          <div class="modal-section-label-row">
            <span class="modal-section-label">Descuentos por volumen:</span>
          </div>
          <div class="modal-volume-tiers-row" id="modal-volume-tiers-container">
            <button type="button" class="volume-tier-chip active" data-tier="1" aria-label="1 a 4 unidades">
              <span class="tier-qty-badge">1–4 uds</span><span class="tier-calc-val" id="tier-val-1">—</span>
            </button>
            <button type="button" class="volume-tier-chip" data-tier="5" aria-label="5 a 9 unidades con 20% descuento">
              <span class="tier-qty-badge">5–9 uds <em class="tier-em-dto">-20%</em></span><span class="tier-calc-val" id="tier-val-5">—</span>
            </button>
            <button type="button" class="volume-tier-chip" data-tier="10" aria-label="10 o más unidades con 30% descuento">
              <span class="tier-qty-badge">10+ uds <em class="tier-em-dto">-30%</em></span><span class="tier-calc-val" id="tier-val-10">—</span>
            </button>
          </div>
        </div>

        <!-- 8. Botón Añadir al carrito y elementos complementarios -->
        <div class="modal-actions-box">
          <button type="button" id="modal-add-to-cart-btn" class="modal-add-cart-hero-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" aria-hidden="true">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span id="modal-cta-text">Añadir 1 al carrito · — €</span>
          </button>

          <!-- 9. Línea discreta -->
          <p class="modal-guarantee-line">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>NFC + QR personalizados · Garantía 2 años</span>
          </p>

          <!-- 10. Enlace secundario "Ver especificaciones" & specs compactas -->
          <div class="modal-specs-accordion">
            <button type="button" id="modal-specs-toggle-btn" class="modal-specs-link-btn" aria-expanded="false">
              <span>Ver especificaciones</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="specs-chevron" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div id="modal-specs-drawer" class="modal-specs-compact" hidden>
              <div class="spec-line-clean"><span class="spec-k">Materiales:</span><span id="modal-materials-val" class="spec-v">—</span></div>
              <div class="spec-line-clean"><span class="spec-k">Tecnología:</span><span id="modal-tech-val" class="spec-v">—</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </aside>
