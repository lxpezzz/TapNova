---
interface Props {
  totalProducts: number;
}

const { totalProducts } = Astro.props;
---

<header class="marketplace-header">
  <div class="section-container wide-layout">
    <div class="header-content-row">
      <div class="header-left">
        <nav class="b2b-breadcrumb" aria-label="Navegación secundaria">
          <a href="/" class="back-link"><span aria-hidden="true">←</span><span>Inicio</span></a>
          <span class="sep">/</span>
          <span class="curr">Catálogo de Productos</span>
        </nav>
        <h1 class="marketplace-title">Catálogo de Soportes para Restaurantes</h1>
        <p class="marketplace-sub">
          Soportes físicos con NFC y QR grabado para sala, barra y terraza. Haz clic en cualquier producto para seleccionar color y ver especificaciones.
        </p>
      </div>

      <div class="header-search-wrap">
        <div class="search-input-box">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="catalog-search-input"
            class="catalog-search-input"
            placeholder="Buscar por nombre, material (titanio, nogal...)"
            aria-label="Buscar productos en el catálogo"
            autocomplete="off"
          />
          <button type="button" id="clear-search-btn" class="clear-search-btn" aria-label="Limpiar búsqueda" hidden>✕</button>
        </div>
        <span class="search-counter-badge" id="search-counter-badge">
          <strong id="visible-count">{totalProducts}</strong> soportes disponibles
        </span>
      </div>
    </div>
  </div>
</header>
