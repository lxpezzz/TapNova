<script>
  function initPricingSection() {
    const section = document.getElementById('precios');
    if (!section || section.dataset.initialized) return;
    section.dataset.initialized = 'true';

    // Tabs mode switching
    const tabPacks = document.getElementById('tab-mode-packs');
    const tabCustomizer = document.getElementById('tab-mode-customizer');
    const viewPacks = document.getElementById('view-mode-packs');
    const viewCustomizer = document.getElementById('view-mode-customizer');

    function setViewMode(mode: 'packs' | 'customizer') {
      const isPacks = mode === 'packs';

      tabPacks?.classList.toggle('active', isPacks);
      tabPacks?.setAttribute('aria-selected', isPacks ? 'true' : 'false');
      viewPacks?.classList.toggle('active', isPacks);

      tabCustomizer?.classList.toggle('active', !isPacks);
      tabCustomizer?.setAttribute('aria-selected', !isPacks ? 'true' : 'false');
      viewCustomizer?.classList.toggle('active', !isPacks);
    }

    tabPacks?.addEventListener('click', () => setViewMode('packs'));
    tabCustomizer?.addEventListener('click', () => setViewMode('customizer'));

    // Customizer Elements
    const sliderMesas = document.getElementById('input-mesas-slider') as HTMLInputElement | null;
    const bubbleValue = document.getElementById('bubble-value');
    const tierLabel = document.getElementById('portacuentas-tier-label');
    const discountNoticeText = document.getElementById('discount-notice-text');

    const inputExpositores = document.getElementById('input-expositores') as HTMLInputElement | null;
    const inputTarjetas = document.getElementById('input-tarjetas') as HTMLInputElement | null;

    const choicePosavasos = document.getElementById('choice-posavasos');
    const choicePegatinas = document.getElementById('choice-pegatinas');

    const toggleSeo = document.getElementById('toggle-seo-service') as HTMLInputElement | null;
    const toggleWeb = document.getElementById('toggle-web-service') as HTMLInputElement | null;

    const breakdownContainer = document.getElementById('summary-breakdown-list');
    const totalHardwareElem = document.getElementById('total-hardware-amount');
    const digitalTotalsBlock = document.getElementById('digital-totals-block');
    const savingsElem = document.getElementById('total-savings-amount');
    const savingsBox = document.getElementById('summary-savings-box');
    const btnWhatsapp = document.getElementById('btn-whatsapp-quote') as HTMLAnchorElement | null;
    const btnContact = document.getElementById('btn-request-configuration') as HTMLAnchorElement | null;

    let selectedPosavasos = 0;
    let selectedPegatinas = 0;

    // Steppers Logic
    document.querySelectorAll<HTMLButtonElement>('.btn-step').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const action = btn.getAttribute('data-stepper');
        if (!targetId) return;

        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (!input) return;

        let val = parseInt(input.value, 10) || 0;
        const min = parseInt(input.min, 10) || 0;
        const max = parseInt(input.max, 10) || 99;

        if (action === 'plus' && val < max) val++;
        if (action === 'minus' && val > min) val--;

        input.value = val.toString();
        calculateLiveQuote();
      });
    });

    // Pill Selector for Posavasos & Pegatinas
    function bindPillGroup(container: HTMLElement | null, onSelect: (val: number) => void) {
      if (!container) return;
      const btns = container.querySelectorAll<HTMLButtonElement>('.btn-pill-opt');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          btns.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-checked', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-checked', 'true');
          const num = parseInt(btn.getAttribute('data-value') || '0', 10);
          onSelect(num);
          calculateLiveQuote();
        });
      });
    }

    bindPillGroup(choicePosavasos, (val) => { selectedPosavasos = val; });
    bindPillGroup(choicePegatinas, (val) => { selectedPegatinas = val; });

    // Slider Event
    sliderMesas?.addEventListener('input', () => {
      calculateLiveQuote();
    });

    // Toggle Events
    toggleSeo?.addEventListener('change', calculateLiveQuote);
    toggleWeb?.addEventListener('change', calculateLiveQuote);

    // Main Live Pricing Calculation Logic
    function calculateLiveQuote() {
      const mesas = parseInt(sliderMesas?.value || '0', 10);
      const expositores = parseInt(inputExpositores?.value || '0', 10);
      const tarjetas = parseInt(inputTarjetas?.value || '0', 10);
      const hasSeo = !!toggleSeo?.checked;
      const hasWeb = !!toggleWeb?.checked;

      // Update Slider Display
      if (bubbleValue) bubbleValue.textContent = mesas.toString();

      // Determine Portacuentas Unit Price & Tier
      let unitPrice = 79;
      let originalUnitPrice = 79;
      let tierText = '79 € / ud';
      let noticeMsg = 'Precio base individual (1 a 9 mesas). A partir de 10 mesas obtienes -13% de descuento.';

      if (mesas >= 20) {
        unitPrice = 59;
        tierText = '59 € / ud (-25% dto)';
        noticeMsg = '¡Nivel Sala Grande activado! -25% de descuento por volumen (ahorras 20 € en cada portacuentas).';
      } else if (mesas >= 10) {
        unitPrice = 69;
        tierText = '69 € / ud (-13% dto)';
        noticeMsg = 'Descuento por volumen aplicado: -13% en cada unidad (ahorras 10 € en cada portacuentas).';
      }

      if (tierLabel) tierLabel.textContent = tierText;
      if (discountNoticeText) discountNoticeText.textContent = noticeMsg;

      // Price Calculations
      const costPortacuentas = mesas * unitPrice;
      const regularPortacuentas = mesas * originalUnitPrice;
      const savingsPortacuentas = regularPortacuentas - costPortacuentas;

      const costExpositores = expositores * 69;
      const costTarjetas = tarjetas * 15;

      let costPosavasos = 0;
      if (selectedPosavasos === 50) costPosavasos = 120;
      if (selectedPosavasos === 100) costPosavasos = 190;

      let costPegatinas = 0;
      if (selectedPegatinas === 10) costPegatinas = 35;
      if (selectedPegatinas === 25) costPegatinas = 65;

      const totalHardware = costPortacuentas + costExpositores + costTarjetas + costPosavasos + costPegatinas;

      // Update Breakdown DOM
      if (breakdownContainer) {
        const items = [];

        if (mesas > 0) {
          items.push(`
            <div class="breakdown-row">
              <span class="row-name"><span class="row-qty">${mesas}x</span> Portacuentas Piel & Titanio</span>
              <span class="row-price">${costPortacuentas} €</span>
            </div>
          `);
        }

        if (expositores > 0) {
          items.push(`
            <div class="breakdown-row">
              <span class="row-name"><span class="row-qty">${expositores}x</span> Expositor Nogal Macizo</span>
              <span class="row-price">${costExpositores} €</span>
            </div>
          `);
        }

        if (tarjetas > 0) {
          items.push(`
            <div class="breakdown-row">
              <span class="row-name"><span class="row-qty">${tarjetas}x</span> Tarjetas NFC de Sala</span>
              <span class="row-price">${costTarjetas} €</span>
            </div>
          `);
        }

        if (selectedPosavasos > 0) {
          items.push(`
            <div class="breakdown-row">
              <span class="row-name"><span class="row-qty">${selectedPosavasos}x</span> Posavasos Inteligentes</span>
              <span class="row-price">${costPosavasos} €</span>
            </div>
          `);
        }

        if (selectedPegatinas > 0) {
          items.push(`
            <div class="breakdown-row">
              <span class="row-name"><span class="row-qty">${selectedPegatinas}x</span> Pegatinas QR Epoxi</span>
              <span class="row-price">${costPegatinas} €</span>
            </div>
          `);
        }

        if (items.length === 0) {
          breakdownContainer.innerHTML = `<div class="breakdown-row"><span class="row-name">Selecciona al menos un soporte físico</span><span class="row-price">0 €</span></div>`;
        } else {
          breakdownContainer.innerHTML = items.join('');
        }
      }

      // Update Totals
      if (totalHardwareElem) totalHardwareElem.textContent = `${totalHardware.toLocaleString('es-ES')} €`;

      // Update Digital Block
      if (digitalTotalsBlock) {
        const digitalLines = [];
        if (hasSeo) {
          digitalLines.push(`
            <div class="digital-line">
              <span>SEO Local Google Maps</span>
              <strong>89 € / mes</strong>
            </div>
          `);
        }
        if (hasWeb) {
          digitalLines.push(`
            <div class="digital-line">
              <span>Web Gastronómica con Reservas</span>
              <strong>790 € (Pago único)</strong>
            </div>
          `);
        }

        if (digitalLines.length > 0) {
          digitalTotalsBlock.style.display = 'flex';
          digitalTotalsBlock.innerHTML = digitalLines.join('');
        } else {
          digitalTotalsBlock.style.display = 'none';
        }
      }

      // Update Savings
      if (savingsElem && savingsBox) {
        if (savingsPortacuentas > 0) {
          savingsBox.style.display = 'block';
          savingsElem.textContent = `${savingsPortacuentas} €`;
        } else {
          savingsBox.style.display = 'none';
        }
      }

      // Build WhatsApp Pre-filled message URL
      if (btnWhatsapp) {
        const textParts = [
          `Hola TapNova, he configurado un presupuesto a medida para mi restaurante:`,
          mesas > 0 ? `- ${mesas} Portacuentas en piel y titanio` : '',
          expositores > 0 ? `- ${expositores} Expositores de nogal` : '',
          tarjetas > 0 ? `- ${tarjetas} Tarjetas NFC de sala` : '',
          selectedPosavasos > 0 ? `- ${selectedPosavasos} Posavasos inteligentes` : '',
          selectedPegatinas > 0 ? `- ${selectedPegatinas} Pegatinas QR` : '',
          `*Subtotal Equipamiento:* ${totalHardware} €`,
          hasSeo ? `*Servicio:* Posicionamiento SEO Local (89 €/mes)` : '',
          hasWeb ? `*Proyecto:* Página Web Gastronómica (790 €)` : '',
          `Me gustaría solicitar la propuesta con simulación de grabado o formalizar el pedido.`
        ].filter(Boolean).join('\n');

        btnWhatsapp.href = `https://wa.me/34600000000?text=${encodeURIComponent(textParts)}`;
      }
    }

    // Connect "Ajustar este pack en el configurador" buttons
    document.querySelectorAll<HTMLButtonElement>('[data-customizer-trigger]').forEach(btn => {
      btn.addEventListener('click', () => {
        const rawData = btn.getAttribute('data-customizer-payload');
        if (!rawData) return;

        try {
          const data = JSON.parse(rawData);
          // Set Slider Mesas
          if (sliderMesas && typeof data.mesas === 'number') {
            sliderMesas.value = data.mesas.toString();
          }

          // Set Steppers
          if (inputExpositores && typeof data.expositores === 'number') {
            inputExpositores.value = data.expositores.toString();
          }
          if (inputTarjetas && typeof data.tarjetas === 'number') {
            inputTarjetas.value = data.tarjetas.toString();
          }

          // Set Posavasos
          if (choicePosavasos && typeof data.posavasos === 'number') {
            selectedPosavasos = data.posavasos;
            choicePosavasos.querySelectorAll<HTMLButtonElement>('.btn-pill-opt').forEach(b => {
              const val = parseInt(b.getAttribute('data-value') || '0', 10);
              const isActive = val === selectedPosavasos;
              b.classList.toggle('active', isActive);
              b.setAttribute('aria-checked', isActive ? 'true' : 'false');
            });
          }

          // Set Pegatinas
          if (choicePegatinas && typeof data.pegatinas === 'number') {
            selectedPegatinas = data.pegatinas;
            choicePegatinas.querySelectorAll<HTMLButtonElement>('.btn-pill-opt').forEach(b => {
              const val = parseInt(b.getAttribute('data-value') || '0', 10);
              const isActive = val === selectedPegatinas;
              b.classList.toggle('active', isActive);
              b.setAttribute('aria-checked', isActive ? 'true' : 'false');
            });
          }

          // Set Toggles
          if (toggleSeo) toggleSeo.checked = !!data.seo;
          if (toggleWeb) toggleWeb.checked = !!data.web;

          // Switch to customizer tab
          setViewMode('customizer');

          // Recalculate
          calculateLiveQuote();

          // Scroll smoothly to customizer
          viewCustomizer?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        } catch {
          // La precarga es opcional: si falla, el configurador sigue disponible.
        }
      });
    });

    // Initial calculation
    calculateLiveQuote();
  }

  // Bind on page load & Astro client navigation
  initPricingSection();
  document.addEventListener('astro:page-load', initPricingSection);
</script>
