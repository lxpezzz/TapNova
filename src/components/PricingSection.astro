---
import { Image } from 'astro:assets';

import portacuentasImg from '../assets/products/portacuentas.webp';
import portacuentasOpenImg from '../assets/products/portacuentas-open.webp';
import expositorImg from '../assets/products/expositor.webp';
import tarjetaNfcImg from '../assets/products/tarjeta-nfc.webp';
import posavasosImg from '../assets/products/pegatina.webp';
import pegatinasImg from '../assets/products/pegatina.webp';
import seoLocalImg from '../assets/showcase/seo-local-context.webp';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const packs = [
  {
    id: 'pack-barra',
    name: 'Barra & Terraza',
    badge: 'BARRA & TERRAZA',
    badgeClass: 'badge-amber',
    popular: false,
    price: 290,
    originalPrice: 340,
    savings: 50,
    period: 'pago único de equipamiento',
    target: 'Para locales dinámicos centrados en barra, mesas altas y terraza.',
    inventory: [
      {
        qty: '1',
        name: 'Expositor Nogal',
        detail: 'Barra / Caja cobro',
        icon: 'wood'
      },
      {
        qty: '50',
        name: 'Posavasos NFC',
        detail: 'Impermeables terraza',
        icon: 'coaster'
      },
      {
        qty: '10',
        name: 'Pegatinas QR',
        detail: 'Resina epoxi relieve',
        icon: 'sticker'
      }
    ],
    perks: [
      'Configuración e integración directa con Google Maps',
      'Grabado láser o acabado TapNova verificado',
      'Sustitución de hardware y chips NFC 2 años'
    ],
    ctaText: 'Elegir Pack Barra & Terraza',
    customizerData: {
      mesas: 0,
      expositores: 1,
      tarjetas: 0,
      posavasos: 50,
      pegatinas: 10,
      seo: false,
      web: false
    }
  },
  {
    id: 'pack-sala',
    name: 'Restaurante Sala',
    badge: 'MÁS ELEGIDO · RECOMENDADO',
    badgeClass: 'badge-popular',
    popular: true,
    price: 890,
    originalPrice: 1150,
    savings: 260,
    period: 'equipamiento sala + regalo digital',
    target: 'Para restaurantes de 10 a 20 mesas que cuidan cada pase.',
    inventory: [
      {
        qty: '12',
        name: 'Portacuentas Piel',
        detail: 'Con placa de titanio',
        icon: 'bill'
      },
      {
        qty: '2',
        name: 'Expositores Nogal',
        detail: 'Recepción y barra',
        icon: 'wood'
      },
      {
        qty: '5',
        name: 'Tarjetas NFC',
        detail: 'Equipo de camareros',
        icon: 'card'
      }
    ],
    gift: '1er mes de SEO Local en Google Maps de regalo (valorado en 89 €)',
    perks: [
      'Grabado láser personalizado con el logo de tu local',
      'Chips NFC de alta sensibilidad compatibles con iPhone y Android',
      'Garantía premium de hardware y soporte directo 2 años'
    ],
    ctaText: 'Elegir Pack Restaurante Sala',
    customizerData: {
      mesas: 12,
      expositores: 2,
      tarjetas: 5,
      posavasos: 0,
      pegatinas: 0,
      seo: true,
      web: false
    }
  },
  {
    id: 'pack-360',
    name: 'Digitalización 360°',
    badge: 'SALA COMPLETA + WEB + SEO',
    badgeClass: 'badge-purple',
    popular: false,
    price: 1790,
    originalPrice: 2250,
    savings: 460,
    period: 'equipamiento completo + web + SEO',
    target: 'La solución definitiva para equipar tu local y captar clientes online.',
    inventory: [
      {
        qty: '20',
        name: 'Portacuentas Piel',
        detail: 'Titanio (sala completa)',
        icon: 'bill'
      },
      {
        qty: '3',
        name: 'Expositores Nogal',
        detail: 'Barra, hall y terraza',
        icon: 'wood'
      },
      {
        qty: '8',
        name: 'Tarjetas NFC',
        detail: 'Equipo de sala',
        icon: 'card'
      },
      {
        qty: '100',
        name: 'Posavasos NFC',
        detail: '+ 25 Pegatinas QR',
        icon: 'plus'
      }
    ],
    digitalBonus: [
      {
        title: 'Página Web Gastronómica',
        desc: 'Carta interactiva y reservas sin comisiones'
      },
      {
        title: '3 meses SEO Local',
        desc: 'Estrategia activa y posicionamiento en Maps'
      }
    ],
    perks: [
      'Asesor personal asignado para optimización de ficha de Google',
      'Personalización completa con tu identidad corporativa',
      'Garantía premium de 2 años en todo el equipamiento físico'
    ],
    ctaText: 'Elegir Pack Digitalización 360°',
    customizerData: {
      mesas: 20,
      expositores: 3,
      tarjetas: 8,
      posavasos: 100,
      pegatinas: 25,
      seo: true,
      web: true
    }
  }
];

const desktopPacks = [
  {
    ...packs[0],
    displayName: 'Tap Start',
    benefit: 'Convierte momentos de sala en nuevas reseñas.',
    visualLabel: 'Captación de reseñas',
  },
  {
    ...packs[1],
    displayName: 'Tap Pro',
    benefit: 'Tu sala conectada con la visibilidad local.',
    visualLabel: 'Sala + Google Maps',
  },
  {
    ...packs[2],
    displayName: 'Tap Galaxy',
    benefit: 'El sistema completo, dentro y fuera del local.',
    visualLabel: 'Ecosistema TapNova',
  },
];
---

<section class={`pricing-section ${className}`} id="precios" aria-label="Precios y configuración de equipamiento TapNova">
  <!-- Atmospheric Background Glows -->
  <div class="pricing-ambient-glow glow-top" aria-hidden="true"></div>
  <div class="pricing-ambient-glow glow-middle" aria-hidden="true"></div>
  <div class="pricing-ambient-glow glow-bottom" aria-hidden="true"></div>

  <div class="section-container">
    <!-- Header Section -->
    <header class="pricing-header text-center">
      <h2 class="pricing-main-title font-display">
        Equipa tu local a tu medida o elige un pack llave en mano.
      </h2>
      <p class="pricing-main-sub">
        Separamos con total claridad el <strong>equipamiento físico en propiedad</strong> (pago único 100% desgravable) de los <strong>servicios de crecimiento digital</strong>. Sin permanencias ni sorpresas.
      </p>
    </header>

    <!-- =======================================================================
         SECCIÓN 1: LOS 3 PACKS (De un solo vistazo)
         ======================================================================= -->
    <div class="packs-showcase-wrapper" id="packs-recomendados">
      <div class="packs-section-label">
        <h3 class="packs-subheading font-display">Packs recomendados con todo incluido</h3>
        <p class="packs-subdesc">Todo el hardware configurado, grabado y listo para el servicio desde el primer día.</p>
      </div>

      <div class="desktop-pack-explorer" data-active-pack="pack-sala">
        <div class="desktop-pack-visual" aria-live="polite">
          <div class="pack-visual-heading">
            <span class="pack-visual-eyebrow">EL SISTEMA EN TU NEGOCIO</span>
            <p class="pack-visual-state" data-pack-visual-label>Sala + Google Maps</p>
          </div>

          <!-- Visual Conceptual & Explicativo por Pack -->
          <div class="product-stage-canvas" aria-hidden="true">
            <!-- Ambiente sutil -->
            <div class="stage-spotlight"></div>
            
            <!-- Representación Conceptual de Soportes Físicos Existentes -->
            <div class="stage-hardware-cluster">
              <div class="stage-product-item item-portacuentas">
                <Image
                  src={portacuentasImg}
                  alt="Portacuentas TapNova"
                  width={320}
                  height={320}
                  quality={90}
                  class="stage-img"
                />
              </div>

              <div class="stage-product-item item-expositor">
                <Image
                  src={expositorImg}
                  alt="Expositor TapNova"
                  width={220}
                  height={220}
                  quality={90}
                  class="stage-img"
                />
              </div>

              <div class="stage-product-item item-tarjeta">
                <Image
                  src={tarjetaNfcImg}
                  alt="Tarjeta NFC TapNova"
                  width={160}
                  height={160}
                  quality={90}
                  class="stage-img"
                />
              </div>
            </div>

            <!-- CAPA START: Captación de reseñas con productos físicos -->
            <div class="stage-layer layer-start">
              <div class="stage-concept-badge badge-start">
                <span class="concept-icon">★</span>
                <div class="concept-text">
                  <strong>Captación en sala</strong>
                  <span>Soportes físicos NFC y QR</span>
                </div>
              </div>
            </div>

            <!-- CAPA PRO: Productos físicos + Google / SEO Local -->
            <div class="stage-layer layer-pro">
              <div class="stage-concept-card card-pro">
                <div class="concept-header">
                  <span class="concept-tag">Google Maps & SEO Local</span>
                </div>
                <p class="concept-desc">Soportes físicos en sala conectados con la presencia en Google Maps.</p>
              </div>
            </div>

            <!-- CAPA GALAXY: Sistema completo con físico + Google + Web -->
            <div class="stage-layer layer-galaxy">
              <div class="stage-concept-card card-galaxy">
                <div class="concept-header">
                  <span class="concept-tag tag-galaxy">Sistema completo</span>
                </div>
                <p class="concept-desc">Soportes físicos + Ficha Google Maps + Página web para tu negocio.</p>
              </div>
            </div>

            <div class="stage-pedestal-rim"></div>
          </div>

          <div class="pack-visual-caption">
            <span class="pack-visual-index" data-pack-visual-index>02</span>
            <p data-pack-visual-copy>El equipamiento de tu sala activa reseñas y conecta tu negocio con las búsquedas cercanas.</p>
          </div>
        </div>

        <div class="desktop-pack-panel">
          <!-- Selector Horizontal de los 3 Packs (Siempre visibles: Tap Start, Tap Pro y Tap Galaxy) -->
          <div class="desktop-pack-selector" role="tablist" aria-label="Elige un pack TapNova">
            {desktopPacks.map((pack) => (
              <button
                type="button"
                class:list={['desktop-pack-option', { 'is-active': pack.popular }]}
                data-pack-option={pack.id}
                role="tab"
                aria-selected={pack.popular ? 'true' : 'false'}
                aria-controls={`pack-detail-${pack.id}`}
              >
                <div class="pack-opt-top">
                  <div class="pack-opt-title-wrap">
                    <span class="desktop-pack-option-name font-display">{pack.displayName}</span>
                    {pack.popular && <span class="desktop-pack-option-badge">Más elegido</span>}
                  </div>
                  <div class="desktop-pack-option-price">
                    <b>{pack.price} €</b>
                    <small>pago único</small>
                  </div>
                </div>
                <p class="desktop-pack-option-benefit">{pack.benefit}</p>
              </button>
            ))}
          </div>

          <!-- Detalle del Pack Activo: Productos incluidos, servicios y CTA (ceñido 100% a datos reales) -->
          <div class="desktop-pack-details">
            {desktopPacks.map((pack) => (
              <section
                class:list={['desktop-pack-detail', { 'is-active': pack.popular }]}
                id={`pack-detail-${pack.id}`}
                data-pack-detail={pack.id}
                role="tabpanel"
                tabindex="0"
                hidden={!pack.popular}
              >
                <div class="desktop-pack-detail-head">
                  <div class="detail-kicker-row">
                    <span class="desktop-pack-detail-kicker">{pack.visualLabel}</span>
                    {pack.savings && (
                      <span class="detail-savings-badge">Ahorras {pack.savings} €</span>
                    )}
                  </div>
                  <h4 class="font-display">{pack.displayName}</h4>
                  <p class="detail-target-desc">{pack.target}</p>
                </div>

                <div class="desktop-pack-detail-columns">
                  <div class="detail-col">
                    <span class="desktop-pack-detail-label">Productos incluidos</span>
                    <ul class="desktop-pack-inventory">
                      {pack.inventory.map((item) => (
                        <li>
                          <span class="inv-qty">{item.qty}×</span>
                          <span class="inv-name">{item.name}</span>
                          <span class="inv-note">({item.detail})</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="detail-col">
                    <span class="desktop-pack-detail-label">Servicios incluidos</span>
                    <ul class="desktop-pack-services">
                      {pack.gift && (
                        <li class="service-highlight">
                          <span class="service-icon">✦</span>
                          <span>{pack.gift}</span>
                        </li>
                      )}
                      {pack.digitalBonus?.map((bonus) => (
                        <li class="service-bonus">
                          <span class="service-icon">✦</span>
                          <span><strong>{bonus.title}:</strong> {bonus.desc}</span>
                        </li>
                      ))}
                      {pack.perks.map((perk) => (
                        <li>
                          <span class="service-icon">✓</span>
                          <span>{perk}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="desktop-pack-detail-actions">
                  <a href="#contacto" class="btn-pack-cta btn-solid-white">
                    <span>{pack.ctaText}</span>
                    <span class="btn-icon" aria-hidden="true">→</span>
                  </a>
                  <button
                    type="button"
                    class="btn-customize-link"
                    data-customizer-trigger={pack.id}
                    data-customizer-payload={JSON.stringify(pack.customizerData)}
                  >
                    <span>Personalizar este pack</span>
                    <span class="action-arrow" aria-hidden="true">↓</span>
                  </button>
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>

      <div class="packs-grid">
        {packs.map((pack) => (
          <article class={`pack-card-shell ${pack.popular ? 'pack-popular' : ''}`}>
            <div class="pack-card-inner">
              <!-- Top Header & Target -->
              <div class="pack-header">
                <h3 class="pack-title font-display">{pack.name}</h3>
                <p class="pack-target">{pack.target}</p>
              </div>

              <!-- Price Box -->
              <div class="pack-price-box">
                <div class="price-figures">
                  <span class="currency">€</span>
                  <span class="amount font-display">{pack.price}</span>
                  <span class="period">/ {pack.period}</span>
                </div>
                <div class="price-savings-row">
                  <span class="original-price">Antes {pack.originalPrice} €</span>
                  <span class="savings-chip">Ahorras {pack.savings} €</span>
                </div>
              </div>

              <!-- Instant Glance Equipment Matrix (De un vistazo sin leer todo) -->
              <div class="pack-glance-section">
                <span class="glance-title">QUÉ INCLUYE (DE UN VISTAZO):</span>
                
                <div class="glance-items-grid">
                  {pack.inventory.map((item) => (
                    <div class="glance-item-card">
                      <div class="glance-qty-badge">
                        <span class="glance-qty-num">{item.qty}</span>
                        <span class="glance-qty-x">x</span>
                      </div>
                      <div class="glance-item-info">
                        <strong class="glance-item-name">{item.name}</strong>
                        <span class="glance-item-detail">{item.detail}</span>
                      </div>
                    </div>
                  ))}
                </div>

                {/* Regalo / Bonus Digital */}
                {pack.gift && (
                  <div class="pack-gift-pill">
                    <span class="gift-icon" aria-hidden="true">🎁</span>
                    <span class="gift-text">{pack.gift}</span>
                  </div>
                )}

                {/* Digital Bonus for 360 Pack */}
                {pack.digitalBonus && (
                  <div class="pack-digital-bonus-list">
                    {pack.digitalBonus.map((bonus) => (
                      <div class="digital-bonus-item">
                        <span class="bonus-check" aria-hidden="true">⚡</span>
                        <div class="bonus-texts">
                          <strong>{bonus.title}:</strong> <span>{bonus.desc}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              <!-- Quick Perks Bullet Strip -->
              <ul class="pack-perks-list" aria-label="Detalles y garantías">
                {pack.perks.map((perk) => (
                  <li>
                    <span class="perk-icon" aria-hidden="true">✓</span>
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>

              <!-- Actions Area -->
              <div class="pack-actions">
                <a 
                  href="#contacto" 
                  class={`btn-pack-cta ${pack.popular ? 'btn-solid-white' : 'btn-primary'}`}
                >
                  <span>{pack.ctaText}</span>
                  <span class="btn-icon" aria-hidden="true">→</span>
                </a>

                <button 
                  type="button" 
                  class="btn-customize-link"
                  data-customizer-trigger={pack.id}
                  data-customizer-payload={JSON.stringify(pack.customizerData)}
                >
                  <span>Personalizar unidades de este pack</span>
                  <span class="action-arrow" aria-hidden="true">↓</span>
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Trust Assurance Strip -->
      <div class="pricing-trust-strip">
        <div class="trust-item">
          <span class="trust-icon" aria-hidden="true">✓</span>
          <span>Factura de equipamiento 100% deducible</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon" aria-hidden="true">✓</span>
          <span>Garantía de chips y materiales 2 años</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon" aria-hidden="true">✓</span>
          <span>Sin cuotas obligatorias por el hardware</span>
        </div>
        <div class="trust-item">
          <span class="trust-icon" aria-hidden="true">✓</span>
          <span>Simulación de grabado gratuita antes de producir</span>
        </div>
      </div>
    </div>

    <!-- =======================================================================
         SEPARADOR CTA: "¿PREFIERES CREAR TU PROPIA COMBINACIÓN?"
         Funciona como divisor visual y puente interactivo hacia los productos individuales
         ======================================================================= -->
    <div class="pricing-custom-separator-wrap" id="separador-combinacion">
      <div class="zone-card-shell separator-cta-card">
        <!-- Floating Ambient Aura inside the card -->
        <div class="separator-halo" aria-hidden="true"></div>

        <div class="separator-content">
          <div class="separator-badge">
            <span class="sep-badge-dot" aria-hidden="true"></span>
            <span>CONFIGURACIÓN A MEDIDA</span>
          </div>

          <h3 class="separator-title font-display">
            ¿PREFIERES CREAR TU PROPIA COMBINACIÓN?
          </h3>

          <p class="separator-desc">
            Si tu restaurante tiene un número específico de mesas, barra o terraza, ajusta las unidades exactas de cada soporte físico y calcula tu presupuesto con descuentos por volumen en tiempo real.
          </p>

          <div class="separator-actions">
            <a href="#productos-individuales" class="btn-solid-white btn-jump-customizer" id="btn-scroll-to-customizer">
              <span>Diseñar mi propia combinación</span>
              <span class="btn-icon" aria-hidden="true">↓</span>
            </a>
            <span class="separator-hint">Ajusta cada producto a continuación</span>
          </div>
        </div>
      </div>
    </div>

    <!-- =======================================================================
         SECCIÓN 2: PRODUCTOS INDIVIDUALES & CONFIGURADOR INTERACTIVO
         (Debajo de los packs y del CTA separador)
         ======================================================================= -->
    <div class="individual-products-section" id="productos-individuales">
      <div class="individual-section-label">
        <h3 class="individual-main-title font-display">
          Configura tus productos individuales
        </h3>
        <p class="individual-main-sub">
          Añade exactamente lo que necesitas para tu local. Los descuentos por volumen en portacuentas se aplican de forma automática.
        </p>
      </div>

      <div class="customizer-layout-grid">
        <!-- Left Column: Individual Product Controllers -->
        <div class="customizer-controls-column">

          <!-- PRODUCTO 1: Portacuentas en Piel & Titanio -->
          <div class="control-card-shell product-control-card">
            <div class="product-card-topbar">
              <div class="product-thumb-wrap">
                <Image 
                  src={portacuentasImg} 
                  alt="Portacuentas en piel y titanio" 
                  width={96}
                  height={96}
                  class="product-thumb-img"
                  loading="lazy"
                />
              </div>
              <div class="product-header-info">
                <div class="product-badge-row">
                  <span class="zone-pill">SALA & MESAS</span>
                  <span class="tier-indicator" id="portacuentas-tier-label">79 € / ud</span>
                </div>
                <h4 class="control-name">Portacuentas en Piel & Titanio</h4>
                <p class="control-sub">El soporte noble de entrega de cuenta. Chip NFC integrado y placa de titanio grabada.</p>
              </div>
            </div>

            <!-- Volume Tier Scale Bar -->
            <div class="volume-tiers-legend">
              <div class="tier-col active" id="tier-col-1">
                <span class="tier-col-range">1 a 9 mesas</span>
                <strong class="tier-col-price">79 €/ud</strong>
                <span class="tier-col-note">Precio base</span>
              </div>
              <div class="tier-col" id="tier-col-2">
                <span class="tier-col-range">10 a 19 mesas</span>
                <strong class="tier-col-price">69 €/ud</strong>
                <span class="tier-col-note">-13% de ahorro</span>
              </div>
              <div class="tier-col" id="tier-col-3">
                <span class="tier-col-range">20+ mesas</span>
                <strong class="tier-col-price">59 €/ud</strong>
                <span class="tier-col-note">-25% de ahorro</span>
              </div>
            </div>

            <!-- Interactive Slider -->
            <div class="slider-wrapper">
              <div class="slider-header-flex">
                <span class="slider-label">Número de mesas:</span>
                <div class="slider-val-bubble" id="slider-bubble">
                  <span id="bubble-value">12</span> mesas
                </div>
              </div>
              <input 
                type="range" 
                min="0" 
                max="40" 
                value="12" 
                step="1"
                class="custom-slider" 
                id="input-mesas-slider"
                aria-label="Número de mesas o portacuentas"
              />
              <div class="slider-ticks">
                <span>0</span>
                <span>10 mesas (-13%)</span>
                <span>20 mesas (-25%)</span>
                <span>40 mesas</span>
              </div>
            </div>

            <div class="volume-discount-callout" id="volume-discount-notice">
              <span class="sparkle-icon" aria-hidden="true">✨</span>
              <span id="discount-notice-text">Descuento por volumen aplicado: -13% en cada unidad (69 €/ud en vez de 79 €).</span>
            </div>
          </div>

          <!-- PRODUCTO 2 & 3: Expositores de Nogal y Tarjetas NFC -->
          <div class="control-card-shell">
            <div class="control-header">
              <div class="control-title-row">
                <span class="zone-pill">BARRA, CAJA & SALA</span>
              </div>
              <h4 class="control-name">Soportes auxiliares para barra y equipo</h4>
              <p class="control-sub">Completa los puntos de contacto del comensal antes y después del servicio.</p>
            </div>

            <div class="steppers-grid">
              <!-- Expositor Nogal -->
              <div class="stepper-item-card">
                <div class="stepper-thumb">
                  <Image 
                    src={expositorImg} 
                    alt="Expositor nogal" 
                    width={72} 
                    height={72} 
                    class="stepper-img"
                    loading="lazy"
                  />
                </div>
                <div class="stepper-info">
                  <strong class="item-name">Expositores de Nogal</strong>
                  <span class="item-meta">Barra & Caja · <strong>69 € / ud</strong></span>
                </div>
                <div class="stepper-control">
