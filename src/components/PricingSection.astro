      letter-spacing: -0.02em;
    }

    .detail-target-desc {
      margin: 0 0 1.25rem;
      color: var(--text-secondary);
      font-size: 0.84rem;
      line-height: 1.5;
    }

    .desktop-pack-detail-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      padding: 1.15rem 0;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .desktop-pack-inventory,
    .desktop-pack-services {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin: 0.6rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 0.78rem;
      line-height: 1.4;
      color: var(--text-secondary);
    }

    .desktop-pack-inventory li {
      display: flex;
      align-items: baseline;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .inv-qty {
      color: var(--accent-amber);
      font-weight: 700;
    }

    .inv-name {
      color: #ffffff;
      font-weight: 600;
    }

    .inv-note {
      color: var(--text-muted);
      font-size: 0.72rem;
    }

    .desktop-pack-services li {
      display: flex;
      align-items: flex-start;
      gap: 0.45rem;
    }

    .service-icon {
      color: var(--accent-amber);
      font-size: 0.75rem;
      flex-shrink: 0;
    }

    .service-highlight strong {
      color: #feed7a;
    }

    .service-bonus strong {
      color: var(--accent-purple);
    }

    .pack-guarantee-micro {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0.85rem 0 1.15rem;
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .desktop-pack-detail-actions {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .desktop-pack-detail-actions .btn-pack-cta {
      width: auto;
      padding: 0.85rem 1.6rem;
      font-size: 0.875rem;
    }

    .desktop-pack-detail-actions .btn-customize-link {
      padding: 0.35rem 0;
      font-size: 0.8125rem;
    }
  }

  .pack-card-shell {
    position: relative;
    border-radius: clamp(1.75rem, 2.5vw, 2.25rem);
    background: rgba(14, 14, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), inset 0 1px 1px rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.3s var(--ease-default), border-color 0.3s var(--ease-default), box-shadow 0.3s var(--ease-default);
  }

  .pack-card-shell:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 255, 255, 0.22);
    box-shadow: 0 32px 75px rgba(0, 0, 0, 0.8);
  }

  /* Popular Highlight */
  .pack-popular {
    border-color: rgba(255, 157, 36, 0.5);
    background: linear-gradient(180deg, rgba(28, 22, 16, 0.9) 0%, rgba(14, 14, 18, 0.9) 100%);
    box-shadow: 0 30px 80px rgba(255, 132, 0, 0.15), 0 20px 50px rgba(0, 0, 0, 0.8);
  }

  .popular-ribbon {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(90deg, #feed7a 0%, #ff9d24 50%, #ff8400 100%);
    color: #050505;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    padding: 0.3rem 1.4rem;
    border-radius: 0 0 12px 12px;
    box-shadow: 0 4px 16px rgba(255, 132, 0, 0.4);
    z-index: 5;
    white-space: nowrap;
  }

  .pack-card-inner {
    padding: clamp(2rem, 3vw, 2.6rem);
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 1.5rem;
  }

  .pack-badge-row {
    margin-bottom: 0.45rem;
  }

  .pack-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badge-amber {
    background: rgba(255, 157, 36, 0.12);
    border: 1px solid rgba(255, 157, 36, 0.3);
    color: var(--accent-amber);
  }

  .badge-popular {
    background: rgba(254, 237, 122, 0.16);
    border: 1px solid rgba(254, 237, 122, 0.4);
    color: var(--accent-yellow);
  }

  .badge-purple {
    background: rgba(223, 145, 247, 0.14);
    border: 1px solid rgba(223, 145, 247, 0.35);
    color: var(--accent-purple);
  }

  .pack-title {
    font-size: clamp(1.65rem, 2.2vw, 2rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .pack-target {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
    margin-top: 0.35rem;
  }

  /* Price box */
  .pack-price-box {
    padding: 1.15rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .price-figures {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .currency {
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
  }

  .amount {
    font-size: clamp(2.8rem, 3.8vw, 3.4rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .period {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .price-savings-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
  }

  .original-price {
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .savings-chip {
    color: var(--accent-amber);
    font-weight: 700;
    background: rgba(255, 157, 36, 0.1);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 157, 36, 0.25);
  }

  /* -------------------------------------------------------------------------
     GLANCE EQUIPMENT MATRIX (Lo que tiene cada uno de un vistazo)
     ------------------------------------------------------------------------- */
  .pack-glance-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.75rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-lg);
  }

  .glance-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    text-transform: uppercase;
    padding-left: 0.25rem;
  }

  .glance-items-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .glance-item-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    transition: background 0.2s ease;
  }

  .glance-item-card:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .glance-qty-badge {
    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    min-width: 44px;
    padding: 0.25rem 0.5rem;
    border-radius: 8px;
    background: rgba(255, 157, 36, 0.14);
    border: 1px solid rgba(255, 157, 36, 0.3);
    color: var(--accent-amber);
  }

  .pack-popular .glance-qty-badge {
    background: rgba(254, 237, 122, 0.18);
    border-color: rgba(254, 237, 122, 0.4);
    color: #feed7a;
  }

  .glance-qty-num {
    font-size: 1.15rem;
    font-weight: 800;
    line-height: 1;
    font-feature-settings: "tnum";
  }

  .glance-qty-x {
    font-size: 0.75rem;
    font-weight: 700;
    margin-left: 1px;
    opacity: 0.8;
  }

  .glance-item-info {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .glance-item-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .glance-item-detail {
    font-size: 0.75rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Gift Pill & Digital Bonus */
  .pack-gift-pill {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(90deg, rgba(254, 237, 122, 0.14) 0%, rgba(255, 157, 36, 0.12) 100%);
    border: 1px solid rgba(254, 237, 122, 0.35);
    border-radius: var(--radius-md);
  }

  .gift-icon {
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .gift-text {
    font-size: 0.8rem;
    font-weight: 600;
    color: #feed7a;
    line-height: 1.35;
  }

  .pack-digital-bonus-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-top: 0.25rem;
  }

  .digital-bonus-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgba(223, 145, 247, 0.08);
    border: 1px solid rgba(223, 145, 247, 0.22);
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .bonus-check {
    color: var(--accent-purple);
    font-weight: bold;
    flex-shrink: 0;
  }

  .digital-bonus-item strong {
    color: #ffffff;
  }

  /* Perks List */
  .pack-perks-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-grow: 1;
    margin: 0;
    padding: 0.25rem 0;
  }

  .pack-perks-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  .perk-icon {
    color: var(--accent-amber);
    font-weight: bold;
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  /* Pack Actions */
  .pack-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn-pack-cta {
    width: 100%;
    justify-content: center;
  }

  .btn-customize-link {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    cursor: pointer;
    padding: 0.4rem;
    transition: color 0.2s ease;
  }

  .btn-customize-link:hover {
    color: var(--accent-amber);
  }

  .btn-customize-link .action-arrow {
    transition: transform 0.2s ease;
  }

  .btn-customize-link:hover .action-arrow {
    transform: translateY(2px);
  }

  /* Trust Assurance Strip */
  .pricing-trust-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1.5rem 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  @media (min-width: 640px) {
    .pricing-trust-strip {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pricing-trust-strip {
      grid-template-columns: repeat(4, 1fr);
      text-align: center;
    }
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .trust-item {
      justify-content: center;
    }
  }

  .trust-icon {
    color: var(--accent-amber);
    font-weight: bold;
    flex-shrink: 0;
  }

  /* -------------------------------------------------------------------------
     SEPARADOR CTA: "¿PREFIERES CREAR TU PROPIA COMBINACIÓN?"
     ------------------------------------------------------------------------- */
  .pricing-custom-separator-wrap {
    position: relative;
    z-index: 5;
    margin-top: clamp(4rem, 7vw, 6.5rem);
    margin-bottom: clamp(4rem, 7vw, 6.5rem);
  }

  .separator-cta-card {
    position: relative;
    border-radius: clamp(1.75rem, 3vw, 2.5rem);
    background: linear-gradient(135deg, rgba(20, 18, 24, 0.95) 0%, rgba(12, 12, 16, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    overflow: hidden;
    text-align: center;
  }

  .separator-halo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70%;
    height: 120%;
    background: radial-gradient(circle, rgba(255, 157, 36, 0.22) 0%, rgba(223, 145, 247, 0.15) 50%, transparent 75%);
    filter: blur(60px);
    pointer-events: none;
  }

  .separator-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .separator-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 157, 36, 0.1);
    border: 1px solid rgba(255, 157, 36, 0.28);
    color: var(--accent-amber);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sep-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-amber);
    box-shadow: 0 0 6px var(--accent-amber);
  }

  .separator-title {
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 500;
    line-height: 1.15;
    color: #ffffff;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .separator-desc {
    font-size: clamp(1.02rem, 1.25vw, 1.15rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 680px;
    text-wrap: balance;
  }

  .separator-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .btn-jump-customizer {
    padding-inline: 2rem;
  }

  .separator-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* -------------------------------------------------------------------------
     SECCIÓN 2: PRODUCTOS INDIVIDUALES & CONFIGURADOR
     ------------------------------------------------------------------------- */
  .individual-products-section {
    position: relative;
    z-index: 2;
    scroll-margin-top: 5rem;
  }

  .individual-section-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .individual-main-title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .individual-main-sub {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 660px;
    text-wrap: balance;
  }

  .customizer-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 3vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .customizer-layout-grid {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .control-card-shell {
    background: rgba(14, 14, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 3vw, 2.5rem);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), inset 0 1px 1px rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    margin-bottom: 1.75rem;
  }

  /* Product Topbar with Thumbnail */
  .product-card-topbar {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .product-thumb-wrap {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    padding: 0.35rem;
  }

  .product-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: lighten;
  }

  .product-header-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex-grow: 1;
  }

  .product-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.15rem;
  }

  .control-header {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .control-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.25rem;
  }

  .zone-pill {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-amber);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 157, 36, 0.1);
    border: 1px solid rgba(255, 157, 36, 0.25);
  }

  .pill-purple {
    color: var(--accent-purple);
    background: rgba(223, 145, 247, 0.1);
    border-color: rgba(223, 145, 247, 0.25);
  }

  .tier-indicator {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    font-feature-settings: "tnum";
  }

  .control-name {
    font-size: 1.35rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.015em;
  }

  .control-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Volume Tiers Scale Bar */
  .volume-tiers-legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-md);
    padding: 0.5rem;
  }

  .tier-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.55rem 0.4rem;
    border-radius: var(--radius-sm);
    transition: all 0.2s ease;
  }

  .tier-col.active {
    background: rgba(255, 157, 36, 0.15);
    border: 1px solid rgba(255, 157, 36, 0.35);
  }

  .tier-col-range {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .tier-col.active .tier-col-range {
    color: var(--accent-amber);
    font-weight: 600;
  }

  .tier-col-price {
    font-size: 1.05rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.15rem 0;
    font-feature-settings: "tnum";
  }

  .tier-col-note {
    font-size: 0.6875rem;
    color: var(--text-secondary);
  }

  /* Custom Slider Styling */
  .slider-wrapper {
    position: relative;
    padding: 0.5rem 0 0.75rem;
  }

  .slider-header-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .slider-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
  }

  .slider-val-bubble {
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .slider-val-bubble span {
    color: var(--accent-amber);
    font-size: 1.45rem;
    font-weight: 800;
    font-feature-settings: "tnum";
  }

  .custom-slider {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.12);
    outline: none;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .custom-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
