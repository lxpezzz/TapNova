---
import { Image } from 'astro:assets';
import RestaurantImage from '../../../public/images/cta/contact-background.webp';

const information = [
  { title: 'Fotografías', text: 'Cómo es el local.' },
  { title: 'Valoración', text: 'La puntuación que recibe.' },
  { title: 'Reseñas', text: 'Lo que cuentan otros clientes.' },
  { title: 'Horario', text: 'Cuándo está abierto.' },
  { title: 'Ubicación', text: 'Dónde está y cómo llegar.' },
  { title: 'Teléfono', text: 'Cómo llamar.' },
  { title: 'Página web', text: 'Dónde conocerlo mejor.' },
  { title: 'Carta o servicios', text: 'Qué ofrece.' },
];
---

<section class="first-impression" aria-labelledby="first-impression-heading">
  <div class="first-impression__inner">
    <h2 id="first-impression-heading" class="first-impression__heading">
      Antes de entrar en tu local, muchos clientes ya te han visto aquí.
    </h2>
    <div class="first-impression__columns">
      <div class="first-impression__visual">
        <Image
          src={RestaurantImage}
          alt="Interior de restaurante con mesas, luz cálida de velas y una copa en primer plano"
          widths={[400, 640, 800, 1200]}
          sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 767px) calc(100vw - 64px), (max-width: 1023px) calc(100vw - 96px), (max-width: 1487px) calc((100vw - 184px) / 2), 652px"
          quality={65}
          loading="lazy"
          decoding="async"
          class="first-impression__image"
        />
      </div>
      <div>
        <p class="first-impression__eyebrow">Tu negocio en Google</p>
        <dl class="first-impression__information">
          {information.map(({ title, text }) => (
            <div>
              <dt>{title}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
        <p class="first-impression__copy">
          Todo esto forma parte de la primera impresión de tu negocio antes de
          que una persona decida llamar, reservar, consultar la carta o ir hasta
          allí.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .first-impression {
    padding: 56px 20px;
    background: #211915;
    color: #F4F0E8;
  }

  .first-impression__inner {
    max-width: 1360px;
    margin-inline: auto;
  }

  .first-impression__heading {
    max-width: 900px;
    margin-bottom: 28px;
    font-size: 32px;
    line-height: 1.08;
    font-weight: 300;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .first-impression__columns {
    display: grid;
    align-items: center;
    gap: 28px;
  }

  .first-impression__visual {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 22px;
  }

  .first-impression__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
  }

  .first-impression__eyebrow {
    margin-bottom: 12px;
    color: #C7BCB2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .first-impression__information {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 20px;
  }

  .first-impression__information > div {
    padding-block: 14px;
    border-bottom: 1px solid rgb(244 240 232 / 15%);
  }

  .first-impression__information dt {
    font-size: 17px;
    font-weight: 300;
    line-height: 1.25;
  }

  .first-impression__information dd {
    margin-top: 6px;
    color: #C7BCB2;
    font-size: 12px;
    line-height: 1.5;
  }

  .first-impression__copy {
    margin-top: 24px;
    max-width: 520px;
    color: #C7BCB2;
    font-size: 15px;
    line-height: 1.65;
    font-weight: 300;
  }

  @media (min-width: 640px) {
    .first-impression {
      padding: 72px 32px;
    }

    .first-impression__heading {
      font-size: 44px;
      margin-bottom: 36px;
    }

    .first-impression__visual {
      border-radius: 28px;
      max-height: 440px;
    }

    .first-impression__information dt {
      font-size: 22px;
    }

    .first-impression__information dd {
      font-size: 13px;
    }

    .first-impression__copy {
      font-size: 17px;
    }
  }

  @media (min-width: 768px) {
    .first-impression {
      padding-inline: 48px;
    }
  }

  @media (min-width: 1024px) {
    .first-impression {
      padding: 96px 64px;
    }

    .first-impression__heading {
      font-size: 52px;
    }

    .first-impression__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 56px;
    }

    .first-impression__visual {
      aspect-ratio: 4 / 3;
      max-height: none;
    }
  }
</style>
