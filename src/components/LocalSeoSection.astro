---
import { Image } from "astro:assets";
import seoLocalImg from "../assets/showcase/seo-local-context.webp";
---

<section
  class="local-seo-section"
  id="seo-local"
  aria-label="Servicio de SEO Local para hostelería"
>
  <!-- Atmospheric background aura -->
  <div class="seo-ambient-aura" aria-hidden="true"></div>

  <div class="section-container">
    <div class="seo-header">
      <h2 class="seo-heading font-display">
        De la mesa a Google. Y de <span class="seo-title__accent">Google</span> a
        nuevos clientes.
      </h2>
      <p class="seo-lead">
        Una buena reputación no sirve de mucho si nadie la ve. TapNova la
        convierte en presencia local.
      </p>
    </div>

    <!-- Main Content: Contextual Visual + Editorial Pillars -->
    <div class="seo-showcase-split">
      <!-- Left: Visual Smartphone Mockup -->
      <div class="seo-visual-col">
        <div class="seo-image-frame">
          <Image
            src={seoLocalImg}
            alt="Optimización de ficha de Google Business Profile y posicionamiento en Google Maps"
            width={780}
            height={585}
            quality={90}
            class="seo-context-img"
          />
        </div>
      </div>

      <!-- Right: SEO Architecture Pillars -->
      <div class="seo-pillars-col">
        <div class="seo-pillar-item">
          <div class="pillar-num font-display">01</div>
          <div class="pillar-body">
            <h3 class="pillar-title">Ponemos a punto tu ficha de Google</h3>
            <p class="pillar-desc">
              Revisamos que toda la información esté <strong
                >correcta, completa y preparada</strong
              > para que tus clientes te encuentren fácilmente.
            </p>
          </div>
        </div>

        <div class="seo-pillar-item">
          <div class="pillar-num font-display">02</div>
          <div class="pillar-body">
            <h3 class="pillar-title">Cuidamos tus reseñas</h3>
            <p class="pillar-desc">
              Te ayudamos a conseguir más opiniones y respondemos a <strong
                >TODAS</strong
              > las reseñas de forma profesional y cercana.
            </p>
          </div>
        </div>

        <div class="seo-pillar-item">
          <div class="pillar-num font-display">03</div>
          <div class="pillar-body">
            <h3 class="pillar-title">
              Mejoramos tu visibilidad en Google Maps
            </h3>
            <p class="pillar-desc">
              Mejoramos tu presencia en Google para que más personas te
              encuentren cuando buscan un negocio como el tuyo en su zona.
            </p>
          </div>
        </div>

        <div class="seo-pillar-item">
          <div class="pillar-num font-display">04</div>
          <div class="pillar-body">
            <h3 class="pillar-title">Te enseñamos lo que realmente funciona</h3>
            <p class="pillar-desc">
              <strong>TODOS LOS MESES</strong> recibirás un informe detallado por
              escrito con los resultados más importantes. Además, tendrás contacto
              directo con nosotros para resolver dudas y revisar la evolución de tu
              negocio.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Honesty Commitment -->
    <div class="seo-honesty-banner">
      <div class="banner-icon" aria-hidden="true">✓</div>
      <p class="banner-text">
        <strong>Compromiso TapNova:</strong> No prometemos la posición #1 ni resultados
        milagrosos. Trabajamos con criterios reales de Google y acciones continuas
        para mejorar la visibilidad de tu negocio en tu zona.
      </p>
    </div>
  </div>
</section>

<style>
  .local-seo-section {
    position: relative;
    padding: clamp(5rem, 9vw, 8.5rem) 0;
    background: transparent;
    border-top: none;
    overflow: hidden;
  }

  .seo-ambient-aura {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translateX(-50%);
    width: 75vw;
    height: 420px;
    background: radial-gradient(
      circle,
      rgba(223, 145, 247, 0.08) 0%,
      rgba(255, 157, 36, 0.05) 45%,
      transparent 70%
    );
    filter: blur(60px);
    pointer-events: none;
  }

  .seo-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto clamp(3rem, 6vw, 5rem);
    position: relative;
    z-index: 2;
  }

  .seo-heading {
    font-size: clamp(2.4rem, 4.2vw, 3.8rem);
    line-height: 1.12;
    font-weight: 400;
    color: #ffffff;
    letter-spacing: -0.025em;
    margin-top: 0.75rem;
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .seo-lead {
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0 auto;
  }

  /* Showcase Split */
  .seo-showcase-split {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 5rem);
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .seo-showcase-split {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  .seo-image-frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #09090c;
    border: 1px solid var(--border-subtle);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
  }
  .seo-title__accent {
    color: #f5a623;
    font-family: "Cormorant Garamond", Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.18em;
    letter-spacing: -0.04em;
    display: inline-block;
    transform: translateY(0.03em);
  }
  .seo-context-img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  /* Pillars Column */
  .seo-pillars-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .seo-pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .seo-pillar-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .pillar-num {
    font-size: 1.125rem;
    color: var(--accent-purple);
    font-weight: 600;
    line-height: 1.2;
    padding-top: 0.15rem;
  }

  .pillar-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-title {
    font-size: 1.18rem;
    font-weight: 600;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .pillar-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Honesty Banner */
  .seo-honesty-banner {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    margin-top: 3.5rem;
    padding: 1.35rem 1.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
    position: relative;
    z-index: 2;
  }

  .banner-icon {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgba(255, 157, 36, 0.15);
    color: var(--accent-amber);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: bold;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .banner-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .banner-text strong {
    color: #ffffff;
  }
</style>
