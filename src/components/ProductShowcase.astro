    color: var(--text-secondary);
  }

  .showcase-cta-group {
    margin-top: 0.5rem;
  }

  /* -------------------------------------------------------------------------
     Mobile Responsiveness (< 1024px & 360-430px)
     ------------------------------------------------------------------------- */
  @media (max-width: 1023px) {
    .showcase-tabs-container {
      justify-content: flex-start;
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem);
      padding: 0 1rem;
    }

    .showcase-tabs-dock {
      border-radius: var(--radius-lg);
      padding: 0.35rem;
      width: 100%;
      scroll-snap-type: x mandatory;
    }

    .showcase-tab-btn {
      scroll-snap-align: center;
      padding: 0.55rem 0.95rem;
      padding-bottom: 0.75rem;
      font-size: 0.8125rem;
    }

    .tab-zone-tag {
      display: none;
    }

    .zone-card-shell {
      padding: 1.35rem;
      border-radius: var(--radius-lg);
    }

    .showcase-title {
      font-size: clamp(1.45rem, 5vw, 1.85rem);
    }

    .spec-card {
      padding: 0.85rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab-progress-fill {
      transition: none !important;
    }
    .product-panel {
      transition: opacity 0.2s ease, visibility 0.2s ease !important;
      transform: none !important;
    }
  }
</style>

<script>
  function initProductShowcase() {
    const dock = document.getElementById('showcase-tabs-dock');
    const shell = document.getElementById('showcase-main-shell');
    if (!dock || !shell || dock.dataset.initialized) return;
    dock.dataset.initialized = 'true';

    const tabButtons = Array.from(dock.querySelectorAll<HTMLButtonElement>('.showcase-tab-btn'));
    const panels = Array.from(shell.querySelectorAll<HTMLElement>('.product-panel'));
    const totalProducts = tabButtons.length;
    if (totalProducts === 0) return;

    const AUTOPLAY_DURATION = 5500; // 5.5 seconds per product
    let currentIndex = 0;
    let startTime = performance.now();
    let isPaused = false;
    let isInViewport = false;
    let animFrameId: number | null = null;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function switchProduct(newIndex: number) {
      if (newIndex === currentIndex) return;

      // Reset previous progress bar
      const prevProgress = document.getElementById(`progress-${tabButtons[currentIndex].id.replace('tab-', '')}`);
      if (prevProgress) prevProgress.style.width = '0%';

      // Update Tab Buttons
      tabButtons.forEach((btn, idx) => {
        const isActive = idx === newIndex;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update Panels
      panels.forEach((panel, idx) => {
        const isActive = idx === newIndex;
        panel.classList.toggle('active', isActive);
      });

      // Scroll active tab into view smoothly on mobile
      if (window.innerWidth < 1024) {
        tabButtons[newIndex]?.scrollIntoView({
          behavior: 'smooth',
          inline: 'center',
          block: 'nearest'
        });
      }

      currentIndex = newIndex;
      startTime = performance.now();
    }

    // Manual Click Override
    tabButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        switchProduct(idx);
        startTime = performance.now();
      });
    });

    // Pause on Hover & Touch
    shell.addEventListener('mouseenter', () => { isPaused = true; });
    shell.addEventListener('mouseleave', () => { 
      isPaused = false; 
      startTime = performance.now() - (progressFraction * AUTOPLAY_DURATION);
    });

    dock.addEventListener('mouseenter', () => { isPaused = true; });
    dock.addEventListener('mouseleave', () => { 
      isPaused = false; 
      startTime = performance.now() - (progressFraction * AUTOPLAY_DURATION);
    });

    shell.addEventListener('touchstart', () => { isPaused = true; }, { passive: true });
    shell.addEventListener('touchend', () => { 
      isPaused = false; 
      startTime = performance.now() - (progressFraction * AUTOPLAY_DURATION);
    }, { passive: true });

    // Animation Loop with Real-time Progress Countdown
    let progressFraction = 0;

    function tick(now: number) {
      if (!prefersReducedMotion && isInViewport && !isPaused) {
        const elapsed = now - startTime;
        progressFraction = Math.min(Math.max(elapsed / AUTOPLAY_DURATION, 0), 1);

        const currentProgress = document.getElementById(`progress-${tabButtons[currentIndex].id.replace('tab-', '')}`);
        if (currentProgress) {
          currentProgress.style.width = `${(progressFraction * 100).toFixed(1)}%`;
        }

        if (elapsed >= AUTOPLAY_DURATION) {
          const nextIndex = (currentIndex + 1) % totalProducts;
          switchProduct(nextIndex);
        }
      }

      animFrameId = requestAnimationFrame(tick);
    }

    // IntersectionObserver: Only run when visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        isInViewport = entry.isIntersecting;
        if (isInViewport) {
          startTime = performance.now() - (progressFraction * AUTOPLAY_DURATION);
        }
      });
    }, {
      threshold: 0.2
    });

    const section = document.getElementById('productos');
    if (section) observer.observe(section);

    // Start tick loop if motion not reduced
    if (!prefersReducedMotion) {
      animFrameId = requestAnimationFrame(tick);
    }
  }

  // Initialize on load and Astro page transitions
  initProductShowcase();
  document.addEventListener('astro:page-load', initProductShowcase);
</script>
