---
import { Image } from 'astro:assets';
import ArrowRight from './ArrowRight.astro';
import portacuentasImg from '../assets/showcase/portacuentas-context.webp';
import expositorImg from '../assets/products/expositor.webp';
import tarjetaNfcImg from '../assets/products/tarjeta-nfc.webp';
---

<section class="featured-products-section" id="productos" aria-label="Productos destacados de TapNova">
  <!-- Atmospheric Glow Backdrop -->
  <div class="showcase-ambient-halo" aria-hidden="true"></div>

  <div class="section-container">
    <!-- Section Header -->
    <header class="featured-header text-center">
      <h2 class="featured-title font-display">
        Productos pensados para el momento adecuado.
      </h2>
      <p class="featured-subtitle">
        Materiales de alta gama con tecnología contactless integrada en los puntos clave del restaurante. Sin aplicaciones, sin fricción.
      </p>
    </header>

    <!-- Editorial Composition: Protagonist Hero + Balanced Companion Duo -->
    <div class="featured-grid">
      
      <!-- 1. PROTAGONISTA: Portacuentas NFC + QR -->
      <article class="featured-card hero-card">
        <a href="/productos#portacuentas" class="card-overlay-hit" aria-label="Ver detalles del Portacuentas Inteligente NFC + QR"></a>
        
        <div class="hero-card-inner">
          <!-- Visual Frame -->
          <div class="hero-visual-frame">
            <div class="visual-ambient-glow amber-glow" aria-hidden="true"></div>
            <Image
              src={portacuentasImg}
              alt="Portacuentas inteligente de piel y titanio para mesas de restaurante"
              width={860}
              height={580}
              quality={90}
              class="hero-img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Content Column -->
          <div class="hero-content">
            <h3 class="hero-product-title font-display">
              Portacuentas NFC + QR
            </h3>

            <p class="hero-product-desc">
              Convierte el final de cada mesa en una invitación natural a volver y recomendar.
            </p>

            <!-- Key Highlights Bento -->
            <ul class="hero-specs-list" aria-label="Especificaciones del portacuentas">
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18a8 8 0 0 1 0-12"/><path d="M10 16a5 5 0 0 1 0-8"/><path d="M14 14a2 2 0 0 1 0-4"/><circle cx="18" cy="12" r="1.5" fill="currentColor"/></svg>
                <span>NFC 13.56 MHz + QR dinámico de alta resolución</span>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Placa de aleación de titanio cepillado antihuellas grabada a láser</span>
              </li>
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Piel hidrorepelente con protección antibacteriana</span>
              </li>
            </ul>

            <!-- Bottom Action Row -->
            <div class="card-footer-action">
              <div class="price-display">
                <span class="price-label">Desde</span>
                <span class="price-figure">59 €</span>
                <span class="price-suffix">/ ud.</span>
              </div>

              <div class="card-inline-cta" aria-hidden="true">
                <span>Ver producto</span>
                <span class="cta-arrow"><ArrowRight /></span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- 2. COMPAÑERO 1: Expositor NFC + QR -->
      <article class="featured-card duo-card">
        <a href="/productos#expositores" class="card-overlay-hit" aria-label="Ver detalles del Expositor NFC + QR"></a>
        
        <div class="duo-card-inner">
          <div class="duo-visual-frame">
            <div class="visual-ambient-glow warm-glow" aria-hidden="true"></div>
            <Image
              src={expositorImg}
              alt="Expositor vertical de madera de nogal y titanio para barra y mostrador"
              width={540}
              height={420}
              quality={90}
              class="duo-img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="duo-content">
            <h3 class="duo-product-title font-display">
              Expositor NFC + QR
            </h3>

            <p class="duo-product-desc">
              Haz visible la conversación en el punto de pago, cuando la experiencia aún está presente.
            </p>

            <div class="card-footer-action">
              <div class="price-display">
                <span class="price-label">Desde</span>
                <span class="price-figure">34 €</span>
                <span class="price-suffix">/ ud.</span>
              </div>

              <div class="card-inline-cta" aria-hidden="true">
                <span class="cta-text">Ver soporte</span>
                <span class="cta-arrow"><ArrowRight /></span>
              </div>
            </div>
          </div>
        </div>
      </article>

      <!-- 3. COMPAÑERO 2: Tarjetas NFC de sala -->
      <article class="featured-card duo-card">
        <a href="/catalogo#tarjetas" class="card-overlay-hit" aria-label="Ver detalles de las Tarjetas NFC de sala"></a>
        
        <div class="duo-card-inner">
          <div class="duo-visual-frame">
            <div class="visual-ambient-glow orchid-glow" aria-hidden="true"></div>
            <Image
              src={tarjetaNfcImg}
              alt="Tarjeta NFC contactless para el equipo de sala de un restaurante"
              width={540}
              height={420}
              quality={90}
              class="duo-img"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="duo-content">
            <h3 class="duo-product-title font-display">
              Tarjetas NFC de Sala
            </h3>

            <p class="duo-product-desc">
              Tu equipo facilita una reseña en el momento que mejor conecta con cada cliente.
            </p>

            <div class="card-footer-action">
              <div class="price-display">
                <span class="price-label">Desde</span>
                <span class="price-figure">15 €</span>
                <span class="price-suffix">/ ud.</span>
              </div>

              <div class="card-inline-cta" aria-hidden="true">
                <span class="cta-text">Ver tarjetas</span>
                <span class="cta-arrow"><ArrowRight /></span>
              </div>
            </div>
          </div>
        </div>
      </article>

    </div>

    <!-- Main Navigation Gateway to Catalog -->
    <div class="featured-gateway-footer text-center">
      <a href="/productos" class="btn-solid-white gateway-btn">
        <span>Ver todos los productos</span>
        <span class="btn-icon" aria-hidden="true"><ArrowRight /></span>
      </a>
      <p class="gateway-microcopy">
        Catálogo B2B completo con portamenús, tarjetas NFC de sala, pegatinas y descuentos por volumen.
      </p>
    </div>

  </div>
</section>

<style>
  /* -------------------------------------------------------------------------
     FEATURED PRODUCTS SECTION — APPLE-INSPIRED EDITORIAL COMPOSITION
     ------------------------------------------------------------------------- */
  .featured-products-section {
    position: relative;
    padding-top: clamp(2.25rem, 4vw, 3.75rem);
    padding-bottom: clamp(2.25rem, 4vw, 3.75rem);
    background: transparent;
    color: var(--text-primary);
    overflow: hidden;
  }

  /* Ambient Cosmic Halos */
  .showcase-ambient-halo {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(500px, 75vw, 1100px);
    height: clamp(350px, 45vw, 650px);
    background: radial-gradient(
      ellipse at center,
      rgba(255, 140, 0, 0.1) 0%,
      rgba(223, 145, 247, 0.05) 45%,
      transparent 75%
    );
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  /* Section Header */
  .featured-header {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto clamp(1.75rem, 3vw, 2.5rem);
    text-align: center;
  }

  .featured-title {
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 0;
    text-wrap: balance;
  }

  .featured-subtitle {
    font-size: clamp(1.05rem, 1.3vw, 1.2rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0.75rem auto 0;
  }

  /* Grid Layout: Hero Card Full Width + 2 Balanced Duo Cards (50% each on mobile & desktop) */
  .featured-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(0.5rem, 1.8vw, 1rem);
    width: min(100%, 52rem);
    margin-inline: auto;
  }

  /* Base Card Styling */
  .featured-card {
    position: relative;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04) 0%,
      rgba(255, 255, 255, 0.015) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 12px 24px -15px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    transition: transform 0.35s var(--ease-default), border-color 0.35s var(--ease-default), background 0.35s var(--ease-default), box-shadow 0.35s var(--ease-default);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.2);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.065) 0%,
      rgba(255, 255, 255, 0.025) 100%
    );
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 26px 50px -15px rgba(0, 0, 0, 0.65), 0 0 35px -8px rgba(255, 140, 0, 0.15);
  }

  /* Entire Card Clickable Hit Area */
  .card-overlay-hit {
    position: absolute;
    inset: 0;
    z-index: 10;
    border-radius: inherit;
  }

  /* =========================================================================
     1. HERO CARD (PORTACUENTAS PROTAGONISTA)
     ========================================================================= */
  .hero-card {
    grid-column: 1 / -1;
  }

  .hero-card-inner {
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 1024px) {
    .hero-card-inner {
      grid-template-columns: 1.25fr 1fr;
      align-items: stretch;
    }
  }

  .hero-visual-frame {
    position: relative;
    overflow: hidden;
    height: clamp(170px, 46vw, 240px);
    background: radial-gradient(circle at center, rgba(30, 25, 20, 0.6) 0%, rgba(10, 10, 12, 0.95) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: none;
  }

  @media (min-width: 1024px) {
    .hero-visual-frame {
      border: none;
      min-height: 240px;
      height: 100%;
    }
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-default);
  }

  .featured-card:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-content {
    padding: clamp(0.8rem, 1.8vw, 1.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-product-title {
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 0.35rem;
    white-space: nowrap;
  }

  .hero-product-desc {
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.48;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.65rem;
  }

  /* Specifications List */
  .hero-specs-list {
    display: none;
  }

  .hero-specs-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .hero-specs-list svg {
    color: var(--accent-amber);
    flex-shrink: 0;
  }

  /* Footer action inside card */
  .card-footer-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.55rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: auto;
  }

  .price-display {
    display: flex;
    align-items: baseline;
    gap: 0.2rem;
  }

  .price-label {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .price-figure {
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .price-suffix {
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .card-inline-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: #ffffff;
    transition: color 0.25s var(--ease-default);
  }

  .cta-arrow {
    display: inline-block;
    transition: transform 0.25s var(--ease-default);
    color: var(--accent-amber);
  }

  .featured-card:hover .cta-arrow {
    transform: translateX(4px);
  }

  .featured-card:hover .card-inline-cta {
    color: var(--accent-yellow);
  }

  /* =========================================================================
     2. DUO CARDS (EXPOSITOR & POSAVASOS)
     ========================================================================= */
  .duo-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .duo-visual-frame {
    position: relative;
    height: clamp(105px, 28vw, 155px);
    overflow: hidden;
    background: radial-gradient(circle at center, rgba(25, 25, 30, 0.6) 0%, rgba(10, 10, 12, 0.95) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: none;
  }

  @media (min-width: 1024px) {
    .duo-visual-frame {
      height: 155px;
    }
  }

  .duo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s var(--ease-default);
  }

  .featured-card:hover .duo-img {
    transform: scale(1.03);
  }

  .duo-content {
    padding: clamp(0.6rem, 1.8vw, 1.1rem);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .duo-product-title {
    font-size: clamp(0.92rem, 2.6vw, 1.45rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .duo-product-desc {
    font-size: clamp(0.72rem, 1.8vw, 0.88rem);
    line-height: 1.38;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 0.55rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .duo-content {
      padding: clamp(0.75rem, 1.5vw, 1.1rem);
    }

    .duo-product-title {
      font-size: clamp(1.22rem, 1.65vw, 1.5rem);
      margin-bottom: 0.3rem;
    }

    .duo-product-desc {
      font-size: clamp(0.78rem, 0.9vw, 0.88rem);
      line-height: 1.48;
      display: block;
      -webkit-line-clamp: unset;
      margin-bottom: 0.65rem;
    }
  }

  /* Halos within card visual frames */
  .visual-ambient-glow {
    position: absolute;
    width: 70%;
    height: 70%;
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0.5;
    pointer-events: none;
    z-index: 1;
  }

  .amber-glow {
    background: radial-gradient(circle, rgba(255, 140, 0, 0.25) 0%, transparent 70%);
  }

  .warm-glow {
    background: radial-gradient(circle, rgba(254, 237, 122, 0.2) 0%, transparent 70%);
  }

  .orchid-glow {
    background: radial-gradient(circle, rgba(223, 145, 247, 0.22) 0%, transparent 70%);
  }

  /* =========================================================================
     MAIN GATEWAY CTA SECTION
     ========================================================================= */
  .featured-gateway-footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(1.4rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .gateway-btn {
    font-size: 0.75rem;
    padding: 0.55rem 1rem;
    padding-right: 0.6rem;
  }

  .gateway-microcopy {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.5);
    max-width: 520px;
    line-height: 1.5;
  }

  /* Responsive refinements for mobile devices */
  @media (max-width: 540px) {
    .featured-grid {
      gap: 0.5rem;
    }

    .hero-content {
      padding: 0.75rem 0.65rem;
    }

    .hero-product-title {
      font-size: clamp(1.15rem, 4.8vw, 1.4rem);
      white-space: normal;
    }

    .hero-product-desc {
      font-size: 0.84rem;
      line-height: 1.42;
      margin-bottom: 0.45rem;
    }

    .duo-content {
      padding: 0.6rem 0.5rem;
    }

    .duo-card .cta-text {
      display: none;
    }

    .duo-card .price-suffix {
      display: none;
    }

    .duo-card .price-label {
      font-size: 0.58rem;
    }

    .duo-card .price-figure {
      font-size: 0.92rem;
    }

    .card-footer-action {
      padding-top: 0.45rem;
      gap: 0.25rem;
    }
  }
</style>
