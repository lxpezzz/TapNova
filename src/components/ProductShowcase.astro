    border-radius: var(--radius-md);
  }

  .spec-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-amber);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .product-panel[data-panel-index="1"] .spec-icon,
  .product-panel[data-panel-index="2"] .spec-icon {
    color: var(--accent-purple);
  }

  .spec-label {
    display: block;
    font-size: 0.92rem;
