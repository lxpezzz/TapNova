---
import { getMiniFaqs, type miniFaqIds } from '../../data/faqs';
import FaqAccordion from './FaqAccordion.astro';

interface Props {
  page: keyof typeof miniFaqIds;
}

const { page } = Astro.props;
const questions = getMiniFaqs(page);
const headings = {
  home: 'Antes de conectar tu local.',
  seo: 'Tus dudas sobre SEO Local.',
  web: 'Tus dudas sobre la web.',
};
---

<section class="mini-faq" aria-labelledby={`mini-faq-${page}`}>
  <div class="mini-faq__inner">
    <div class="mini-faq__intro">
      <p class="mini-faq__eyebrow">PREGUNTAS FRECUENTES</p>
      <h2 class="mini-faq__heading" id={`mini-faq-${page}`}>{headings[page]}</h2>
    </div>
    <div class="mini-faq__questions">
      <FaqAccordion questions={questions} />
      <a class="mini-faq__link" href="/preguntas-frecuentes">
        Ver todas las preguntas <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .mini-faq {
    padding: 48px 20px;
    background: #faf8f5;
    color: #2e2019;
  }

  .mini-faq__inner {
    display: grid;
    gap: 24px;
    max-width: 1000px;
    margin-inline: auto;
  }

  .mini-faq__eyebrow {
    margin: 0 0 12px;
    color: #6b5e52;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  .mini-faq__heading {
    margin: 0;
    font-size: clamp(28px, 2.8vw, 36px);
    font-weight: 300;
    letter-spacing: -0.025em;
    line-height: 1.12;
    text-wrap: balance;
  }

  .mini-faq__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin-top: 12px;
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-color: rgb(46 32 25 / 35%);
  }

  .mini-faq__link:hover {
    text-decoration-color: currentColor;
  }

  .mini-faq__link:focus-visible {
    outline: 2px solid #6b5e52;
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .mini-faq {
      padding: 56px 32px;
    }
  }

  @media (min-width: 768px) {
    .mini-faq {
      padding-inline: 48px;
    }
  }

  @media (min-width: 1024px) {
    .mini-faq {
      padding: 64px;
    }

    .mini-faq__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: 64px;
    }
  }
</style>
