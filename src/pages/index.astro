---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import HeroTapNova from "../components/HeroTapNova.astro";
import Marquee from "../components/Marquee.astro";
import StickyExplainer from "../components/StickyExplainer.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import WebsitesSection from "../components/WebsitesSection.astro";
import LocalSeoSection from "../components/LocalSeoSection.astro";
import HomePacks from "../components/HomePacks.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />
  <main id="main-content">
    <HeroTapNova />
    <div class="hero-to-explainer-bridge">
      <Marquee />
    </div>
    <StickyExplainer />
    <ProductShowcase />
    <Marquee />
    <WebsitesSection />
    <LocalSeoSection />
    <HomePacks />
    <Marquee />
    <FinalCta />
  </main>
  <Footer />
</Layout>

<style>
  .hero-to-explainer-bridge {
    position: relative;
    z-index: 1;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 1023px) {
    .hero-to-explainer-bridge {
      margin-top: 0.25rem;
      margin-bottom: 0.25rem;
    }
  }
</style>
