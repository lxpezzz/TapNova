---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import HeroTapNova from "../components/HeroTapNova.astro";
import Marquee from "../components/Marquee.astro";
import StickyExplainer from "../components/StickyExplainer.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import LocalSeoSection from "../components/LocalSeoSection.astro";
import WebsitesSection from "../components/WebsitesSection.astro";
import PricingSection from "../components/PricingSection.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />
  <main id="main-content">
    <HeroTapNova />
    <div class="hero-to-explainer-bridge">
      <Marquee />
    </div>
    <StickyExplainer />
    <ProductShowcase />
    <WebsitesSection />
    <LocalSeoSection />
    <Marquee />
    <PricingSection />
    <FinalCta />
  </main>
  <Footer />
</Layout>

<style>
  /* El final del relato móvil ya tiene su propio cierre visual. Reducimos el
     espacio de transición para que la cinta conecte ambos bloques. */
  @media (max-width: 1023px) {
    .hero-to-explainer-bridge {
      margin-top: -10rem;
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }
  }

  @media (max-width: 479px) {
    .hero-to-explainer-bridge {
      margin-top: -7rem;
      margin-bottom: 1.75rem;
    }
  }
</style>
