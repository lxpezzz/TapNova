---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroTapNova from '../components/HeroTapNova.astro';
import StickyExplainer from '../components/StickyExplainer.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import LocalSeoSection from '../components/LocalSeoSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar />
  <main id="main-content">
    <HeroTapNova />
    <StickyExplainer />
    <ProductShowcase />
    <LocalSeoSection />
    <PricingSection />
    <FinalCta />
  </main>
  <Footer />
</Layout>
