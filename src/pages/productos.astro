---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/layout/Footer.astro';
import ProductCatalog from '../components/productos/ProductCatalog.astro';
import { products } from '../data/products';
---

<Layout
  title="Productos personalizados para hostelería | TapNova"
  description="Descubre posavasos, portacuentas, expositores y otros productos personalizados de TapNova para conectar tu local con el móvil de tus clientes."
  socialImage={products[0].image?.src}
  socialImageAlt={products[0].image?.alt}
>
  <main>
    <section class="catalog-hero" aria-labelledby="products-heading">
      <div class="catalog-hero__inner">
        <div>
          <p class="catalog-hero__eyebrow">PRODUCTOS PARA HOSTELERÍA</p>
          <h1 class="catalog-hero__title" id="products-heading">Del local al móvil,<br /> en un gesto.</h1>
        </div>
        <p class="catalog-hero__text">
          Productos personalizados con QR y NFC para conectar cada punto de tu
          negocio con reseñas, carta, reservas, redes sociales, promociones y mucho más.
        </p>
      </div>
    </section>
    <ProductCatalog />
  </main>
  <Footer />
</Layout>

<style>
  .catalog-hero {
    padding: 48px 20px;
    background: #211915;
    color: #f4f0e8;
  }

  .catalog-hero__inner {
    display: grid;
    gap: 24px;
    max-width: 1360px;
    margin-inline: auto;
  }

  .catalog-hero__eyebrow {
    margin: 0 0 18px;
    color: #c7bcb2;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
  }

  .catalog-hero__title {
    margin: 0;
    font-size: clamp(42px, 5vw, 68px);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.06;
  }

  .catalog-hero__text {
    max-width: 460px;
    margin: 0;
    color: #d8cebf;
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    .catalog-hero {
      padding: 56px 32px;
    }
  }

  @media (min-width: 768px) {
    .catalog-hero {
      padding-inline: 48px;
    }
  }

  @media (min-width: 1024px) {
    .catalog-hero {
      padding: 64px;
    }
    .catalog-hero__inner {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 64px;
    }
    .catalog-hero__text {
      padding-bottom: 4px;
    }
  }
</style>
