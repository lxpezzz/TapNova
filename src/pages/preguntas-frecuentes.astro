---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ArrowRight from '../components/ArrowRight.astro';
import { SITE_METADATA } from '../data/siteData';

const faqSections = [
  {
    group: 'Tecnología y funcionamiento',
    items: [
      {
        question: '¿El comensal tiene que instalar alguna aplicación para dejar la reseña?',
        answer: 'No. El sistema funciona de forma nativa en cualquier iPhone y dispositivo Android moderno. Al acercar el móvil a la zona NFC o escanear el QR con la cámara, se abre de inmediato la pantalla de valoración en Google Maps o en su navegador habitual, sin descargas, registros ni pasos intermedios.'
      },
      {
        question: '¿Cómo se vincula el soporte con la ficha de Google de mi restaurante?',
        answer: 'Nosotros nos encargamos de todo antes del envío. Programamos los chips NFC y grabamos los códigos QR enlazados directamente a tu ficha oficial de Google Business Profile. Cuando recibes el paquete, el soporte está listo para colocarse en mesa o barra desde el primer servicio.'
      },
      {
        question: '¿Qué ocurre si cambiamos de local, de nombre o actualizamos la ficha de Google?',
        answer: 'Los enlaces están protegidos por una redirección técnica dinámica. Si en el futuro cambias de dirección, abres una nueva sala o renuevas el perfil de Google, actualizamos el destino de forma remota en minutos sin necesidad de cambiar los soportes físicos que ya tienes.'
      },
      {
        question: '¿Por qué un soporte físico consigue mejores resultados que pedir la reseña verbalmente?',
        answer: 'El momento del cobro es cuando el comensal ha terminado su comida, está satisfecho y tiene el teléfono a mano. Si depende de buscar el restaurante en Google por su cuenta horas después, la mayoría lo olvida. El soporte en mesa reduce el camino a dos segundos exactos en el instante de mayor predisposición.'
      }
    ]
  },
  {
    group: 'Materiales y personalización',
    items: [
      {
        question: '¿Cómo resisten los soportes el uso intenso y los productos de limpieza en hostelería?',
        answer: 'Están fabricados específicamente para resistir el ritmo real de una sala. La piel exterior es hidrorepelente y tratada contra manchas y grasa. Las placas son de aleación de titanio cepillado antihuellas con grabado por láser de fibra óptica, lo que impide que el código o el logo se desgasten o borren con el roce diario. Los posavasos y pegatinas son completamente estancos con sellado IP68.'
      },
      {
        question: '¿Se pueden personalizar con el logotipo y la tipografía de nuestro restaurante?',
        answer: 'Sí. Todos los soportes se graban de manera individual con la identidad visual de tu local. Tras confirmar el pedido, nos envías tu logo en formato vectorial (SVG, PDF, Illustrator) o imagen en alta resolución. Te remitimos una simulación digital a escala real para que verifiques posición y acabados antes de iniciar el grabado definitivo.'
      },
      {
        question: '¿Podemos solicitar una muestra física antes de equipar todo el local?',
        answer: 'Puedes pedir una sola unidad desde nuestro catálogo para comprobar en persona la calidad de la piel, el tacto del titanio y la rapidez del chip con los teléfonos de tu equipo antes de hacer un pedido completo para todo el restaurante.'
      }
    ]
  },
  {
    group: 'Precios, pedidos y servicio',
    items: [
      {
        question: '¿Los soportes son de pago único o conllevan suscripciones obligatorias?',
        answer: 'El equipamiento físico (portacuentas, expositores, posavasos y tarjetas) es 100% en propiedad mediante un único pago, sin cuotas recurrentes ni comisiones por reseña. Es una inversión de material deducible fiscalmente. Solo los servicios continuos de posicionamiento SEO Local en Google Maps tienen una tarifa mensual opcional.'
      },
      {
        question: '¿Cuál es el plazo de entrega habitual?',
        answer: 'Una vez aprobada la simulación visual del grabado, el proceso de fabricación, verificación de lectura NFC y envío toma habitualmente entre 48 y 72 horas laborables para toda la península.'
      },
      {
        question: '¿Qué garantía tienen los productos?',
        answer: 'Todos los soportes físicos disponen de 2 años de garantía oficial. Si algún chip o elemento estructural presentase cualquier defecto de fabricación, lo reemplazamos de forma inmediata sin coste alguno.'
      }
    ]
  }
];

const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqSections.flatMap((sec) =>
    sec.items.map((item) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  )
};
---

<Layout
  title="Preguntas Frecuentes — TapNova"
  description="Respuestas claras sobre el funcionamiento técnico de los soportes NFC y QR, materiales, personalización con tu marca y plazos de entrega para restaurantes."
>
  <script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

  <Navbar />

  <main class="faq-page-main" id="main-content">
    <!-- Ambient Cosmic Halo -->
    <div class="faq-ambient-halo" aria-hidden="true"></div>

    <div class="section-container">
      
      <!-- Back Link -->
      <div class="faq-nav-back">
        <a href="/" class="back-link">
          <span class="back-arrow" aria-hidden="true"><ArrowRight direction="left" /></span>
          <span>Volver al inicio</span>
        </a>
      </div>

      <!-- Main Header -->
      <header class="faq-header text-center">
        <h1 class="faq-title font-display">
          Preguntas frecuentes
        </h1>
        <p class="faq-lead">
          Respuestas directas sobre el funcionamiento de los soportes, la personalización con tu marca y la configuración técnica para tu local.
        </p>
      </header>

      <!-- FAQ Groups -->
      <div class="faq-content-wrapper">
        {faqSections.map((section) => (
          <section class="faq-group-block" aria-label={section.group}>
            <h2 class="faq-group-title font-display">
              {section.group}
            </h2>

            <div class="faq-accordion-list">
              {section.items.map((item) => (
                <details class="faq-item">
                  <summary class="faq-question">
                    <span class="question-text">{item.question}</span>
                    <span class="toggle-icon" aria-hidden="true">
                      <ArrowRight direction="down" />
                    </span>
                  </summary>
                  <div class="faq-answer">
                    <p>{item.answer}</p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Discreet Direct Support Card -->
      <div class="faq-direct-contact">
        <div class="direct-contact-inner text-center">
          <h3 class="contact-card-title font-display">
            ¿Tienes alguna consulta específica sobre tu sala?
          </h3>
          <p class="contact-card-desc">
            Podemos orientarte sobre qué formatos encajan mejor según el número de mesas, la rotación de clientes y la distribución de tu local.
          </p>

          <div class="contact-actions-row">
            <a 
              href={`https://wa.me/34600000000?text=${encodeURIComponent('Hola TapNova, tengo una duda sobre los soportes para mi restaurante')}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-solid-white contact-btn"
            >
              <span>Hablar por WhatsApp</span>
              <span class="btn-icon" aria-hidden="true"><ArrowRight /></span>
            </a>

            <a href={`mailto:${SITE_METADATA.email}`} class="btn-primary contact-btn">
              <span>Escribir por correo</span>
              <span class="btn-icon" aria-hidden="true"><ArrowRight /></span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
</Layout>

<style>
  /* -------------------------------------------------------------------------
     FAQ PAGE — CLEAN EDITORIAL DESIGN WITHOUT AI FLUFF
     ------------------------------------------------------------------------- */
  .faq-page-main {
    position: relative;
    padding-top: clamp(7rem, 10vw, 9rem);
    padding-bottom: clamp(5rem, 8vw, 7.5rem);
    background: transparent;
    color: var(--text-primary);
    overflow: hidden;
    min-height: 85vh;
  }

  /* Soft Ambient Cosmic Halo */
  .faq-ambient-halo {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(500px, 80vw, 1100px);
    height: clamp(350px, 50vw, 650px);
    background: radial-gradient(
      ellipse at center,
      rgba(255, 140, 0, 0.08) 0%,
      rgba(223, 145, 247, 0.04) 45%,
      transparent 75%
    );
    filter: blur(90px);
    pointer-events: none;
    z-index: 0;
  }

  /* Back Navigation */
  .faq-nav-back {
    position: relative;
    z-index: 2;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s var(--ease-default), transform 0.2s var(--ease-default);
  }

  .back-link:hover {
    color: #ffffff;
    transform: translateX(-2px);
  }

  .back-arrow {
    transition: transform 0.2s var(--ease-default);
  }

  .back-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  /* Main Header */
  .faq-header {
    position: relative;
    z-index: 2;
    max-width: 740px;
    margin: 0 auto clamp(3.25rem, 5.5vw, 4.5rem);
    text-align: center;
  }

  .faq-title {
    font-size: clamp(2.35rem, 4.5vw, 3.75rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.1rem;
    text-wrap: balance;
    text-align: center;
  }

  .faq-lead {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    text-wrap: balance;
  }

  /* Content Wrapper */
  .faq-content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto clamp(4rem, 6vw, 5.5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 4.5vw, 3.75rem);
  }

  /* Section Group */
  .faq-group-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-group-title {
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 400;
    color: #ffffff;
    letter-spacing: -0.02em;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Accordion List */
  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Accordion Item Card */
  .faq-item {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.035) 0%,
      rgba(255, 255, 255, 0.012) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    transition: border-color 0.25s var(--ease-default), background 0.25s var(--ease-default);
    overflow: hidden;
  }

  .faq-item:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.05) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
  }

  .faq-item[open] {
    border-color: rgba(255, 157, 36, 0.3);
    background: linear-gradient(
      180deg,
      rgba(255, 157, 36, 0.04) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
  }

  /* Summary Question Bar */
  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: clamp(1.15rem, 2vw, 1.45rem) clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: clamp(1rem, 1.18vw, 1.08rem);
    font-weight: 500;
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .question-text {
    line-height: 1.45;
  }

  .toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-default), background 0.3s var(--ease-default), color 0.3s var(--ease-default);
  }

  .faq-item:hover .toggle-icon {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
    background: rgba(255, 157, 36, 0.2);
    color: var(--accent-amber);
  }

  /* Answer Body */
  .faq-answer {
    padding: 0 clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2.5vw, 1.6rem);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  .faq-answer p {
    font-size: clamp(0.92rem, 1.05vw, 0.98rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    padding-top: 0.9rem;
  }

  /* Direct Contact Card at Bottom */
  .faq-direct-contact {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.04) 0%,
      rgba(255, 255, 255, 0.015) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  .direct-contact-inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-card-title {
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 400;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .contact-card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 1.75rem;
  }

  .contact-actions-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .contact-btn {
    padding: 0.75rem 1.4rem;
  }

  /* Mobile Adjustments */
  @media (max-width: 640px) {
    .faq-question {
      gap: 0.85rem;
    }
    .contact-actions-row {
      flex-direction: column;
      width: 100%;
    }
    .contact-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
