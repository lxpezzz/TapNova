---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/layout/Footer.astro';
import SeoHero from '../components/seo-local/SeoHero.astro';
import LocalSearch from '../components/seo-local/LocalSearch.astro';
import FirstImpression from '../components/seo-local/FirstImpression.astro';
import TapNovaApproach from '../components/seo-local/TapNovaApproach.astro';
import SocialImage from '../../public/images/services/seo-local.webp';
import MiniFaq from '../components/ui/MiniFaq.astro';

const title = 'SEO Local para Restaurantes y Hostelería | TapNova';
const description = 'Ayudamos a restaurantes, bares y negocios HORECA a mejorar cómo aparecen en Google y búsquedas cercanas, explicado sin tecnicismos.';
---

<Layout
  title={title}
  description={description}
  socialImage={SocialImage}
  socialImageAlt="Una persona consulta un mapa y un perfil de restaurante en el móvil desde una terraza"
>
  <main>
    <SeoHero />
    <LocalSearch />
    <FirstImpression />
    <TapNovaApproach />
    <MiniFaq page="seo" />
  </main>
  <Footer />
</Layout>
