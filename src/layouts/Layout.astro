---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = 'TapNova · Soluciones Físicas y Digitales para Restaurantes',
	description = 'Posavasos y portacuentas personalizados con QR y NFC para conectar tu local con reseñas, carta, reservas y experiencias digitales.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- Preload prioritario del visual hero para LCP instantáneo -->
		<link rel="preload" as="image" href="/images/hero/tapnova-hero.webp" type="image/webp" fetchpriority="high" />
	</head>
	<body class="bg-[#0D0A08] text-[#FAF8F2] min-h-screen antialiased selection:bg-white selection:text-black">
		<Header />
		<slot />
	</body>
</html>
